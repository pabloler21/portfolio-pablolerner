  /* ── Responsive ───────────────────────────────────── */
  /* La terminal ambiente se retira ACÁ y no a 1024: con la columna maestra en
     310px, a 1100 el panel de detalle quedaba en 232px —ilegible para prosa—
     mientras 220px de la pantalla los ocupaba una animación decorativa. Lo que
     se sacrifica cuando falta ancho es el adorno, no el contenido. */
  @media (max-width: 1200px) {
    .role-grid { grid-template-columns: 280px 1fr; }
    .panel-terminal { display: none; }
  }

  /* Y debajo de 1024 se apilan: dos columnas de contenido no entran, y apilado
     el nombre completo entra siempre. */
  @media (max-width: 1024px) {
    .dossier { grid-template-columns: 1fr; gap: 0.8rem; }
    .dossier-master { position: static; }
  }

  @media (max-width: 900px) {
    .list-hint { display: none; }
    .detail-title { font-size: 1.3rem; }
