---
import Base from './Base.astro';

export interface StatBox {
  label: string;
  value: string;
  sub?: string;
  bright?: boolean; // mint value — reserved for active states (STATUS box)
  flag?: boolean;   // flagship gold treatment (auto-detected from label if omitted)
}

export interface DossierProject {
  id: string;
  name: string;
  problem: string;
  outcome?: string;
  stack: readonly string[];
  status: string;
  tracks: readonly ('ai' | 'data')[];
  featured?: boolean;
  github: string;
  demo?: string;
}

interface Props {
  title: string;
  lang: 'en' | 'es';
  description?: string;
  heading?: string;        // "AI ENGINEER & DATA ANALYST"
  badge?: string;          // "UNIT PROFILE"
  subline?: string;        // sys-text line under the heading
  stats?: StatBox[];       // compact HUD stat grid
  /* UNA sola lista. Antes eran dos bloques (`ai` y `data`) con un divisor en el
     medio; con etiquetas por fila ese agrupamiento decía lo mismo dos veces, y
     además no tenía dónde poner a un proyecto que es de las dos mitades. El
     orden del documento sigue sin ser el de la avenida: el paseo es ritmo de
     juego, la página la lee alguien evaluando candidatos. */
  projects?: DossierProject[];
}

const {
  title, lang, description,
  heading, badge, subline,
  stats = [], projects = [],
} = Astro.props;

const hasDossier = projects.length > 0;

/* Etiquetas y filtro. El rótulo largo es el que se muestra en el filtro y en el
   panel de detalle; el corto es el que entra en la fila de la lista, donde el
   presupuesto es de ~60px (medido: la columna del nombre pasa de 115.8 a 236.8
   al sacar el número y el estado, y ahí entran los 16 nombres completos).
   Los dos rótulos van en inglés en los dos idiomas, como ya estaban los
   encabezados de bloque que reemplazan: son los nombres del puesto. */
const TRACKS = [
  { id: 'ai',   label: 'AI ENGINEER',  short: 'AI' },
  { id: 'data', label: 'DATA ANALYST', short: 'DATA' },
] as const;

const trackCount = (id: 'ai' | 'data') => projects.filter(p => p.tracks.includes(id)).length;

const pad2 = (n: number) => String(n).padStart(2, '0');

// Flagship HUD stat box: explicit flag prop, or label match (EN "FLAGSHIP" / ES "PROYECTO ESTRELLA")
const isFlagStat = (s: StatBox) => s.flag ?? /flagship|estrella/i.test(s.label);

const L = lang === 'en'
  ? {
      file:     'FILE',
      mission:  'MISSION',
      result:   'KEY RESULT',
      stack:    'STACK',
      code:     '[ VIEW CODE ↗ ]',
      live:     '[ LIVE ↗ ]',
      listAria: 'Project files',
      hint:     '↑↓ SELECT · ENTER → CODE',
      all:      'ALL',
      filter:   'Filter by track',
      profile:  'PROFILE',
    }
  : {
      file:     'ARCHIVO',
      mission:  'MISIÓN',
      result:   'RESULTADO CLAVE',
      stack:    'STACK',
      code:     '[ VER CODE ↗ ]',
      live:     '[ LIVE ↗ ]',
      listAria: 'Archivos de proyecto',
      hint:     '↑↓ SELECCIONAR · ENTER → CODE',
      all:      'TODOS',
      filter:   'Filtrar por especialidad',
      profile:  'PERFIL',
    };

/* El "todos" primero y activo por defecto: sin filtro elegido se ven los 16.
   `label` es lo que entra en el chip y `long` lo que dice al apuntarlo: en la
   columna de la lista los tres rótulos completos («AI ENGINEER 10 · DATA
   ANALYST 07») piden 500px y saldrían en tres renglones. */
const filters = [
  { id: 'all', label: L.all, long: L.all, count: projects.length },
  ...TRACKS.map(t => ({ id: t.id, label: t.short, long: t.label, count: trackCount(t.id) })),
];

---

<Base title={title} lang={lang} description={description} surface="doc">
  {/* Dos columnas y nada más: el riel con la lista, pegado al borde izquierdo
      del shell y de arriba abajo, y el documento con el proyecto abierto. Es
      la forma de una bandeja de entrada (o del listado de empleos de
      LinkedIn): la lista no es un accesorio del contenido, es la mitad
      izquierda de la pantalla y no se mueve mientras se la recorre. */}
  <div class="records-grid">
    {hasDossier && (
      <div class="records-rail">
        {/* El filtro va ACÁ, en la cabecera de la columna que filtra. Antes
            vivía arriba del panel central, que era donde había ancho para los
            tres rótulos completos; con la lista en su propia columna vuelve a
            donde corresponde, y por eso los chips pasan a la etiqueta corta
            (el rótulo largo queda en el `title` y en el panel de detalle). */}
        <div class="filter-bar" role="group" aria-label={L.filter}>
          {filters.map((f, i) => (
            <button
              type="button"
              class:list={['filter-chip', { 'is-on': i === 0 }]}
              data-filter={f.id}
              title={f.long}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span>{f.label}</span>
              <span class="chip-count">{pad2(f.count)}</span>
            </button>
          ))}
        </div>

        <div
          class="dossier-list"
          role="listbox"
          tabindex="0"
          aria-label={L.listAria}
          aria-activedescendant="pf-0"
        >
          {projects.map((p, i) => (
            <div
              class:list={['dossier-row', { 'is-active': i === 0, 'is-flagship': p.featured }]}
              role="option"
              id={`pf-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-idx={i}
              data-id={p.id}
              data-tracks={p.tracks.join(' ')}
            >
              <span class="row-name">{p.name}</span>
              {/* La línea que convierte la lista en una lista de verdad: qué
                  resuelve el proyecto, dos renglones y corte. Sin esto hay que
                  abrir los 16 para saber cuál mirar.
                  El estado (DEPLOYED/BUILT/…) sigue sin venir acá: ya se
                  muestra grande arriba del panel de detalle. */}
              <span class="row-desc">{p.problem}</span>
              <span class="row-meta">
                <span class="row-cursor" aria-hidden="true">◆</span>
                {TRACKS.filter(t => p.tracks.includes(t.id)).map(t => (
                  <span class="track-tag" title={t.label}>{t.short}</span>
                ))}
              </span>
            </div>
          ))}
        </div>

        <p class="list-hint sys-text">{L.hint}</p>
      </div>
    )}

    <section class="panel-main">
      {heading && (
        <header class="role-head">
          <div class="role-head-top">
            <h2 class="role-title">{heading}</h2>
            {badge && <span class="role-badge bright">{badge}</span>}
          </div>
          {subline && <p class="role-sub sys-text">{subline}</p>}
          {stats.length > 0 && (
            <dl class="head-facts">
              {stats.map(s => (
                <div class="fact">
                  <dt class="fact-label sys-text">{s.label}</dt>
                  <dd class:list={['fact-value', { bright: s.bright, flag: isFlagStat(s) }]}>
                    {s.value}
                    {s.sub && <span class="fact-sub"> · {s.sub}</span>}
                  </dd>
                </div>
              ))}
            </dl>
          )}
        </header>
      )}

      <slot />

      {hasDossier && (
        <div class="dossier-detail">
          {projects.map((p, i) => (
            <article class:list={['detail-pane', { 'is-flagship': p.featured }]} data-idx={i} hidden={i !== 0} aria-labelledby={`pf-${i}`}>
              <div class="detail-top">
                <span class:list={['detail-badge', { flag: p.featured }]}>{p.status}</span>
                {/* Acá sí van los rótulos completos: hay ancho, y es donde se
                    lee qué es el proyecto. */}
                <span class="detail-tracks">
                  {TRACKS.filter(t => p.tracks.includes(t.id)).map(t => (
                    <span class="track-tag">{t.label}</span>
                  ))}
                </span>
                <span class="detail-file sys-text">ID: {p.id.toUpperCase()}</span>
              </div>

              <h3 class="detail-title" data-text={p.name}>{p.name}</h3>

              <div class="detail-section">
                <p class="detail-label sys-text">{L.mission}</p>
                <p class="detail-problem">{p.problem}</p>
              </div>

              {p.outcome && (
                <div class="detail-outcome">
                  <span class="outcome-pip" aria-hidden="true">◆</span>
                  <div class="outcome-body">
                    <span class="outcome-label sys-text">{L.result}</span>
                    <span class="outcome-value">{p.outcome}</span>
                  </div>
                </div>
              )}

              <div class="detail-section">
                <p class="detail-label sys-text">{L.stack}</p>
                <div class="detail-stack">
                  {p.stack.map(t => <span class="chip">{t}</span>)}
                </div>
              </div>

              <div class="detail-ctas">
                <a class="cta-btn cta-primary detail-code" href={p.github} target="_blank" rel="noopener noreferrer">{L.code}</a>
                {p.demo && <a class="cta-btn" href={p.demo} target="_blank" rel="noopener noreferrer">{L.live}</a>}
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  </div>
</Base>

<script>
  // ── Master-detail dossier controller ──────────────────────────
  // All panes are pre-rendered (SSG); JS only toggles [hidden] and
  // runs a cancel-safe scramble-settle reveal on the detail title.
  type ScrambleEl = HTMLElement & { _scrambleTimer?: ReturnType<typeof setInterval> | null };

  const SCRAMBLE_CHARS = '◆◇▸▪░▒▓XZQV0123456789';
  const SCRAMBLE_MS = 480;
  const SCRAMBLE_STEP = 30;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function scrambleIn(el: ScrambleEl, text: string) {
    // Cancel-safe: clear any in-flight timer stored on the element
    if (el._scrambleTimer) { clearInterval(el._scrambleTimer); el._scrambleTimer = null; }
    if (reducedMotion.matches) { el.textContent = text; return; }
    const frames = Math.ceil(SCRAMBLE_MS / SCRAMBLE_STEP);
    let frame = 0;
    el._scrambleTimer = setInterval(() => {
      frame++;
      if (frame >= frames) {
        clearInterval(el._scrambleTimer as ReturnType<typeof setInterval>);
        el._scrambleTimer = null;
        el.textContent = text;
        return;
      }
      const settled = Math.floor((frame / frames) * text.length);
      let out = text.slice(0, settled);
      for (let i = settled; i < text.length; i++) {
        out += text[i] === ' ' ? ' ' : SCRAMBLE_CHARS[(Math.random() * SCRAMBLE_CHARS.length) | 0];
      }
      el.textContent = out;
    }, SCRAMBLE_STEP);
  }

  /* La raíz es la GRILLA y no `.dossier`: la lista y los paneles de detalle
     dejaron de ser hermanos —una vive en el riel y los otros en el documento—
     así que el ancestro común es la grilla que los contiene a los dos. */
  document.querySelectorAll<HTMLElement>('.records-grid').forEach(root => {
    const list  = root.querySelector<HTMLElement>('.dossier-list');
    const rows  = Array.from(root.querySelectorAll<HTMLElement>('.dossier-row'));
    const panes = Array.from(root.querySelectorAll<HTMLElement>('.detail-pane'));
    if (!list || rows.length === 0 || panes.length !== rows.length) return;

    let active = 0;
    const isNarrow = () => window.matchMedia('(max-width: 900px)').matches;

    function revealPane(pane: HTMLElement, fromPointer: boolean) {
      if (fromPointer && isNarrow()) {
        pane.scrollIntoView({ block: 'nearest', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
      }
    }

    function select(idx: number, fromPointer = false) {
      if (idx === active) { revealPane(panes[idx], fromPointer); return; }
      active = idx;

      rows.forEach((r, i) => {
        r.classList.toggle('is-active', i === idx);
        r.setAttribute('aria-selected', i === idx ? 'true' : 'false');
      });
      list!.setAttribute('aria-activedescendant', rows[idx].id);

      panes.forEach((p, i) => { p.hidden = i !== idx; });
      const pane = panes[idx];
      pane.classList.remove('pane-enter');
      void pane.offsetWidth; // reflow → restart CSS fade
      pane.classList.add('pane-enter');

      const titleEl = pane.querySelector<ScrambleEl>('.detail-title');
      if (titleEl) scrambleIn(titleEl, titleEl.dataset.text || titleEl.textContent || '');

      rows[idx].scrollIntoView({ block: 'nearest' });
      revealPane(pane, fromPointer);

      /* La URL sigue a lo que se está mirando, así el link que uno copia abre
         lo que tiene en pantalla. `replaceState` y no `location.hash = …`:
         con el segundo, cada fila que se toca deja una entrada en el
         historial y volver atrás obliga a deshacer la navegación fila por
         fila. */
      const id = rows[idx].dataset.id;
      if (id) history.replaceState(null, '', `#${id}`);
    }

    /* ── Filtro por especialidad ──────────────────────────────────
       Las filas se ocultan con `hidden` y no con una clase: así salen también
       del árbol de accesibilidad, que es lo correcto para una opción que en
       este momento no se puede elegir. Ojo que hace falta una regla explícita
       (`.dossier-row[hidden] { display: none }`): el `display: grid` de la fila
       le gana al `[hidden]` de la hoja del navegador.

       La lista sale COMPLETA del build. Si el JS no corre, se ven los 16 y los
       chips no hacen nada: el filtro agrega, no condiciona. */
    const chips = Array.from(document.querySelectorAll<HTMLElement>('[data-filter]'));

    const visibles = () => rows.reduce<number[]>((acc, r, i) => (r.hidden ? acc : (acc.push(i), acc)), []);

    function applyFilter(id: string) {
      chips.forEach(c => {
        const on = c.dataset.filter === id;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      rows.forEach(r => {
        r.hidden = id !== 'all' && !(r.dataset.tracks || '').split(' ').includes(id);
      });
      /* Si el proyecto abierto quedó fuera del filtro hay que abrir otro: dejar
         el detalle de algo que ya no está en la lista es mentirle al que filtra. */
      const quedan = visibles();
      if (quedan.length > 0 && rows[active].hidden) select(quedan[0]);
    }

    chips.forEach(c => {
      c.addEventListener('click', () => applyFilter(c.dataset.filter || 'all'));
    });

    rows.forEach((row, i) => {
      row.addEventListener('click', () => {
        list!.focus({ preventScroll: true });
        select(i, true);
      });
    });

    /* ── Abrir el record que pide la URL ──────────────────────────
       `/es/projects/#llamarag` tiene que abrir LlamaRAG, no la lista en el
       primero. Lo usa el dropdown de PROJECTS de la barra —desde una página
       documento sus filas no pueden teletransportar a ningún lado, así que
       llevan acá— y de paso cada record pasa a tener una URL propia que se
       puede mandar.
       Hacen falta las DOS puertas: `hashchange` además del arranque. Estando
       ya en esta página, elegir otra fila del dropdown cambia el hash y NO
       recarga nada, así que sin el listener el clic no haría absolutamente
       nada y parecería que el menú está roto. */
    function selectFromHash(hash: string) {
      const id = decodeURIComponent(hash.replace(/^#/, ''));
      if (!id) return;
      const idx = rows.findIndex(r => r.dataset.id === id);
      if (idx < 0) return;
      /* Si el filtro puesto deja esa fila oculta, se vuelve a ALL: una URL que
         nombra un record tiene que poder abrirlo, y seleccionar una fila
         oculta es el modo de falla clásico de filtrar un listbox. */
      if (rows[idx].hidden) applyFilter('all');
      select(idx, true);
      rows[idx].scrollIntoView({ block: 'nearest' });
    }

    if (location.hash) selectFromHash(location.hash);
    window.addEventListener('hashchange', () => selectFromHash(location.hash));

    list.addEventListener('keydown', (e: KeyboardEvent) => {
      const k = e.key;
      if (k === 'ArrowDown' || k === 'ArrowUp' || k === 'Home' || k === 'End') {
        e.preventDefault();
        /* El teclado se mueve sobre las filas VISIBLES, no sobre los índices:
           con un filtro puesto, ↓ desde la última visible no puede caer en una
           oculta. */
        const vis = visibles();
        if (vis.length === 0) return;
        const pos = Math.max(0, vis.indexOf(active));
        const next =
          k === 'ArrowDown' ? vis[Math.min(pos + 1, vis.length - 1)] :
          k === 'ArrowUp'   ? vis[Math.max(pos - 1, 0)] :
          k === 'Home'      ? vis[0] :
          vis[vis.length - 1];
        select(next);
      } else if (k === 'Enter') {
        e.preventDefault();
        panes[active].querySelector<HTMLAnchorElement>('.detail-code')?.click();
      }
    });
  });
</script>

<style>
  /* ── Barra de filtro ──────────────────────────────────
     Chips, no botones con corchetes: los corchetes de este sitio enmarcan una
     ACCIÓN ([ VIEW CODE ↗ ]), y esto es un estado. Mint sólo en el activo, que
     es un estado interactivo y por lo tanto el único acento que corresponde. */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.7rem;
    border-bottom: var(--border-mid);
    flex-shrink: 0;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.6rem;
    background: transparent;
    border: 1px solid var(--ink-mid);
    color: var(--sand-dim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .filter-chip .chip-count { color: var(--sand-dim); }

  .filter-chip:hover {
    border-color: var(--accent-bright);
    color: var(--sand);
  }

  .filter-chip:focus-visible {
    outline: 1px solid var(--accent-bright);
    outline-offset: 2px;
  }

  /* Después del :hover a propósito: misma especificidad, gana el último
     (lección 40). Sin esto el chip activo se ve apagado mientras el puntero
     está encima, que es justo cuando se lo acaba de elegir. */
  .filter-chip.is-on {
    border-color: var(--accent-bright);
    color: var(--accent-bright);
    background: var(--bg-panel);
  }
  .filter-chip.is-on .chip-count { color: var(--accent-bright); }

  /* Sin la columna izquierda. DocNav decía RECORDS (que ya es el título de la
     página), STREET (que ya es un botón de la franja de identidad) y OPEN TO
     WORK (que ya lo dice la caja STATUS): ni un dato propio. A cambio se
     llevaba 280px de ancho con 837.9px verticales vacíos entre el link y el
     pie — el 86% de la columna, medido a 1920×1080. */
  /* 22rem = 352px, que es lo que pedía la columna maestra vieja para entrar
     el nombre más largo de los dos idiomas ("Optimización de Inventario
     E-commerce", 248px con la fuente real: 335.4 con los bordes y el padding).
     Ahora el nombre puede envolver, así que el número deja de ser un mínimo
     duro y pasa a ser lo que hace que la descripción entre en dos renglones. */
  .records-grid {
    display: grid;
    grid-template-columns: 22rem minmax(0, 1fr);
    flex: 1;
    min-height: 0;
  }

  /* ── El riel ───────────────────────────────────────────
     Tres piezas apiladas: el filtro arriba, la lista en el medio (es la única
     que crece y la única que scrollea) y la ayuda de teclado al pie. El borde
     de la derecha es el que separa las dos mitades de la pantalla; la lista
     ya no lleva borde propio, que sería un segundo marco a 1px del primero. */
  .records-rail {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    border-right: var(--border-mid);
  }

  .panel-main {
    padding: 1.2rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
  }

  /* ── Role header ──────────────────────────────────── */
  .role-head { display: flex; flex-direction: column; gap: 0.45rem; }

  .role-head-top {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .role-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sand);
  }

  .role-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--accent);
    /* El teal da 3.8:1 y no puede llevar texto; el borde sí lo conserva. */
    color: var(--sand-muted);
  }
  .role-badge.bright {
    border-color: var(--accent-bright);
    color: var(--accent-bright);
  }

  .role-sub { font-size: 0.7rem; }

  /* ── Datos de cabecera ────────────────────────────────
     Dos líneas de texto y no dos cajas con borde. El dato es el mismo; lo que
     se va es el recuadro, que es de lo que se quejaba la pantalla: bordes que
     encierran aire. Sin caja tampoco hace falta la variante ámbar de fondo
     —el color del valor alcanza— y la cabecera baja de ~90px a ~34px, que es
     ancho que gana el proyecto abierto. */
  .head-facts {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.15rem 0.9rem;
    margin-top: 0.15rem;
  }

  .fact { display: contents; }

  .fact-label { font-size: 0.7rem; }

  .fact-value {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    line-height: 1.5;
    color: var(--sand);
    overflow-wrap: break-word;
  }
  .fact-value.bright { color: var(--accent-bright); }
  .fact-value.flag   { color: var(--accent-flag-bright); }

  .fact-sub { color: var(--sand-dim); }

  /* ── La lista ─────────────────────────────────────── */
  .dossier-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    background: var(--bg-void);
  }
  .dossier-list:focus-visible {
    outline: 1px solid var(--accent-bright);
    outline-offset: 1px;
  }

  /* ── La fila ──────────────────────────────────────────
     Tres renglones: nombre completo, qué resuelve y las etiquetas. Antes era
     una línea con el nombre CORTO ("Iris" en vez de "Iris — Personal AI
     Assistant") porque la columna medía 344px y había que elegir entre el
     nombre entero y cualquier otra cosa. Con la lista al ancho de su propia
     columna el presupuesto deja de ser de suma cero y entra lo que hace falta
     para elegir sin abrir los 16. */
  .dossier-row {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    padding: 0.6rem 0.7rem;
    border-left: 2px solid transparent;
    font-family: var(--font-mono);
    cursor: pointer;
    user-select: none;
    transition: background 0.12s, border-color 0.12s;
  }
