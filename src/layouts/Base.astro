---
import StatusBar from '../components/ui/StatusBar.astro';
import AmbientCanvas from '../components/ui/AmbientCanvas.astro';
import { projects, streetProjects } from '../data/projects.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'es';
  /* La ÚNICA condición que decide si existe la atmósfera. Default 'doc':
     una página nueva nace limpia y tiene que pedir atmósfera. */
  surface?: 'game' | 'doc';
  /* La página se queda con el alto del viewport y son sus columnas las que
     scrollean, en vez de crecer hacia abajo y scrollear la página entera.
     Lo pide la página de records, que es dos paneles que se leen en paralelo:
     si la lista de 16 empuja la página, el detalle se va hacia arriba y hay
     que volver a subir después de cada elección. Default false: una página
     documento normal scrollea como un documento. */
  fill?: boolean;
}

const {
  title,
  description = 'Pablo Lerner — AI Engineer & Data Analyst',
  lang = 'en',
  surface = 'doc',
  fill = false,
} = Astro.props;

const altLang = lang === 'en' ? 'es' : 'en';

/* Filas del dropdown de PROJECTS. Es `streetProjects` —los 10 de la avenida,
   en orden de caminata— y no los 16 de la página de records: en la escena
   cada fila teletransporta a SU cartel, y un proyecto sin cartel no tendría
   a dónde llevar. Los 16 están a un clic, en la última fila del menú.
   El nombre va corto (igual que las filas de la página de records): en 290px
   "Iris — Personal AI Assistant" se corta, "Iris" no. */
const shortName = (n: string) => n.split(' — ')[0];
/* La última fila del menú. Existe por dos razones: el dropdown lista 10 y la
   página tiene 16, así que sin decirlo parece que hay diez; y es la única
   manera de llegar a la lista completa desde la barra, ahora que el botón
   abre un menú en vez de navegar. El número va en la etiqueta y sale de los
   datos: "TODOS" sin cantidad no dice que haya más. */
const allRecordsLabel = lang === 'en'
  ? `ALL RECORDS · ${projects.length} →`
  : `TODOS LOS REGISTROS · ${projects.length} →`;

const projectRows = streetProjects.map(p => ({
  id:       p.id,
  name:     shortName(p[lang].name),
  desc:     p[lang].problem,
  featured: p.featured ?? false,
}));
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://pablolerner.dev');

/* Rutas que existen DE VERDAD, leidas del arbol de paginas en tiempo de build.
   Sin esto el cambio de idioma manda a un 404 en las paginas que solo existen
   en un idioma: /en/concept/* son internas y no tienen version en español. Y
   se mantiene solo — el dia que exista /es/concept/audio, el boton empieza a
   funcionar ahi sin tocar nada. */
const RUTAS = new Set(
  Object.keys(import.meta.glob('/src/pages/**/*.astro'))
    .map(f => f.replace('/src/pages', '').replace(/\/index\.astro$/, '').replace(/\.astro$/, ''))
    .map(r => r || '/'),
);
const aqui = Astro.url.pathname.replace(/\/$/, '') || '/';
const hermana = aqui.replace(`/${lang}`, `/${altLang}`);
const hayHermana = RUTAS.has(hermana);
/* Sin hermana se cae a la home del otro idioma: perder el idioma es mejor que
   perder la pagina. */
const altHref = (hayHermana ? hermana : `/${altLang}`) + '/';
---

<!doctype html>
<html lang={lang} data-surface={surface} data-fill={fill ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <title>{title} · Pablo Lerner</title>

    <!-- SEO bilingual -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    {/* Solo si la traduccion EXISTE: declarar como alternate una URL que da
        404 —lo que pasaba en /concept/, que solo esta en ingles— es peor que
        no declarar nada. */}
    {hayHermana && <link rel="alternate" hreflang={altLang} href={new URL(altHref, canonicalURL.origin)} />}
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', canonicalURL.origin)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body>
    {/* Atmósfera: existe SÓLO donde el visitante puede caminar. Se excluye
        del render (no se oculta con CSS) para no descargar ni ejecutar nada
        de esto en la superficie documento. */}
    {surface === 'game' && (
      <>
        <div class="page-sweep" aria-hidden="true"></div>
        <AmbientCanvas />
        <canvas id="margin-rain-left" class="margin-chrome margin-chrome-left" aria-hidden="true"></canvas>
        <canvas id="margin-rain-right" class="margin-chrome margin-chrome-right" aria-hidden="true"></canvas>
      </>
    )}

    <div class="os-shell">
      {/* ponytail: os-title-row apagada junto con el resto de la UI en surface="game" */}

      {/* ponytail: identity strip vuelve a mostrarse también en surface="game" — pedido explícito ("la navbar con Pablo Lerner"). El resto de la UI (tabs/dots/footer) sigue apagado ahí. */}
      <!-- Identity strip — name, positioning, CTAs -->
      <div class="os-identity">
        <div class="identity-left">
          <a class="id-name" href={`/${lang}/`}>Pablo Lerner</a>
          <span class="id-sep sys-text"> · </span>
          {/* Un solo perfil, y AI Engineer primero: es lo que PRODUCT.md declara
              como el trabajo del sitio, y desde que se fue el selector esta
              franja es donde se nombra. El ternario devolvía el mismo string
              en las dos ramas. */}
          <span class="id-role">AI Engineer &amp; Data Analyst</span>
        </div>
        {/* STREET + PROJECTS + CONTACT, top-right of the identity bar —
            asked explicitly ("arriba a la derecha, en el nav bar superior"),
            and asked again to show on every page, not just the game
            ("en la vista de Contact tendría que verse también los tres
            botones"). #ps-projects-tab is PortfolioScene's existing trigger
            id — its click handler and the drawer it opens only exist on the
            game page, so PROJECTS is that live button there and a plain
            link home everywhere else (there's nothing to open elsewhere). */}
        <div class="id-ctas">
          <a class="os-nav-btn" href={`/${lang}/`}>[ {lang === 'en' ? 'STREET' : 'CALLE'} ]</a>
          {/* PROJECTS ▾ — la lista cuelga del botón. Antes abría un cajón de
              300px pegado al borde derecho de la escena: un panel de altura
              completa que en un teléfono tapaba 300 de 390 y necesitaba su
              propia ✕ para poder salir. Como dropdown hay afuera donde tocar,
              y la barra pasa a tener UN solo lenguaje de menú (este y el
              kebab son el mismo `.os-menu`).
              Sin corchetes y con la flechita: los corchetes son de los
              botones que LLEVAN A UN LADO; la flecha dice que acá se
              despliega algo, y gira cuando está abierto.
              Existe en TODAS las páginas, no sólo en la escena. Fuera de
              ella las filas hacen lo que dice su `href`: llevan a la ficha
              de ese record. Antes, en una página documento, este botón era
              un link a la home — decía PROJECTS y te llevaba a la calle. */}
          <div class="os-menu" data-menu-hover>
            <button
              type="button"
              class="os-nav-btn os-menu-trigger"
              id="ps-projects-tab"
              data-menu-btn
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="ps-projects-pop"
            >
              <span>PROJECTS</span>
              <svg class="mt-caret" viewBox="0 0 24 24" width="9" height="9" aria-hidden="true" focusable="false">
                <path d="M4 8 L12 18 L20 8 Z" fill="currentColor" />
              </svg>
            </button>
            <div class="os-menu-pop os-menu-pop-wide" id="ps-projects-pop" data-menu-pop role="menu" aria-labelledby="ps-projects-tab" hidden>
              {/* Son <a> de verdad, no botones: en una página documento llevan
                  a la ficha del record, y en la escena PortfolioScene les
                  intercepta el clic para teletransportar. Si la escena todavía
                  no terminó de cargar, el link hace lo suyo en vez de no hacer
                  nada. */}
              {projectRows.map(p => (
                <a
                  role="menuitem"
                  class:list={['os-menu-item', 'pj-row', { 'pj-flag': p.featured }]}
                  href={`/${lang}/projects/#${p.id}`}
                  data-proj={p.id}
                >
                  <span class="pj-info">
                    <span class="pj-name">{p.name}</span>
                    <span class="pj-desc">{p.desc}</span>
                  </span>
                </a>
              ))}
              <a role="menuitem" class="os-menu-item pj-all" href={`/${lang}/projects/`}>{allRecordsLabel}</a>
            </div>
          </div>
          <a class="os-nav-btn" href={`/${lang}/contact/`}>[ CONTACT ]</a>
          {/* Menú de ajustes. El parlante estaba suelto en la fila, al lado de
              [ STREET ] / [ PROJECTS ] / [ CONTACT ], y no es hermano de esos
              tres: ellos LLEVAN A UN LADO y él CAMBIA UN AJUSTE. La fila
              además cerraba con 0.7px de sobra en un teléfono de 390, o sea
              que no entraba un ajuste más — y ya sabíamos que venía otro.
              Un kebab cuesta lo mismo que el parlante suelto (es un icono en
              la misma caja) y adentro el espacio deja de ser el problema.
              Existe en TODAS las páginas porque el cambio de idioma existe en
              todas; la música es la única fila que depende de que haya escena. */}
          <div class="os-menu">
            <button
              type="button"
              class="os-nav-btn os-kebab-btn"
              id="os-menu-btn"
              data-menu-btn
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="os-menu-pop"
              aria-label={lang === 'en' ? 'Settings' : 'Ajustes'}
              title={lang === 'en' ? 'Settings' : 'Ajustes'}
            >
              {/* Tres CUADRADITOS, no tres círculos: `border-radius: 0` es
                  regla dura del sistema y el cuadrado es el glifo de esta
                  paleta (◆ ▪ del rain). Sigue leyéndose como kebab. */}
              <svg class="kb-ico" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false">
                <rect x="10" y="3" width="4" height="4" fill="currentColor" />
                <rect x="10" y="10" width="4" height="4" fill="currentColor" />
                <rect x="10" y="17" width="4" height="4" fill="currentColor" />
              </svg>
            </button>

            {/* `hidden` y no una clase: el estado cerrado es el del HTML, así
                que el menú nace cerrado aunque el script no llegue nunca. */}
            <div class="os-menu-pop" id="os-menu-pop" data-menu-pop role="menu" aria-labelledby="os-menu-btn" hidden>
              {/* Cambio de idioma. PRIMERA fila siempre, y no la segunda: es la
                  única que existe en las 10 páginas, así que dejándola arriba
                  el menú abre igual en todos lados y el dedo aprende un lugar.
                  Antes vivía suelto en la línea del nombre, del lado izquierdo,
                  porque en la fila de botones no entraba (los cinco sumaban
                  358.1px en 358 disponibles a 390); adentro del menú el ancho
                  deja de ser el problema y además deja de ser un chip de dos
                  letras sueltas en una barra llena de códigos de sistema.
                  Dice el idioma DESTINO y ahora con todas las letras: en un
                  renglón de menú "ESPAÑOL" cuesta lo mismo que "ES" y no hay
                  que descifrarlo. */}
              <a
                role="menuitem"
                class="os-lang-btn os-menu-item"
                href={altHref}
                hreflang={altLang}
                aria-label={lang === 'en' ? 'Ver en español' : 'View in English'}
                title={lang === 'en' ? 'Ver en español' : 'View in English'}
              >
                {/* Icono de traducción (A/文), SVG inline heredando currentColor.
                    Misma postura que el parlante: nada de emoji (🌐 sale en color,
                    rompe la barra mono y cada sistema lo dibuja distinto). */}
                <svg class="tr-ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M12.87 15.07l-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z" />
                </svg>
                <span class="mi-lbl">{altLang === 'es' ? 'ESPAÑOL' : 'ENGLISH'}</span>
              </a>
              {/* Corte de la música ambiente. Sólo donde hay escena — es lo
                  único que suena en el sitio. Vive en la barra y no en el HUD
                  de la escena por dos razones: el HUD es `pointer-events:
                  none`, y en un teléfono la esquina inferior ya es del
                  joystick. Lo cablea PortfolioScene (#ps-audio-toggle, sin
                  cambios). Arranca en 'on' porque la música entra sola; si el
                  visitante ya la apagó alguna vez, el script lo corrige antes
                  de que suene nada. */}
              {surface === 'game' && (
              <button
                type="button"
                role="menuitem"
                class="os-menu-item os-audio-btn"
                id="ps-audio-toggle"
                data-menu-keep
                aria-pressed="true"
                aria-label={lang === 'en' ? 'Ambient music' : 'Música ambiente'}
                title={lang === 'en' ? 'Ambient music' : 'Música ambiente'}
              >
                {/* Parlante en SVG, no un glifo. 🔊/🔇 son emoji: salen en color,
                    rompen la barra mono y cada sistema los dibuja distinto. Un
                    SVG hereda currentColor, asi que el mint de "encendido" y el
                    atenuado de "apagado" siguen saliendo del mismo CSS.
                    Los DOS iconos van en el HTML y el CSS muestra uno: asi el
                    estado no depende de que JS reconstruya nodos. */}
                <svg class="ab-ico ab-on" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
                  <path d="M3 9 H8 L13 4 V20 L8 15 H3 Z" fill="currentColor" />
                  <path d="M16.5 8.6a5 5 0 0 1 0 6.8" fill="none" stroke="currentColor" stroke-width="1.7" />
                  <path d="M19.4 6a8.6 8.6 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.7" />
                </svg>
                <svg class="ab-ico ab-off" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
                  <path d="M3 9 H8 L13 4 V20 L8 15 H3 Z" fill="currentColor" />
                  <path d="M16.6 9 L21.6 15 M21.6 9 L16.6 15" fill="none" stroke="currentColor" stroke-width="1.9" />
                </svg>
                {/* El estado en PALABRAS, no sólo en el icono. Adentro del menú
                    hay lugar y la fila es lo primero que se lee; el parlante
                    tachado hay que interpretarlo. Son dos <span> y los alterna
                    el CSS, igual que los dos parlantes: el estado no depende
                    de que JS reconstruya nodos. */}
                <span class="mi-lbl am-lbl am-on">{lang === 'en' ? 'MUSIC · ON' : 'MÚSICA · ON'}</span>
                <span class="mi-lbl am-lbl am-off">{lang === 'en' ? 'MUSIC · OFF' : 'MÚSICA · OFF'}</span>
              </button>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Main content -->
      <main class="os-main">
        <slot />
      </main>

      {/* Rail de contacto — GitHub/LinkedIn/formulario. Pedido explicito
          ("que se vean los links de LinkedIn, GitHub" en todas las paginas,
          no solo en el juego).

          VIVE ACA, al final del shell, y no arriba junto a la franja de
          identidad, porque tiene DOS disposiciones segun haya o no margen
          donde vivir (ver el CSS de .ps-icon-rail):
            - Desde 1400px: fija en la columna de margen izquierda, vertical.
              Al ser fija, su lugar en el DOM no la mueve.
            - Debajo de 1400px, en una pagina documento: deja de flotar y pasa
              a ser contenido en flujo, una fila horizontal al pie, justo
              encima del StatusBar. Ahi si importa donde este escrita.
          Un solo elemento con dos formas, no dos copias en el HTML. */}
      <nav class="ps-icon-rail" aria-label="Contact links">
        <a href="https://github.com/pabloler21" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.1 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.1-3.2.7-3.88-1.35-3.88-1.35-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .3.2.66.79.55A10.53 10.53 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg><span class="rail-lbl">GITHUB</span>
        </a>
        <a href="https://www.linkedin.com/in/pablo-lerner-591180336" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.44-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg><span class="rail-lbl">LINKEDIN</span>
        </a>
        {/* Va al formulario, NO a un mailto. Un `mailto:` no hace nada visible
            en una maquina sin cliente de correo configurado —que es la de casi
            cualquiera que usa Gmail en el navegador— asi que era el unico de
            los tres iconos que podia no responder al tocarlo. Y publicaba la
            direccion personal en texto plano en las 11 paginas del sitio, que
            es justo lo que rastrean los recolectores de spam. El formulario ya
            existe, sale desde contacto@pablolerner.dev y trae reply_to,
            honeypot y rate limit. */}
        <a href={`/${lang}/contact/`} aria-label={lang === 'en' ? 'Contact' : 'Contacto'} title={lang === 'en' ? 'Contact' : 'Contacto'}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13Zm2.2.5 7.3 5.47a.9.9 0 0 0 1 0L19.8 6H4.2Zm15.8 1.6-7.02 5.26a2.9 2.9 0 0 1-3.36 0L4.6 7.6v10.9h15.4V7.6Z"/></svg><span class="rail-lbl">{lang === 'en' ? 'EMAIL' : 'CORREO'}</span>
        </a>
      </nav>

      <!-- Footer -->
      {surface !== 'game' && (
      <StatusBar lang={lang} surface={surface} altHref={altHref} />
      )}
    </div>

    {surface === 'game' && (
    <script>
      (function () {
        /* Caída de datos de margen: POCAS y LENTAS. La versión anterior
           dibujaba una columna cada 10px avanzando 10px por frame (~600px/s),
           que es lo que hacía ruido. Ahora son ~1 hilo cada 70px cayendo a
           8–18 px/s, con velocidad en píxeles por SEGUNDO (independiente de
           los fps) y sin acumulación de estela. */
        const GLYPHS = '0123456789ABCDEF◆◇▸▪XZQV─═║';
        const CHAR_PX = 11;
        const GAP_PX  = 30;     /* separación media entre hilos */
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const pick = () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)];

        function makeRain(id: string) {
          const canvas = document.getElementById(id) as HTMLCanvasElement | null;
          if (!canvas) return;
          const ctx = canvas.getContext('2d')!;
          let W = 0, H = 0;
          let streams: { x: number; y: number; sp: number; g: string[] }[] = [];

          function build() {
            const n = Math.max(1, Math.round(W / GAP_PX));
            streams = Array.from({ length: n }, (_, i) => ({
              x: Math.round((i + 0.5) * (W / n) - CHAR_PX / 2),
              y: Math.random() * (H * 1.4) - H * 0.2,
              sp: 12 + Math.random() * 14,                     /* px por segundo */
              g: Array.from({ length: 9 + ((Math.random() * 8) | 0) }, pick),
            }));
          }

          function resize() {
            W = canvas.offsetWidth;
            H = canvas.offsetHeight;
            if (W < 4 || H < 4) return;
            canvas.width = W;
            canvas.height = H;
            build();
          }

          function paint() {
            ctx.clearRect(0, 0, W, H);
            ctx.font = `${CHAR_PX}px 'Share Tech Mono', monospace`;
            for (const st of streams) {
              for (let k = 0; k < st.g.length; k++) {
                const y = st.y - k * CHAR_PX;
                if (y < -CHAR_PX || y > H + CHAR_PX) continue;
                /* La cabeza es la más brillante, pero la cola tiene PISO:
                   una rampa lineal a cero deja los últimos glifos en ~0.04 y
                   el hilo entero desaparece sobre un fondo casi negro. */
                const a = 0.20 + 0.45 * (1 - k / st.g.length);
                ctx.fillStyle = k === 0
                  ? 'rgba(94,231,170,0.9)'
                  : `rgba(160,168,184,${a.toFixed(3)})`;
                ctx.fillText(st.g[k], st.x, y);
              }
            }
          }

          let last = 0;
          function frame(now: number) {
            if (canvas.offsetWidth < 4) { requestAnimationFrame(frame); return; }
            const dt = last ? Math.min((now - last) / 1000, 0.1) : 0;
            last = now;
            for (const st of streams) {
              st.y += st.sp * dt;
              if (st.y - st.g.length * CHAR_PX > H) {
                st.y = -Math.random() * H * 0.4;
                st.sp = 12 + Math.random() * 14;
                st.g = st.g.map(pick);
              } else if (Math.random() < dt * 0.9) {
                /* una sola mutación ocasional: da vida sin parpadeo */
                st.g[(Math.random() * st.g.length) | 0] = pick();
              }
            }
            paint();
            requestAnimationFrame(frame);
          }

          new ResizeObserver(resize).observe(canvas);
          resize();
          /* Con movimiento reducido queda el fondo oscuro y los glifos quietos. */
          if (reduced) paint();
          else requestAnimationFrame(frame);
        }

        makeRain('margin-rain-left');
        makeRain('margin-rain-right');
      })();
    </script>
    )}

    <script>
      /* ── Menús de la barra de identidad ───────────────────────────────
         UN solo script para TODOS los menús de la barra: cada `.os-menu`
         trae su botón y su popup marcados con `data-menu-btn` /
         `data-menu-pop`, en vez de ids cableados acá. Con ids sueltos, el
         segundo menú obliga a duplicar el bloque entero — incluidos el
         Escape y el click afuera, que son globales y terminarían siendo dos
         listeners peleándose por el mismo gesto.
         Vive en Base y no en PortfolioScene aunque algunos ítems sean de la
         escena: la barra se renderiza en TODAS las páginas y PortfolioScene
         sólo existe en una. Lo que PortfolioScene cablea es el ÍTEM
         (#ps-audio-toggle), no el menú.
         Abrir/cerrar es una sola cosa: el atributo `hidden`. El estado
         accesible (aria-expanded) se deriva de él y no se lleva aparte, así
         no pueden desincronizarse. */
      (function () {
        type Menu = { root: Element; btn: HTMLElement; pop: HTMLElement; hover?: boolean };
        const menus: Menu[] = [];
        document.querySelectorAll('.os-menu').forEach((root) => {
          const btn = root.querySelector<HTMLElement>('[data-menu-btn]');
          const pop = root.querySelector<HTMLElement>('[data-menu-pop]');
          if (btn && pop) menus.push({ root, btn, pop });
        });
        if (!menus.length) return;

        const isOpen = (m: Menu) => !m.pop.hasAttribute('hidden');

        function setOpen(m: Menu, open: boolean) {
          m.pop.toggleAttribute('hidden', !open);
          m.btn.setAttribute('aria-expanded', String(open));
          /* Uno por vez. Dos popups abiertos en la misma esquina se pisan, y
             el de al lado no se cierra solo: el click que abre el segundo cae
             DENTRO de su propio `.os-menu`, así que el "click afuera" del
             primero no lo ve. */
          if (open) menus.forEach(o => { if (o !== m && isOpen(o)) setOpen(o, false); });
        }

        menus.forEach((m) => {
          m.btn.addEventListener('click', () => {
            /* Un click NUNCA cierra un menú que el hover está sosteniendo
               abierto. Con mouse, apuntar al botón ya lo abre, así que el
               click de quien igual hace click caía en la otra mitad del
               toggle y lo cerraba — y como el puntero sigue adentro, no
               vuelve a abrirse hasta salir y entrar de nuevo: el botón
               parecía roto.
               Sigue cerrando con click donde NO hay hover que lo sostenga
               (un teléfono, o el teclado con Enter), que es el único caso en
               el que cerrar a mano hace falta. */
            if (!isOpen(m)) setOpen(m, true);
            else if (!m.hover) setOpen(m, false);
          });

          /* Elegir un ítem CIERRA el menú: es lo que espera cualquiera que
             haya usado un menú, y el que llega ahora —la lista de proyectos—
             lo necesita de verdad, porque su acción pasa DETRÁS del popup.
             La excepción se declara en el ítem y no acá: `data-menu-keep` la
             lleva el corte de música, porque cerrar taparía justo el feedback
             de ver el parlante tacharse. */
          m.pop.addEventListener('click', (e) => {
            const t = e.target;
            if (!(t instanceof Element)) return;
            const item = t.closest('[role="menuitem"]');
            if (!item || item.hasAttribute('data-menu-keep')) return;
            setOpen(m, false);
          });
        });

        /* Abrir al pasar el mouse, SÓLO donde hay un puntero fino de verdad.
           En táctil el `pointerenter` llega junto con el toque: el menú se
           abriría por hover y el click del mismo gesto lo cerraría en el
           acto, o sea que tocarlo no haría nada.
           Es opt-in por menú (`data-menu-hover`): lo pide la lista de
           proyectos, que es una lista para mirar. El kebab no — son ajustes,
           y un menú de ajustes que se abre solo cada vez que el mouse pasa
           camino a otro botón es ruido. */
        const punteroFino = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        if (punteroFino) {
          menus.filter(m => m.root.hasAttribute('data-menu-hover')).forEach((m) => {
            let cerrar: number | undefined;
            m.root.addEventListener('pointerenter', () => {
              clearTimeout(cerrar);
              m.hover = true;
              setOpen(m, true);
            });
            m.root.addEventListener('pointerleave', () => {
              m.hover = false;
              /* Demora corta y no cierre inmediato: entre el pie del botón y
                 el techo del popup hay 5.6px de aire que NO son parte del
                 `.os-menu`, así que bajar el mouse hacia la lista dispara un
                 `pointerleave` y sin la demora el menú se cierra justo cuando
                 lo estás por usar. */
              cerrar = window.setTimeout(() => setOpen(m, false), 220);
            });
          });
        }

        /* Escape cierra y DEVUELVE EL FOCO al botón. Sin lo segundo, quien
           navega con teclado cierra el menú y queda con el foco en la nada:
           el siguiente Tab arranca desde el principio del documento. */
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          const abierto = menus.find(isOpen);
          if (!abierto) return;
          setOpen(abierto, false);
          abierto.btn.focus();
        });

        /* Click afuera. `pointerdown` y no `click`: en un teléfono el click
           llega ~300ms después del toque en algunos navegadores, y el menú
           tiene que irse cuando el dedo toca, no cuando se levanta.
           Se excluye el `.os-menu` entero —botón y popup— o el botón y este
           handler se cancelarían entre sí: pointerdown cerraría y el click
           volvería a abrir. */
        document.addEventListener('pointerdown', (e) => {
          const t = e.target;
          menus.forEach((m) => {
            if (!isOpen(m)) return;
            if (t instanceof Node && m.root.contains(t)) return;
            setOpen(m, false);
          });
        });
      })();
    </script>

    <script>
      // ── Hover scramble — nav tabs + header CTAs (opt-in via data-scramble) ──
      // Cancel-safe: timer stored on the element, cleared on re-enter/leave,
      // text ALWAYS restored to the exact original. Hover only — never focus.
      (function () {
        const SCRAMBLE_CHARS = '◆◇▸▪0123456789XZQV';
        const DURATION = 350;
        const STEP = 30;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        function stopScramble(el: any) {
          if (el._scrambleTimer) {
            clearInterval(el._scrambleTimer);
            el._scrambleTimer = null;
          }
          if (typeof el._scrambleOriginal === 'string') {
            el.textContent = el._scrambleOriginal;
          }
        }

        function startScramble(el: any) {
          if (reducedMotion.matches) return;
          if (typeof el._scrambleOriginal !== 'string') {
            el._scrambleOriginal = el.textContent || '';
          }
          stopScramble(el); // clear any running pass before restarting
          const original: string = el._scrambleOriginal;
          const len = original.length;
          if (!len) return;
          const steps = Math.ceil(DURATION / STEP);
          let frame = 0;
          el._scrambleTimer = setInterval(() => {
            frame++;
            const settled = Math.floor((frame / steps) * len);
            let out = '';
            for (let i = 0; i < len; i++) {
              const ch = original[i];
              out += (i < settled || ch === ' ')
                ? ch
                : SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
            }
            el.textContent = out;
            if (frame >= steps) stopScramble(el); // settle back to exact original
          }, STEP);
        }

        document.querySelectorAll('[data-scramble]').forEach((host) => {
          const target = host.querySelector('[data-scramble-text]') || host;
          host.addEventListener('mouseenter', () => startScramble(target));
          host.addEventListener('mouseleave', () => stopScramble(target));
        });
      })();
    </script>
  </body>
</html>

<style>
  .os-shell {
    /* Opaco: sin esto, cualquier capa de fondo se lee A TRAVÉS del contenido. */
    background-color: var(--bg-void);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    border: 1px solid rgba(94,231,170,0.18);
    box-shadow: 0 0 40px rgba(94,231,170,0.04), 0 0 1px rgba(94,231,170,0.15);
    margin: 0 auto;
    max-width: 1400px;
    position: relative;
    z-index: 1;
  }

  /* La escena es el viewport y no scrollea, asi que en surface="game" el shell
     necesita una altura DEFINIDA y no un minimo: con `min-height` sola, lo que
     ocupa la escena tiene que salir de una constante (y de ahi venia la franja
     negra al pie, ver el comentario de `.ps-shell`). Con `height` el reparto lo
     hace el propio flex: la franja de identidad mide lo que mide —una linea en
     escritorio, dos en un telefono angosto— y `.ps-shell` se queda con el resto.

     `100svh` y no `100vh`: en un telefono `vh` es el viewport GRANDE (sin la
     barra del navegador), asi que con `vh` la pagina quedaria mas alta que lo
     visible y aparecerian unos pixeles de scroll en una pantalla que no
     scrollea. Hay que pisar tambien `min-height`, que si no gana ella. */
  html[data-surface='game'] .os-shell {
    height: 100svh;
    min-height: 0;

    /* Y ocupa el ancho: el juego se queda con todo menos las dos columnas de
       margen (ver --chrome-col). El tope de 1400 sigue valiendo en las paginas
       documento —una columna de texto de 2560px no se lee— pero en la escena
       era lo que la volvia cada vez mas cuadrada, y con eso mas alejada, a
       medida que crecia el monitor. */
    max-width: none;
    margin-inline: var(--chrome-col);
  }

  /* Alto definido en vez de mínimo, igual que en la escena y por la misma
     razón: con `min-height` el shell crece con el contenido y el reparto
     vertical lo decide lo más largo que haya adentro. Con `height` lo hace el
     propio flex y cada columna se queda con lo suyo.

     Sólo arriba de 900, que es donde hay dos columnas: apilado, encerrar la
     página en un viewport con scrolls adentro es peor que dejarla scrollear.
     Y `100svh` y no `100vh` porque en un teléfono `vh` es el viewport GRANDE
     (aunque acá no muerda, el criterio es el mismo que en la escena). */
  @media (min-width: 901px) {
    html[data-fill] .os-shell {
      height: 100svh;
      min-height: 0;
    }
    /* Sin esto el `flex: 1` no puede encoger por debajo de su contenido: el
       mínimo automático de un ítem flex es su tamaño de contenido, así que la
       lista de 16 volvería a empujar el shell hacia abajo. */
    html[data-fill] .os-main { min-height: 0; }
  }

  /* diagonal corner cut top-right */
  .os-shell::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0 18px 18px 0;
    border-color: transparent var(--bg-void) transparent transparent;
    z-index: 2;
  }

  /* ── OS chrome row (micro-text flavor) ── */
  .os-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
