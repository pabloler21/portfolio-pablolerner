    transition: color 0.15s, background-color 0.15s;
  }

  .os-menu-item:last-child { border-bottom: 0; }

  /* ── Filas de proyecto ── */
  .os-menu-pop-wide {
    /* Ancho FIJO, no `min-width`. Con un mínimo, la descripción más larga
