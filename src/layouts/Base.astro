    color: var(--sand);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-align: left;
    text-decoration: none;
    /* 44px de blanco de toque: esto se toca con el dedo, y es la única medida
