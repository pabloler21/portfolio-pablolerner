---
import TabBar from '../components/ui/TabBar.astro';
import DotRow from '../components/ui/DotRow.astro';
import StatusBar from '../components/ui/StatusBar.astro';
import AmbientCanvas from '../components/ui/AmbientCanvas.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'es';
  activeTab?: string;
  /* La ÚNICA condición que decide si existe la atmósfera. Default 'doc':
     una página nueva nace limpia y tiene que pedir atmósfera. */
  surface?: 'game' | 'doc';
  /* Pedido explícito: la página de contacto (a la que el obelisco
     teletransporta) no debe mostrar los tabs TERMINAL/DATA ANALYST/AI
     ENGINEER — se llega ahí desde el juego, no es un destino más del nav
     normal del sitio. Default true preserva el comportamiento de siempre
     para el resto de las páginas 'doc'. */
  showTabs?: boolean;
}

const {
  title,
  description = 'Pablo Lerner — Data Analyst · AI Engineer · Data Scientist',
  lang = 'en',
  activeTab = 'projects',
  surface = 'doc',
  showTabs = true,
} = Astro.props;

const altLang = lang === 'en' ? 'es' : 'en';
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://pablolerner.dev');
---

<!doctype html>
<html lang={lang} data-surface={surface}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <title>{title} · Pablo Lerner</title>

    <!-- SEO bilingual -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    <link rel="alternate" hreflang={altLang} href={new URL(Astro.url.pathname.replace(`/${lang}/`, `/${altLang}/`), canonicalURL.origin)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', canonicalURL.origin)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body>
    {/* Atmósfera: existe SÓLO donde el visitante puede caminar. Se excluye
        del render (no se oculta con CSS) para no descargar ni ejecutar nada
        de esto en la superficie documento. */}
    {surface === 'game' && (
      <>
        <div class="page-sweep" aria-hidden="true"></div>
        <AmbientCanvas />
        <canvas id="margin-rain-left" class="margin-chrome margin-chrome-left" aria-hidden="true"></canvas>
        <canvas id="margin-rain-right" class="margin-chrome margin-chrome-right" aria-hidden="true"></canvas>
      </>
    )}

    <div class="os-shell">
      {/* ponytail: os-title-row apagada junto con el resto de la UI en surface="game" */}

      {/* ponytail: identity strip vuelve a mostrarse también en surface="game" — pedido explícito ("la navbar con Pablo Lerner"). El resto de la UI (tabs/dots/footer) sigue apagado ahí. */}
      <!-- Identity strip — name, positioning, CTAs -->
      <div class="os-identity">
        <div class="identity-left">
          <a class="id-name" href={`/${lang}/`}>Pablo Lerner</a>
          <span class="id-sep sys-text"> · </span>
          <span class="id-role">
            {lang === 'en'
              ? 'Data Analyst & AI Engineer'
              : 'Data Analyst & AI Engineer'}
          </span>
        </div>
        {/* STREET + PROJECTS + CONTACT, top-right of the identity bar —
            asked explicitly ("arriba a la derecha, en el nav bar superior"),
            and asked again to show on every page, not just the game
            ("en la vista de Contact tendría que verse también los tres
            botones"). #ps-projects-tab is PortfolioScene's existing trigger
            id — its click handler and the drawer it opens only exist on the
            game page, so PROJECTS is that live button there and a plain
            link home everywhere else (there's nothing to open elsewhere). */}
        <div class="id-ctas">
          <a class="os-nav-btn" href={`/${lang}/`}>[ {lang === 'en' ? 'STREET' : 'CALLE'} ]</a>
          {surface === 'game' ? (
            <button type="button" class="os-nav-btn" id="ps-projects-tab" aria-expanded="false" aria-controls="ps-projects-drawer">[ PROJECTS ]</button>
          ) : (
            <a class="os-nav-btn" href={`/${lang}/`}>[ PROJECTS ]</a>
          )}
          <a class="os-nav-btn" href={`/${lang}/contact/`}>[ CONTACT ]</a>
          {/* Corte de la música ambiente. Vive acá y no en el HUD de la escena
              por dos razones: el HUD es `pointer-events: none`, y en un
              teléfono la esquina inferior ya es del joystick. Mismo precedente
              que #ps-projects-tab — sólo existe donde hay escena, y es
              PortfolioScene quien lo cablea. Arranca en 'on' porque la música
              entra al elegir rol; si el visitante ya la apagó alguna vez, el
              script lo corrige antes de que suene nada. */}
          {surface === 'game' && (
            <button
              type="button"
              class="os-nav-btn os-audio-btn"
              id="ps-audio-toggle"
              aria-pressed="true"
              aria-label={lang === 'en' ? 'Ambient music' : 'Música ambiente'}
              title={lang === 'en' ? 'Ambient music' : 'Música ambiente'}
            >
              {/* Parlante en SVG, no un glifo. 🔊/🔇 son emoji: salen en color,
                  rompen la barra mono y cada sistema los dibuja distinto. Un
                  SVG hereda currentColor, asi que el mint de "encendido" y el
                  atenuado de "apagado" siguen saliendo del mismo CSS.
                  Los DOS iconos van en el HTML y el CSS muestra uno: asi el
                  estado no depende de que JS reconstruya nodos. */}
              <svg class="ab-ico ab-on" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false">
                <path d="M3 9 H8 L13 4 V20 L8 15 H3 Z" fill="currentColor" />
                <path d="M16.5 8.6a5 5 0 0 1 0 6.8" fill="none" stroke="currentColor" stroke-width="1.7" />
                <path d="M19.4 6a8.6 8.6 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.7" />
              </svg>
              <svg class="ab-ico ab-off" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false">
                <path d="M3 9 H8 L13 4 V20 L8 15 H3 Z" fill="currentColor" />
                <path d="M16.6 9 L21.6 15 M21.6 9 L16.6 15" fill="none" stroke="currentColor" stroke-width="1.9" />
              </svg>
            </button>
          )}
        </div>
      </div>

      {/* Contact icon rail — GitHub/LinkedIn/email, fixed in the left margin
          column. Moved here from PortfolioScene (asked explicitly — "que se
          vean los links de LinkedIn, GitHub" on every page, not just the
          game); the rain behind it is still game-only, this just always
          renders in that same screen position. */}
      <nav class="ps-icon-rail" aria-label="Contact links">
        <a href="https://github.com/pabloler21" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.1 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.1-3.2.7-3.88-1.35-3.88-1.35-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .3.2.66.79.55A10.53 10.53 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/pablo-lerner-591180336" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.44-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
        </a>
        <a href="mailto:lerner.pb@gmail.com" aria-label="Email">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13Zm2.2.5 7.3 5.47a.9.9 0 0 0 1 0L19.8 6H4.2Zm15.8 1.6-7.02 5.26a2.9 2.9 0 0 1-3.36 0L4.6 7.6v10.9h15.4V7.6Z"/></svg>
        </a>
      </nav>

      <!-- Navigation -->
      {surface !== 'game' && showTabs && (
      <header class="os-header">
        <TabBar active={activeTab} lang={lang} />
        {surface === 'game' && <DotRow />}
      </header>
      )}

      <!-- Main content -->
      <main class="os-main">
        <slot />
      </main>

      <!-- Footer -->
      {surface !== 'game' && (
      <StatusBar lang={lang} surface={surface} />
      )}
    </div>

    {surface === 'game' && (
    <script>
      (function () {
        /* Caída de datos de margen: POCAS y LENTAS. La versión anterior
           dibujaba una columna cada 10px avanzando 10px por frame (~600px/s),
           que es lo que hacía ruido. Ahora son ~1 hilo cada 70px cayendo a
           8–18 px/s, con velocidad en píxeles por SEGUNDO (independiente de
           los fps) y sin acumulación de estela. */
        const GLYPHS = '0123456789ABCDEF◆◇▸▪XZQV─═║';
        const CHAR_PX = 11;
        const GAP_PX  = 30;     /* separación media entre hilos */
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const pick = () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)];

        function makeRain(id: string) {
          const canvas = document.getElementById(id) as HTMLCanvasElement | null;
          if (!canvas) return;
          const ctx = canvas.getContext('2d')!;
          let W = 0, H = 0;
          let streams: { x: number; y: number; sp: number; g: string[] }[] = [];

          function build() {
            const n = Math.max(1, Math.round(W / GAP_PX));
            streams = Array.from({ length: n }, (_, i) => ({
              x: Math.round((i + 0.5) * (W / n) - CHAR_PX / 2),
              y: Math.random() * (H * 1.4) - H * 0.2,
              sp: 12 + Math.random() * 14,                     /* px por segundo */
              g: Array.from({ length: 9 + ((Math.random() * 8) | 0) }, pick),
            }));
          }

          function resize() {
            W = canvas.offsetWidth;
            H = canvas.offsetHeight;
            if (W < 4 || H < 4) return;
            canvas.width = W;
            canvas.height = H;
            build();
          }

          function paint() {
            ctx.clearRect(0, 0, W, H);
            ctx.font = `${CHAR_PX}px 'Share Tech Mono', monospace`;
            for (const st of streams) {
              for (let k = 0; k < st.g.length; k++) {
                const y = st.y - k * CHAR_PX;
                if (y < -CHAR_PX || y > H + CHAR_PX) continue;
                /* La cabeza es la más brillante, pero la cola tiene PISO:
                   una rampa lineal a cero deja los últimos glifos en ~0.04 y
                   el hilo entero desaparece sobre un fondo casi negro. */
                const a = 0.20 + 0.45 * (1 - k / st.g.length);
                ctx.fillStyle = k === 0
                  ? 'rgba(94,231,170,0.9)'
                  : `rgba(160,168,184,${a.toFixed(3)})`;
                ctx.fillText(st.g[k], st.x, y);
              }
            }
          }

          let last = 0;
          function frame(now: number) {
            if (canvas.offsetWidth < 4) { requestAnimationFrame(frame); return; }
            const dt = last ? Math.min((now - last) / 1000, 0.1) : 0;
            last = now;
            for (const st of streams) {
              st.y += st.sp * dt;
              if (st.y - st.g.length * CHAR_PX > H) {
                st.y = -Math.random() * H * 0.4;
                st.sp = 12 + Math.random() * 14;
                st.g = st.g.map(pick);
              } else if (Math.random() < dt * 0.9) {
                /* una sola mutación ocasional: da vida sin parpadeo */
                st.g[(Math.random() * st.g.length) | 0] = pick();
              }
            }
            paint();
            requestAnimationFrame(frame);
          }

          new ResizeObserver(resize).observe(canvas);
          resize();
          /* Con movimiento reducido queda el fondo oscuro y los glifos quietos. */
          if (reduced) paint();
          else requestAnimationFrame(frame);
        }

        makeRain('margin-rain-left');
        makeRain('margin-rain-right');
      })();
    </script>
    )}

    <script>
      // ── Hover scramble — nav tabs + header CTAs (opt-in via data-scramble) ──
      // Cancel-safe: timer stored on the element, cleared on re-enter/leave,
      // text ALWAYS restored to the exact original. Hover only — never focus.
      (function () {
        const SCRAMBLE_CHARS = '◆◇▸▪0123456789XZQV';
        const DURATION = 350;
        const STEP = 30;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        function stopScramble(el: any) {
          if (el._scrambleTimer) {
            clearInterval(el._scrambleTimer);
            el._scrambleTimer = null;
          }
          if (typeof el._scrambleOriginal === 'string') {
            el.textContent = el._scrambleOriginal;
          }
        }

        function startScramble(el: any) {
          if (reducedMotion.matches) return;
          if (typeof el._scrambleOriginal !== 'string') {
            el._scrambleOriginal = el.textContent || '';
          }
          stopScramble(el); // clear any running pass before restarting
          const original: string = el._scrambleOriginal;
          const len = original.length;
          if (!len) return;
          const steps = Math.ceil(DURATION / STEP);
          let frame = 0;
          el._scrambleTimer = setInterval(() => {
            frame++;
            const settled = Math.floor((frame / steps) * len);
            let out = '';
            for (let i = 0; i < len; i++) {
              const ch = original[i];
              out += (i < settled || ch === ' ')
                ? ch
                : SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
            }
            el.textContent = out;
            if (frame >= steps) stopScramble(el); // settle back to exact original
          }, STEP);
        }

        document.querySelectorAll('[data-scramble]').forEach((host) => {
          const target = host.querySelector('[data-scramble-text]') || host;
          host.addEventListener('mouseenter', () => startScramble(target));
          host.addEventListener('mouseleave', () => stopScramble(target));
        });
      })();
    </script>
  </body>
</html>

<style>
  .os-shell {
    /* Opaco: sin esto, cualquier capa de fondo se lee A TRAVÉS del contenido. */
    background-color: var(--bg-void);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    border: 1px solid rgba(94,231,170,0.18);
    box-shadow: 0 0 40px rgba(94,231,170,0.04), 0 0 1px rgba(94,231,170,0.15);
    margin: 0 auto;
    max-width: 1400px;
    position: relative;
    z-index: 1;
  }

  /* diagonal corner cut top-right */
  .os-shell::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0 18px 18px 0;
    border-color: transparent var(--bg-void) transparent transparent;
    z-index: 2;
  }

  /* ── OS chrome row (micro-text flavor) ── */
  .os-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.18rem 1rem;
    border-bottom: 1px solid rgba(94,231,170,0.1);
    background: color-mix(in srgb, var(--bg-void) 85%, black);
  }

  .os-page {
    font-size: 0.7rem;
  }

  /* ── Identity strip ── */
  .os-identity {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.45rem 1rem;
    border-bottom: 1px solid rgba(94,231,170,0.1);
    background: var(--bg-panel);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .identity-left {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .id-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    color: var(--sand);
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .id-name:hover,
  .id-name:focus-visible {
    color: var(--accent-bright);
  }

  .id-sep {
    color: var(--sand-dim);
  }

  .id-role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--sand-muted);
  }

  .id-ctas {
    display: flex;
    align-items: center;
    justify-content: flex-end;   /* si en una pantalla muy angosta igual envuelve,
                                    el boton cae alineado con los de arriba y no
                                    colgando solo a la izquierda */
    gap: 0.4rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  /* PROJECTS/CONTACT, top-right of the identity bar (game surface only) —
     white text+border, asked explicitly ("se tienen que ver blancos"); the
     brightest token this palette allows is --sand, never pure #fff. One is
     a <button>, the other an <a> — asked explicitly to look identical
     ("que se vean iguales como botones"), so this resets the <button>'s
     UA chrome (appearance/line-height/box-sizing) rather than relying on
     each element's own default rendering. */
  .os-nav-btn {
    appearance: none;
    box-sizing: border-box;
    display: inline-block;
    line-height: normal;
    background: none;
    border: 1px solid var(--sand);
    color: var(--sand);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .os-nav-btn:hover,
  .os-nav-btn:focus-visible {
    color: var(--accent-bright);
    border-color: var(--accent-bright);
  }

  /* Toggle de la música ambiente. VA DESPUÉS DEL :hover a propósito: tiene la
     misma especificidad (dos clases contra clase + pseudo-clase), así que
     declarado antes el estado apagado nunca ganaría… y declarado después se
     come el hover, por eso el hover del apagado se repite explícitamente
     abajo. Es la lección 40 del repo, tercera vez.
     Encendido lleva el mint de "activo"; apagado se atenúa CON COLOR —nunca
     con opacity, lección 25— y además va tachado, para que el estado no
     dependa sólo del color. */
  .os-audio-btn {
    color: var(--accent-bright);
    border-color: var(--accent-bright);
  }

  /* El boton lleva iconos, no texto: hay que centrarlos contra los corchetes. */
  /* Sin corchetes y con padding propio: los corchetes enmarcan una PALABRA en
     este lenguaje, alrededor de un icono son 23px sin significado. Y esos 23px
     importaban: la fila de cuatro botones cerraba con 0.7px de sobra en un
     telefono de 390 y el boton se caia al renglon de abajo. Sigue leyendose
     como hermano de los otros porque conserva borde, alto y tipografia. */
  .os-audio-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.45rem;
    line-height: 1;
  }

  /* El icono mide 13px y la caja de texto de los botones hermanos mide 10.99,
     asi que sin esto el boton sale 2px mas alto y en una fila de cajas con
     borde el desalineo se ve. Se compensa 1px por lado en vez de achicar el
     icono a 11px: el parlante tiene que LEERSE, que es todo el pedido.
     verify:mobile M20 controla que los cuatro botones sigan midiendo igual. */
  .ab-ico { display: block; margin-block: -1px; }
  .ab-off { display: none; }

  .os-audio-btn.is-off {
    color: var(--sand-dim);
    border-color: var(--ink-mid);
  }

  /* El parlante tachado ES el estado apagado, asi que no hace falta el
     line-through que habia antes (y sobre un SVG solo habria tachado los
     corchetes). El estado sigue sin depender solo del color: cambia la
     FORMA del icono. */
  .os-audio-btn.is-off .ab-on { display: none; }
  .os-audio-btn.is-off .ab-off { display: block; }

  /* Detras de @media (hover: hover) a proposito. En tactil el :hover queda
     PEGADO despues de tocar, asi que el boton recien apagado se seguia viendo
     mint — justo en el momento en que el visitante necesita ver que se apago.
     En escritorio el hover del apagado sigue encendiendose. */
  @media (hover: hover) {
    .os-audio-btn.is-off:hover {
      color: var(--accent-bright);
      border-color: var(--accent-bright);
    }
  }

  .os-audio-btn.is-off:focus-visible {
    color: var(--accent-bright);
    border-color: var(--accent-bright);
  }

  /* ── Navigation header ── */
  .os-header {
    border-bottom: 1px solid rgba(94,231,170,0.1);
    flex-shrink: 0;
  }

  /* ── Main content ── */
  .os-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 640px) {
    .os-title-row .os-unit-id,
    .os-title-row .os-status { display: none; }

    .os-identity {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    /* En columna el separador queda colgando después del nombre. */
    .id-sep { display: none; }

    .id-ctas { gap: 0.3rem; }
  }

  /* ── Left icon rail — GitHub/LinkedIn/Email as icons ──
     Same fixed column the Matrix rain draws in (only nonzero above the
     1400px shell breakpoint) — renders on every page now, not just the
     game (asked explicitly), so it also shows with plain dark background
     behind it on 'doc' pages where the rain itself doesn't render. */
  .ps-icon-rail {
    position: fixed;
    top: 50%;
    left: 0;
    width: max(0px, calc((100vw - 1400px) / 2));
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    pointer-events: auto;
    z-index: 5;
  }

  .ps-icon-rail a {
    color: var(--sand);   /* the brightest token this palette allows — no pure #fff */
    transition: color 0.15s ease, transform 0.15s ease;
