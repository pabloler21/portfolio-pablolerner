---
import TabBar from '../components/ui/TabBar.astro';
import DotRow from '../components/ui/DotRow.astro';
import StatusBar from '../components/ui/StatusBar.astro';
import AmbientCanvas from '../components/ui/AmbientCanvas.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'es';
  activeTab?: string;
  /* La ÚNICA condición que decide si existe la atmósfera. Default 'doc':
     una página nueva nace limpia y tiene que pedir atmósfera. */
  surface?: 'game' | 'doc';
}

const {
  title,
  description = 'Pablo Lerner — Data Analyst · AI Engineer · Data Scientist',
  lang = 'en',
  activeTab = 'projects',
  surface = 'doc',
} = Astro.props;

const altLang = lang === 'en' ? 'es' : 'en';
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://pablolerner.dev');
---

<!doctype html>
<html lang={lang} data-surface={surface}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <title>{title} · Pablo Lerner</title>

    <!-- SEO bilingual -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    <link rel="alternate" hreflang={altLang} href={new URL(Astro.url.pathname.replace(`/${lang}/`, `/${altLang}/`), canonicalURL.origin)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', canonicalURL.origin)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body>
    {/* Atmósfera: existe SÓLO donde el visitante puede caminar. Se excluye
        del render (no se oculta con CSS) para no descargar ni ejecutar nada
        de esto en la superficie documento. */}
    {surface === 'game' && (
      <>
        <div class="page-sweep" aria-hidden="true"></div>
        <AmbientCanvas />
        <canvas id="margin-rain-left" class="margin-chrome margin-chrome-left" aria-hidden="true"></canvas>
        <canvas id="margin-rain-right" class="margin-chrome margin-chrome-right" aria-hidden="true"></canvas>
      </>
    )}

    <div class="os-shell">
      {surface === 'game' && (
        <div class="os-title-row">
          <span class="os-unit-id sys-text">UNIT::PL-7729</span>
          <span class="os-page sys-text">{title}</span>
          <span class="os-status sys-text">SYS:OK · {lang.toUpperCase()}</span>
        </div>
      )}

      <!-- Identity strip — name, positioning, CTAs -->
      <div class="os-identity">
        <div class="identity-left">
          <span class="id-name">Pablo Lerner</span>
          <span class="id-sep sys-text"> · </span>
          <span class="id-role">
            {lang === 'en'
              ? 'Data Analyst & AI Engineer — from raw data to production decisions'
              : 'Data Analyst & AI Engineer — de datos crudos a decisiones de negocio'}
          </span>
        </div>
        <nav class="id-ctas" aria-label="Contact links">
          <a href="https://github.com/pabloler21" class="cta-btn" target="_blank" rel="noopener noreferrer" data-scramble>[ GitHub ↗ ]</a>
          <a href="https://www.linkedin.com/in/pablo-lerner-591180336" class="cta-btn" target="_blank" rel="noopener noreferrer" data-scramble>[ LinkedIn ↗ ]</a>
          <a href="mailto:lerner.pb@gmail.com" class="cta-btn" data-scramble>[ Email ]</a>
          <a href="/pablo-lerner-cv.pdf" class="cta-btn cta-primary" download data-scramble>[ CV ↓ ]</a>
        </nav>
      </div>

      <!-- Navigation -->
      <header class="os-header">
        <TabBar active={activeTab} lang={lang} />
        {surface === 'game' && <DotRow />}
      </header>

      <!-- Main content -->
      <main class="os-main">
        <slot />
      </main>

      <!-- Footer -->
      <StatusBar lang={lang} surface={surface} />
    </div>

    {surface === 'game' && (
    <script>
      (function () {
        /* Caída de datos de margen: POCAS y LENTAS. La versión anterior
           dibujaba una columna cada 10px avanzando 10px por frame (~600px/s),
           que es lo que hacía ruido. Ahora son ~1 hilo cada 70px cayendo a
           8–18 px/s, con velocidad en píxeles por SEGUNDO (independiente de
           los fps) y sin acumulación de estela. */
        const GLYPHS = '0123456789ABCDEF◆◇▸▪XZQV─═║';
        const CHAR_PX = 11;
        const GAP_PX  = 30;     /* separación media entre hilos */
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const pick = () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)];

        function makeRain(id: string) {
          const canvas = document.getElementById(id) as HTMLCanvasElement | null;
          if (!canvas) return;
          const ctx = canvas.getContext('2d')!;
          let W = 0, H = 0;
          let streams: { x: number; y: number; sp: number; g: string[] }[] = [];

          function build() {
            const n = Math.max(1, Math.round(W / GAP_PX));
            streams = Array.from({ length: n }, (_, i) => ({
              x: Math.round((i + 0.5) * (W / n) - CHAR_PX / 2),
              y: Math.random() * (H * 1.4) - H * 0.2,
              sp: 12 + Math.random() * 14,                     /* px por segundo */
              g: Array.from({ length: 9 + ((Math.random() * 8) | 0) }, pick),
            }));
          }

          function resize() {
            W = canvas.offsetWidth;
            H = canvas.offsetHeight;
            if (W < 4 || H < 4) return;
            canvas.width = W;
            canvas.height = H;
            build();
          }

          function paint() {
            ctx.clearRect(0, 0, W, H);
            ctx.font = `${CHAR_PX}px 'Share Tech Mono', monospace`;
            for (const st of streams) {
              for (let k = 0; k < st.g.length; k++) {
                const y = st.y - k * CHAR_PX;
                if (y < -CHAR_PX || y > H + CHAR_PX) continue;
                /* La cabeza es la más brillante, pero la cola tiene PISO:
                   una rampa lineal a cero deja los últimos glifos en ~0.04 y
                   el hilo entero desaparece sobre un fondo casi negro. */
                const a = 0.20 + 0.45 * (1 - k / st.g.length);
                ctx.fillStyle = k === 0
                  ? 'rgba(94,231,170,0.9)'
                  : `rgba(160,168,184,${a.toFixed(3)})`;
                ctx.fillText(st.g[k], st.x, y);
              }
            }
          }

          let last = 0;
          function frame(now: number) {
            if (canvas.offsetWidth < 4) { requestAnimationFrame(frame); return; }
            const dt = last ? Math.min((now - last) / 1000, 0.1) : 0;
            last = now;
            for (const st of streams) {
              st.y += st.sp * dt;
              if (st.y - st.g.length * CHAR_PX > H) {
                st.y = -Math.random() * H * 0.4;
                st.sp = 12 + Math.random() * 14;
                st.g = st.g.map(pick);
              } else if (Math.random() < dt * 0.9) {
                /* una sola mutación ocasional: da vida sin parpadeo */
                st.g[(Math.random() * st.g.length) | 0] = pick();
              }
            }
            paint();
            requestAnimationFrame(frame);
          }

          new ResizeObserver(resize).observe(canvas);
          resize();
          /* Con movimiento reducido queda el fondo oscuro y los glifos quietos. */
          if (reduced) paint();
          else requestAnimationFrame(frame);
        }

        makeRain('margin-rain-left');
        makeRain('margin-rain-right');
      })();
    </script>
    )}

    <script>
      // ── Hover scramble — nav tabs + header CTAs (opt-in via data-scramble) ──
      // Cancel-safe: timer stored on the element, cleared on re-enter/leave,
      // text ALWAYS restored to the exact original. Hover only — never focus.
      (function () {
        const SCRAMBLE_CHARS = '◆◇▸▪0123456789XZQV';
        const DURATION = 350;
        const STEP = 30;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        function stopScramble(el: any) {
          if (el._scrambleTimer) {
            clearInterval(el._scrambleTimer);
            el._scrambleTimer = null;
          }
          if (typeof el._scrambleOriginal === 'string') {
            el.textContent = el._scrambleOriginal;
          }
        }

        function startScramble(el: any) {
          if (reducedMotion.matches) return;
          if (typeof el._scrambleOriginal !== 'string') {
            el._scrambleOriginal = el.textContent || '';
          }
          stopScramble(el); // clear any running pass before restarting
          const original: string = el._scrambleOriginal;
          const len = original.length;
          if (!len) return;
          const steps = Math.ceil(DURATION / STEP);
          let frame = 0;
          el._scrambleTimer = setInterval(() => {
            frame++;
            const settled = Math.floor((frame / steps) * len);
            let out = '';
            for (let i = 0; i < len; i++) {
              const ch = original[i];
              out += (i < settled || ch === ' ')
                ? ch
                : SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
            }
            el.textContent = out;
            if (frame >= steps) stopScramble(el); // settle back to exact original
          }, STEP);
        }

        document.querySelectorAll('[data-scramble]').forEach((host) => {
          const target = host.querySelector('[data-scramble-text]') || host;
          host.addEventListener('mouseenter', () => startScramble(target));
          host.addEventListener('mouseleave', () => stopScramble(target));
        });
      })();
    </script>
  </body>
</html>

<style>
  .os-shell {
    /* Opaco: sin esto, cualquier capa de fondo se lee A TRAVÉS del contenido. */
    background-color: var(--bg-void);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    border: 1px solid rgba(94,231,170,0.18);
    box-shadow: 0 0 40px rgba(94,231,170,0.04), 0 0 1px rgba(94,231,170,0.15);
    margin: 0 auto;
    max-width: 1400px;
    position: relative;
    z-index: 1;
  }

  /* diagonal corner cut top-right */
  .os-shell::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0 18px 18px 0;
    border-color: transparent var(--bg-void) transparent transparent;
    z-index: 2;
  }

  /* ── OS chrome row (micro-text flavor) ── */
  .os-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.18rem 1rem;
    border-bottom: 1px solid rgba(94,231,170,0.1);
    background: color-mix(in srgb, var(--bg-void) 85%, black);
  }

  .os-page {
    font-size: 0.7rem;
  }

  /* ── Identity strip ── */
  .os-identity {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.45rem 1rem;
    border-bottom: 1px solid rgba(94,231,170,0.1);
    background: var(--bg-panel);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .identity-left {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .id-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    color: var(--sand);
    white-space: nowrap;
  }

  .id-sep {
    color: var(--sand-dim);
  }

  .id-role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--sand-muted);
  }

  .id-ctas {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  /* ── Navigation header ── */
  .os-header {
    border-bottom: 1px solid rgba(94,231,170,0.1);
    flex-shrink: 0;
  }

  /* ── Main content ── */
  .os-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 640px) {
    .os-title-row .os-unit-id,
    .os-title-row .os-status { display: none; }

    .os-identity {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    /* En columna el separador queda colgando después del nombre. */
    .id-sep { display: none; }

    .id-ctas { gap: 0.3rem; }
  }

  /* ── Margin chrome — NieR chrome panels in browser margins beyond 1200px ── */
  .margin-chrome {
    position: fixed;
    top: 0;
    bottom: 0;
    width: max(0px, calc((100vw - 1400px) / 2));
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--sand-dim);
    white-space: nowrap;
  }

  .margin-chrome-left {
    left: 0;
  }

  .margin-chrome-right {
    right: 0;
  }

  .margin-chrome::after {
    content: '';
    position: absolute;
    width: 1px;
    height: 25%;
    background: linear-gradient(to bottom, transparent, var(--accent), transparent);
    opacity: 0;
    pointer-events: none;
    animation: margin-scan 12s ease-in-out infinite;
  }

  .margin-chrome-left::after {
    right: 0;
    animation-delay: 0s;
  }

  .margin-chrome-right::after {
    left: 0;
    animation-delay: 6s;
  }

  @keyframes margin-scan {
    0%        { top: -25%; opacity: 0; }
    6%        { opacity: 0.55; }
    88%       { top: 100%; opacity: 0.28; }
    100%      { top: 100%; opacity: 0; }
  }

  /* ── Canvas rain panels ── */
  /* NUNCA declarar `width` acá: estos selectores de ID apuntan al MISMO
     elemento que .margin-chrome y ganan por especificidad; un `width: 100%`
     sobre un position:fixed resuelve contra el viewport y convierte cada
     panel en una capa animada de 100vw sobre todo el sitio.

     `height: 100%` en cambio es OBLIGATORIO: <canvas> es un elemento
     reemplazado, así que con `top:0; bottom:0` y `height:auto` no se estira
     — usa su alto intrínseco (150px) y la caída queda cortada arriba. */
  #margin-rain-left,
  #margin-rain-right {
    display: block;
    height: 100%;
    background: var(--bg-void);
  }

  /* ── Page-entry scanline sweep ─────────────────────── */
  /* One-shot mint line crossing the viewport top→bottom on load.
     z-index 800: above content, below PersonaSelector (9000) and
     scanlines/grain (9997+). */
  .page-sweep {
    position: fixed;
    top: -6px;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(94, 231, 170, 0.4) 18%,
      rgba(94, 231, 170, 0.4) 82%,
      transparent
    );
    box-shadow: 0 0 14px 2px rgba(94, 231, 170, 0.16);
    opacity: 0;
    pointer-events: none;
    z-index: 800;
    animation: page-sweep-drop 0.7s cubic-bezier(0.3, 0.1, 0.3, 1) 1 forwards;
  }

  @keyframes page-sweep-drop {
    0%   { transform: translateY(0); opacity: 0; }
    8%   { opacity: 0.85; }
    78%  { opacity: 0.45; }
    100% { transform: translateY(calc(100vh + 12px)); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-sweep {
      animation-duration: 0.01s; /* never animation:none — kills fill-mode */
    }
  }
</style>
