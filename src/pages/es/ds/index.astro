---
import RoleLayout from '../../../layouts/RoleLayout.astro';

const stats = [
  { label: 'ESPECIALIZACIÓN', value: 'ML Pipelines · NLP · Clasificación' },
  { label: 'REGISTROS', value: 'SINCRONIZACIÓN EN PROGRESO' },
  { label: 'HERRAMIENTAS', value: 'scikit-learn · HuggingFace · PyTorch' },
  { label: 'ESTADO', value: 'ACTIVO · DISPONIBLE', bright: true },
];
---

<RoleLayout
  title="Data Scientist — Registros"
  lang="es"
  role="ds"
  description="Pablo Lerner — Perfil Data Scientist: pipelines ML, NLP, clasificación de sentimientos en español."
  heading="DATA SCIENTIST"
  badge="EN DESARROLLO"
  subline="PERFIL DE UNIDAD · ACCESO: ABIERTO · REGISTROS: CARGANDO"
  stats={stats}
>
  <div class="ds-archive">
    <p class="ds-label sys-text">ARCHIVO DE MEMORIA · <span class="ds-pending">SINCRONIZACIÓN PENDIENTE</span></p>

    <div class="ds-box">
      <p class="ds-coming">PRÓXIMAMENTE</p>
      <p class="ds-note sys-text">// REGISTROS CARGANDO — SINCRONIZACIÓN EN PROGRESO</p>

      <ul class="ds-rows">
        {[1, 2, 3].map(n => (
          <li class="ds-row">
            <span class="ds-cursor" aria-hidden="true">◇</span>
            <span class="ds-num">{`0${n}`}</span>
            <span class="ds-redact">████████████████████</span>
            <span class="ds-badge">PENDIENTE</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</RoleLayout>

<style>
  .ds-archive {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ds-label { font-size: 0.56rem; }
  .ds-pending { color: var(--sand-dim); }

  .ds-box {
    border: var(--border-mid);
    background: var(--bg-panel);
    padding: 1.4rem 1.25rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ds-coming {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    letter-spacing: 0.4em;
    color: var(--sand-muted);
  }

  .ds-note {
    font-size: 0.56rem;
    margin-bottom: 0.6rem;
  }

  .ds-rows {
    list-style: none;
    border: var(--border);
  }

  .ds-row {
    display: grid;
    grid-template-columns: 0.8rem 1.4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.4rem;
    padding: 0.52rem 0.55rem;
    border-left: 2px solid transparent;
    font-family: var(--font-mono);
    color: var(--sand-dim);
    opacity: 0.5;
    cursor: default;
  }
  .ds-row + .ds-row { border-top: var(--border); }

  .ds-cursor { color: var(--accent); font-size: 0.6rem; opacity: 0.5; }
  .ds-num    { font-size: 0.6rem; letter-spacing: 0.08em; }

  .ds-redact {
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
    overflow: hidden;
  }

  .ds-badge {
    font-size: 0.5rem;
    letter-spacing: 0.15em;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--sand-dim);
  }
</style>
