---
import RoleLayout from '../../../layouts/RoleLayout.astro';
import { aiProjects } from '../../../data/projects';

const projects = aiProjects.map(p => ({
  id:       p.id,
  name:     p.es.name,
  problem:  p.es.problem,
  outcome:  p.es.outcome || undefined,
  stack:    p.stack,
  status:   p.statusEs ?? p.status,
  featured: p.featured,
  github:   p.github,
  demo:     p.demo,
}));

const stats = [
  { label: 'ESPECIALIZACIÓN', value: 'LLM · Multi-agente · RAG · Tool-calling' },
  { label: 'PROYECTO ESTRELLA', value: 'IRIS — ASISTENTE DE IA PERSONAL', sub: '1.2M vectores indexados · corre solo en systemd' },
  { label: 'HERRAMIENTAS', value: 'Python · LangChain · FastAPI · Claude API · Qdrant' },
  { label: 'ESTADO', value: 'ACTIVO · DISPONIBLE', bright: true },
];
---

<RoleLayout
  title="AI Engineer — Registros"
  lang="es"
  role="ai"
  description="Pablo Lerner — AI Engineer: sistemas LLM, pipelines multi-agente, RAG, servicios FastAPI."
  heading="AI ENGINEER"
  badge="ESPECIALIZACIÓN"
  subline={`PERFIL DE UNIDAD · ACCESO: ABIERTO · REGISTROS: ${projects.length}`}
  stats={stats}
  projects={projects}
/>
