---
import RoleLayout from '../../../layouts/RoleLayout.astro';
import { riskProjects } from '../../../data/projects';

const projects = riskProjects.map(p => ({
  id:       p.id,
  name:     p.es.name,
  problem:  p.es.problem,
  outcome:  p.es.outcome || undefined,
  stack:    p.stack,
  status:   p.statusEs ?? p.status,
  featured: p.featured,
  github:   p.github,
  demo:     p.demo,
}));

const stats = [
  { label: 'ESPECIALIZACIÓN', value: 'Riesgo Crediticio · Detección de Fraude · BI Dashboards · SQL' },
  { label: 'PROYECTO ESTRELLA', value: 'FRAUDSENSE AI', sub: 'AUC-ROC 0.971 · precisión 0.943 · 1.85M filas' },
  { label: 'HERRAMIENTAS', value: 'Python · SQL · Power BI · scikit-learn · FastAPI · Claude API' },
  { label: 'ESTADO', value: 'ACTIVO · DISPONIBLE', bright: true },
];
---

<RoleLayout
  title="Data Analyst — Registros"
  lang="es"
  role="risk"
  description="Pablo Lerner — Data Analyst: detección de fraude, credit scoring, SQL, dashboards Power BI."
  heading="DATA ANALYST"
  badge="PERFIL PRINCIPAL"
  badgeBright
  subline={`PERFIL DE UNIDAD · ACCESO: ABIERTO · REGISTROS: ${projects.length}`}
  stats={stats}
  projects={projects}
/>
