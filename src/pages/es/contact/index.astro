---
import Base from '../../../layouts/Base.astro';

const lang = 'es';
---

<Base title="Contacto" lang={lang} activeTab="contact" description="Ponete en contacto con Pablo Lerner." showTabs={false}>
  <section class="contact-wrap">
    <h1 class="contact-title">CONTACTO</h1>
    <p class="contact-sub sys-text">PERFIL DE UNIDAD · NIVEL DE ACCESO: ABIERTO</p>

    <form id="contact-form" class="contact-form"
      data-t-send="[ ENVIAR → ]" data-t-sending="[ ENVIANDO… ]"
      data-t-ok="Mensaje enviado. Te respondo a la brevedad." data-t-err="No se pudo enviar. Escribime directo a:" data-t-rate="Demasiados mensajes desde acá. Probá en un rato, o escribime directo a:">
      {/* Honeypot: invisible para una persona, irresistible para un bot.
          Si viene con algo, el servidor responde 200 y NO manda nada — al bot
          no se le avisa que lo detectamos, para que no reintente de otra forma. */}
      <label class="c-hp" aria-hidden="true">
        <span>Dejá este campo vacío</span>
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
      <label class="c-field">
        <span class="c-label">NOMBRE</span>
        <input type="text" name="name" autocomplete="name" required />
      </label>
      <label class="c-field">
        <span class="c-label">EMAIL</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label class="c-field">
        <span class="c-label">MENSAJE</span>
        <textarea name="message" rows="5" required></textarea>
      </label>
      <div class="c-actions">
        <button type="submit" class="cta-btn cta-primary">[ ENVIAR → ]</button>
        <a class="cta-btn" href={`/${lang}/`}>[ ← CALLE ]</a>
      </div>
<p id="c-note" class="c-note sys-text" role="status" aria-live="polite" hidden></p>
    </form>
  </section>
</Base>

<script>
  /* El formulario postea a /api/contact, un servicio chico en el mismo VPS que
     habla con Resend. NO se llama a Resend desde acá: la API key es un secreto
     y cualquiera podría leerla del bundle y mandar mails en nombre del sitio. */
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const note = document.getElementById('c-note');
  const btn  = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  /* Partido a proposito. Como string entero quedaba en el bundle servido, o
     sea en texto plano en las paginas de contacto, que es lo que rastrean los
     recolectores de spam. Partirlo NO lo hace secreto —un scraper que ejecuta
     JS lo arma igual— pero lo saca del texto plano, que es el caso comun. Se
     usa .join() y no una suma de literales porque el minificador pliega
     'a' + 'b' a 'ab' y volveria a dejarlo entero. verify:ui C10 lo controla
     sobre el HTML CONSTRUIDO, no sobre el fuente. */
  const MAIL = ['lerner.pb', 'gmail.com'].join('@');

  function say(text: string, withMail: boolean) {
    if (!note) return;
    note.textContent = text;
    if (withMail) {
      note.append(' ');
      const a = document.createElement('a');
      a.href = `mailto:${MAIL}`;
      a.textContent = MAIL;
      note.append(a);
    }
    note.removeAttribute('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn) return;
    const d = form.dataset;
    const fd = new FormData(form);
    btn.disabled = true;
    btn.textContent = d.tSending ?? '…';
    say('', false);
    note?.setAttribute('hidden', '');

    try {
      const r = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name:    String(fd.get('name')    ?? ''),
          email:   String(fd.get('email')   ?? ''),
          message: String(fd.get('message') ?? ''),
          website: String(fd.get('website') ?? ''),   /* honeypot */
        }),
      });
      if (r.ok)                   { form.reset(); say(d.tOk ?? '', false); }
      else if (r.status === 429)  { say(d.tRate ?? '', true); }
      else                        { say(d.tErr ?? '', true); }
    } catch {
      /* Sin red, o el servicio caido: siempre queda el mail directo. */
      say(d.tErr ?? '', true);
    } finally {
      btn.disabled = false;
      btn.textContent = d.tSend ?? '';
    }
  });
</script>

<style>
  .contact-wrap {
    max-width: 560px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--sand);
    margin: 0 0 0.4rem;
  }

  .contact-sub {
    color: var(--sand-dim);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    margin: 0 0 2.2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }

  .c-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .c-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--sand-dim);
  }

  input,
  textarea {
    background: var(--bg-panel);
    border: var(--border-mid);
    color: var(--sand);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    padding: 0.6rem 0.7rem;
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent-bright);
    outline-offset: 2px;
  }

  .c-actions {
    display: flex;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }

  .c-note {
    color: var(--sand-dim);
    font-size: 0.78rem;
  }

  .c-note a {
    color: var(--accent-bright);
  }

  /* Fuera de pantalla en vez de display:none ni opacity: un bot que lee el DOM
     lo completa igual, y un lector de pantalla lo saltea por el aria-hidden. */
  .c-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
