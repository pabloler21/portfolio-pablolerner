---
import RoleLayout from '../../../layouts/RoleLayout.astro';
import { aiProjects } from '../../../data/projects';

const projects = aiProjects.map(p => ({
  id:       p.id,
  name:     p.en.name,
  problem:  p.en.problem,
  outcome:  p.en.outcome || undefined,
  stack:    p.stack,
  status:   p.status,
  featured: p.featured,
  github:   p.github,
  demo:     p.demo,
}));

const stats = [
  { label: 'SPECIALIZATION', value: 'LLM · Multi-agent · RAG · Tool-calling' },
  { label: 'FLAGSHIP', value: 'IRIS — PERSONAL AI ASSISTANT', sub: '1.2M vectors indexed · unattended on systemd' },
  { label: 'TOOLS', value: 'Python · LangChain · FastAPI · Claude API · Qdrant' },
  { label: 'STATUS', value: 'ACTIVE · OPEN TO WORK', bright: true },
];
---

<RoleLayout
  title="AI Engineer — Records"
  lang="en"
  role="ai"
  description="Pablo Lerner — AI Engineer: LLM systems, multi-agent pipelines, RAG, FastAPI services."
  heading="AI ENGINEER"
  badge="SPECIALIZATION"
  subline={`UNIT PROFILE · ACCESS LEVEL: OPEN · RECORDS: ${projects.length}`}
  stats={stats}
  projects={projects}
/>
