---
import RecordsLayout from '../../../layouts/RecordsLayout.astro';
import { projects } from '../../../data/projects';

const toDossier = (p: typeof projects[0]) => ({
  id:       p.id,
  name:     p.en.name,
  problem:  p.en.problem,
  outcome:  p.en.outcome || undefined,
  stack:    p.stack,
  status:   p.status,
  tracks:   p.tracks,
  featured: p.featured,
  github:   p.github,
  demo:     p.demo,
});

const records = projects.map(toDossier);

/* Dos cajas y no cuatro. FLAGSHIP repetía lo que ya dicen la primera fila de la
   lista y el panel de detalle, y RANGE ("Fraud detection · Credit risk · SQL ·
   Power BI") quedó cubierto por las etiquetas y el filtro. En un teléfono las
   cuatro se comían una pantalla entera antes de llegar a los proyectos. */
const stats = [
  { label: 'SPECIALIZATION', value: 'LLM systems · Multi-agent · RAG · Tool-calling' },
  { label: 'STATUS', value: 'ACTIVE · OPEN TO WORK', bright: true },
];
---

<RecordsLayout
  title="Records"
  lang="en"
  description="Pablo Lerner — AI Engineer & Data Analyst: LLM systems, multi-agent pipelines, RAG, FastAPI services, fraud detection and BI."
  heading="AI ENGINEER & DATA ANALYST"
  badge="UNIT PROFILE"
  subline={`ACCESS LEVEL: OPEN · RECORDS: ${records.length}`}
  stats={stats}
  projects={records}
/>
