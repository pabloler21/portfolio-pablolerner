---
import RoleLayout from '../../../layouts/RoleLayout.astro';
import { riskProjects } from '../../../data/projects';

const projects = riskProjects.map(p => ({
  id:       p.id,
  name:     p.en.name,
  problem:  p.en.problem,
  outcome:  p.en.outcome || undefined,
  stack:    p.stack,
  status:   p.status,
  featured: p.featured,
  github:   p.github,
  demo:     p.demo,
}));

const stats = [
  { label: 'SPECIALIZATION', value: 'Credit Risk · Fraud Detection · BI Dashboards · SQL' },
  { label: 'FLAGSHIP', value: 'FRAUDSENSE AI', sub: 'AUC-ROC 0.971 · precision 0.943 · 1.85M rows' },
  { label: 'TOOLS', value: 'Python · SQL · Power BI · scikit-learn · FastAPI · Claude API' },
  { label: 'STATUS', value: 'ACTIVE · OPEN TO WORK', bright: true },
];
---

<RoleLayout
  title="Data Analyst — Records"
  lang="en"
  role="risk"
  description="Pablo Lerner — Data Analyst: fraud detection, credit scoring, SQL, Power BI dashboards."
  heading="DATA ANALYST"
  badge="PRIMARY ROLE"
  badgeBright
  subline={`UNIT PROFILE · ACCESS LEVEL: OPEN · RECORDS: ${projects.length}`}
  stats={stats}
  projects={projects}
/>
