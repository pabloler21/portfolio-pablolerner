---
/* Antes era RoleNav y su menú elegía entre dos páginas de rol. Con una sola
   página de records ese menú ya no navega a ningún lado: pasa a saltar a los
   dos bloques del listbox que la página ya renderiza (data-jump → select(idx)
   en el controlador de RecordsLayout). Se reusa la máquina de selección que ya
   existe en vez de un scroll a un ancla. */
interface Props {
  lang: 'en' | 'es';
  aiCount: number;
  dataCount: number;
}

const { lang, aiCount, dataCount } = Astro.props;
const base = `/${lang}`;
const pad2 = (n: number) => String(n).padStart(2, '0');

const blocks = [
  { jump: 0,       label: 'AI ENGINEER',  count: aiCount },
  { jump: aiCount, label: 'DATA ANALYST', count: dataCount },
];

const t = {
  panelLabel: lang === 'en' ? 'RECORD BLOCKS'          : 'BLOQUES',
  back:       lang === 'en' ? 'STREET'                 : 'CALLE',
  available:  lang === 'en' ? 'OPEN TO WORK'           : 'DISPONIBLE',
};
---

<div class="role-nav">
  <p class="panel-label sys-text">{t.panelLabel}</p>

  <a href={`${base}/`} class="back-link">
    <span class="arr">◀</span>
    <span>{t.back}</span>
  </a>

  <nav class="role-menu">
    {blocks.map(b => (
      <button type="button" class="role-item" data-jump={b.jump}>
        <span class="cursor">◆</span>
        <span>{b.label}</span>
        <span class="block-count sys-text">{pad2(b.count)}</span>
      </button>
    ))}
  </nav>

  {/* LAT/LON/UNIT ID es atrezzo del juego, no información. En un documento
      sólo queda el dato que un evaluador realmente usa. */}
  <div class="meta-block sys-text">
    <p class="available">{t.available}</p>
  </div>
</div>

<style>
  .role-nav {
    border-right: var(--border);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .panel-label {
    padding: 0.6rem 1rem;
    border-bottom: var(--border);
    font-size: 0.7rem;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-bottom: var(--border);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--sand-dim);
    text-decoration: none;
    transition: color 0.12s, background 0.12s;
  }
  .back-link:hover { color: var(--sand); background: var(--bg-panel); }
  .back-link .arr  { color: var(--accent); }

  .role-menu { display: flex; flex-direction: column; }

  .role-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem 0.6rem 0.85rem;
    border-left: 2px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--sand-dim);
    text-decoration: none;
    transition: color 0.12s, background 0.12s, border-color 0.12s;
  }
  .role-item {
    width: 100%;
    background: none;
    text-align: left;
    cursor: pointer;
  }
  .role-item:hover         { color: var(--sand); background: var(--bg-panel); }
  .role-item.active        { background: var(--bg-panel); color: var(--sand); border-left-color: var(--accent-bright); }
  .role-item:focus-visible { outline: 1px solid var(--accent); outline-offset: -1px; }

  .cursor { font-size: 0.7rem; color: var(--accent); width: 1rem; flex-shrink: 0; }

  .block-count {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--sand-dim);
  }

  .meta-block {
    margin-top: auto;
    padding: 1rem;
    border-top: var(--border);
    line-height: 2;
    font-size: 0.7rem;
  }

  .meta-block .available { color: var(--accent-bright); opacity: 1; }
</style>
