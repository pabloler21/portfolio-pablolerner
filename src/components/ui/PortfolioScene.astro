---
import { aiProjects, riskProjects } from '../../data/projects.ts';

interface Props { lang: 'en' | 'es' }
const { lang = 'en' } = Astro.props;

type ZoneKey = 'risk' | 'ai';

const mapProj = (p: typeof aiProjects[0], l: 'en' | 'es') => ({
  name:     p[l].name,
  desc:     p[l].problem,
  outcome:  p[l].outcome,
  status:   l === 'en' ? p.status : (p.statusEs ?? p.status),
  github:   p.github,
  demo:     p.demo ?? '',
  featured: p.featured ?? false,
  stack:    p.stack.slice(0, 6),
});

/* Every project of the role gets its own billboard now — asked explicitly
   ("que estén TODOS los proyectos en la calle"). */
const zoneProjects = {
  risk: riskProjects.map(p => mapProj(p, lang)),
  ai:   aiProjects.map(p => mapProj(p, lang)),
  ds:   [] as ReturnType<typeof mapProj>[],
};

const zoneLabels = {
  en: { risk: 'DATA ANALYST', ai: 'AI ENGINEER', ds: 'DATA SCIENTIST' },
  es: { risk: 'DATA ANALYST', ai: 'AI ENGINEER', ds: 'DATA SCIENTIST' },
}[lang];

const allUrl: Record<ZoneKey, string> = {
  risk: `/${lang}/risk/`,
  ai:   `/${lang}/ai/`,
};
const contactUrl = `/${lang}/contact/`;

const allLabel        = lang === 'en' ? 'VIEW ALL RECORDS →' : 'VER TODOS →';
const dossier = {
  mission:    lang === 'en' ? 'MISSION' : 'MISIÓN',
  other:      lang === 'en' ? 'OTHER RECORDS' : 'OTROS REGISTROS',
  stack:      'STACK',
  discovered: lang === 'en' ? 'DISCOVERED' : 'DESCUBIERTOS',
  prev:       lang === 'en' ? '◀ PREV' : '◀ ANT',
  next:       lang === 'en' ? 'NEXT ▶' : 'SIG ▶',
  code:    'CODE ↗',
  live:    'LIVE ↗',
  wip:     lang === 'en' ? 'WORK IN PROGRESS' : 'EN DESARROLLO',
};
const backLabel       = lang === 'en' ? '◀ RETURN' : '◀ VOLVER';
const returnLabel     = lang === 'en' ? 'RETURN' : 'VOLVER';
---

<div class="ps-shell" id="ps-shell">

  <!-- 3D canvas -->
  <canvas id="ps-canvas" aria-hidden="true"></canvas>

  <!-- Cinematic intro hero — first visit only, fades before the selector -->
  <div id="ps-hero" class="ps-hero" aria-hidden="true">
    <div class="ps-hero-name">Pablo Lerner</div>
    <div class="ps-hero-sub" id="ps-hero-sub">ACCESS TERMINAL</div>
  </div>

  <!-- HUD overlay -->
  <div class="ps-hud" id="ps-hud" aria-hidden="true">
    <div class="ps-minimap" id="ps-minimap">
      <canvas id="ps-minimap-canvas" width="140" height="190"></canvas>
    </div>
  </div>

  <!-- Left rail (GitHub/LinkedIn/mail) now lives in Base.astro, rendered on
       every page, not just this one — asked explicitly. -->

  <!-- Right drawer: full project list — click teleports, sidebar stays closed for now.
       The trigger button itself lives in Base.astro's top identity bar now
       (asked explicitly — "arriba a la derecha, en el nav bar superior"),
       same #ps-projects-tab id, wired up below regardless of which
       component rendered it. -->
  <aside class="ps-projects-drawer" id="ps-projects-drawer" aria-label="Project list">
    <div class="pd-list" id="pd-list"></div>
  </aside>

  <!-- Project dossier panel (slides in from right, auto-closes when you
       step out of the small activation circle — asked explicitly, no more
       manual return button or badge chrome, just the essentials). -->
  <aside class="ps-panel" id="ps-panel" aria-label="Project dossier">
    <h2 class="panel-title" id="panel-title">—</h2>
    <div class="panel-cards" id="panel-cards"></div>
    <a class="panel-all cta-btn" id="panel-all" href="#">{allLabel}</a>
  </aside>

  <!-- 2D fallback (mobile / no WebGL) -->
  <div class="ps-fallback hidden" id="ps-fallback">
    <p class="panel-title sys-text">ACCESS UNIT SELECTION</p>
    <nav class="fb-menu" role="menu">
      <a class="fb-item" href={allUrl.risk} role="menuitem">
        <span class="fb-cursor">◆</span> DATA ANALYST <span class="fb-tag">PRIMARY</span>
      </a>
      <a class="fb-item" href={allUrl.ai} role="menuitem">
        <span class="fb-cursor"></span> AI ENGINEER
      </a>
      <a class="fb-item" href={allUrl.ds} role="menuitem">
        <span class="fb-cursor"></span> DATA SCIENTIST
      </a>
    </nav>
  </div>

</div>

<script type="application/json" id="ps-data" set:html={JSON.stringify({ zoneProjects, zoneLabels, allUrl, allLabel, dossier, contactUrl })}></script>
<script>
/* Plain <script> — no define:vars — so Vite bundles it and import('three') resolves.
   define:vars forces is:inline, which skips Vite processing entirely. */
const { zoneProjects, zoneLabels, allUrl, allLabel, dossier, contactUrl } = JSON.parse(document.getElementById('ps-data').textContent);
(function () {
  /* ── Guards ── */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touch   = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
  const narrow  = window.innerWidth < 768;

  if (touch || narrow) {
    document.getElementById('ps-fallback').classList.remove('hidden');
    document.getElementById('ps-canvas').style.display  = 'none';
    document.getElementById('ps-hud').style.display     = 'none';
    return;
  }

  /* Billboard positions are computed per-role by buildRoleBillboards (avenue
     layout) — there are no fixed zones anymore */
  const CENTER = { x: 0, z: 4 };

  let scene, camera, renderer;
  let charGroup;
  let charX = CENTER.x, charZ = CENTER.z;
  let targetX = CENTER.x, targetZ = CENTER.z;
  let camTgtX = CENTER.x, camTgtZ = CENTER.z;
  let shakeT = 0;   /* camera shake on death — decaying timer, triggered in respawnAtEntrance() */
  const SHAKE_DUR = 0.4, SHAKE_MAG = 0.9;   /* bumped up — asked explicitly ("mas potente") */
  let isMoving = false;
  let activeZone = null;
  let zoneMeshes = [];   // [{mesh: hitbox, key, projIdx}]
  let visible = true;
  let t = 0;
  let mixer = null;
  let walkAction = null;
  let runAction = null;
  let idleAction = null;
  let moveAction = null;          /* la acción de locomoción activa: walk, run o idle — nunca null una vez cargado el mixer */
  let locoState = 'idle';         /* 'idle' | 'walk' | 'run' — tracked separately from moveAction since idle reuses walkAction */
  /* Stand-in pose for the broken Idle clip: the "passing" frame of the 1.0333s
     Walking clip — an exact keyframe, so LINEAR sampling lands on it verbatim.
     Measured from the GLB by sampling every keyframe and scoring each bone
     against its OWN swing mean (deviation from the identity quaternion is
     meaningless here — Mixamo's rest pose is a T-pose, so "closest to bind"
     picks a mid-stride lunge, which is exactly what the previous 0.80 was).
     The arms swing in true anti-phase, so both cross their neutral at the
     same instant: at 0.4667 the pair is 8.4° off neutral combined — the
     global minimum of the cycle — and the thighs are 11° apart, near their
     closest. Every other frame is worse on both counts at once (0.80 was
     37.7° of arm swing and a 63° stride, the widest in the clip). */
  const WALK_NEUTRAL_TIME = 0.4667;
  /* Measured from the GLB: the time in Running (0.633s duration) where
     mixamorigLeftUpLeg/RightUpLeg are furthest apart on their swing axis —
     the widest point of the running stride, used as the frozen jump pose. */
  const JUMP_POSE_TIME = 0.267;
  let prevMoving = false;
  let animClock = null;
  let jumping = false; let jumpT = 0;   /* salto procedural — no hay clip Jump en el GLB (sólo Running/Walking/Idle) */
  /* JUMP_H es SÓLO estética: la compuerta del charco es booleana sobre
     `jumping` (ver CRATER_ZS abajo), así que la altura no decide nada. Quien
     decide es JUMP_DUR × la velocidad horizontal — 11.58u de alcance, contra
     un charco de 3.6u.
     Historia de la altura, para que no se revierta sola: primero se pidió un
     salto plano ("flatter leap, not a high hop") y quedó en 1.3; después se
     pidió más altura porque el salto "se queda corto" y subió a 1.8 (= la
     altura del personaje); ahí se pidió bajarlo en dos pasos ("apenas", y
     después "un poco menos") hasta 1.45. El que se quedaba corto igual era el
     alcance, no la altura; se arregló aparte en tick(). */
  const JUMP_DUR = 1.4, JUMP_H = 1.45;
  const JUMP_SPEED_MULT = 1.5;
  const keys = {};
  const WALK_SPEED = 0.042;
  const SPRINT_MULT = 2.1;   /* was 1.8, then 2.0 — +5% again to cut foot-sliding, asked explicitly */
  /* Los clips de Mixamo vienen "in place", así que su cadencia hay que atarla a
     WALK_SPEED o los pies patinan. A 60 fps son ~2.5 u/s caminando y ~5.0
     esprintando; estos factores emparejan el ciclo con esa velocidad
     (RUN_TIMESCALE escalado en la misma proporción que SPRINT_MULT). */
  const WALK_TIMESCALE = 1.8;
  const RUN_TIMESCALE  = 1.44;
  let composer = null;
  let activeRole = null;
  /* Dynamic billboards: built on role selection, destroyed on role change.
     Exactly N billboards exist for N projects of the active role — nothing else.
     AVENUE layout: boards spread along the street alternating sides, flagship
     last as the finale. Boards start dark and power on by proximity. */
  /* ponytail: CHAR_HEIGHT anchors building/monument scale to the character.
     Remy's GLB is normalized+centered at load (no direct Box3 measurement is
     taken here — buildCityDressing runs before the async GLB load resolves),
     so this is the same ~1.8u reference already implied by the existing
     chest-height fill-light position (0, 1.6, ...) a few lines below. */
  const CHAR_HEIGHT = 1.8;
  let roleBillGroup = null;  // THREE.Group holding ALL billboard structure of the active role
  let roleBillRefs = [];     // [{mesh, frame, edges, hit, ring, borderColor, isHero, projIdx, bx, bz, lit}]
  /* squared distance (8u radius) at which a board powers on/off. Boards sit
     off to the side (bx=±6.5) again, so the circle needs to reach far enough
     to still cover a player walking straight down the middle (lateral
     distance alone is already ~6.5) — an 8u radius gives roughly a ±4.6u
     window in z around each board, which is enough at the 10u board spacing. */
  const PROXIMITY_R2 = 64;
  const SPINNER_TICKS = 10;    /* segments in the loading-spinner ring, lighting up one by one */
  const SPINNER_FILL_TIME = 1.1;   /* seconds to fully fill while standing in the small circle */
  const SPINNER_R = 1.3;       /* the SMALL circle's radius — must physically stand inside this (not just the big 8u sensor) for the fill to progress */
  /* Craters before the 1st and 2nd billboard. La compuerta de tick() es
     BOOLEANA sobre `jumping`: en el aire se pasa siempre, sin importar la
     altura del arco (no hay ningún umbral de jumpY, aunque este comentario
     dijo durante un tiempo que sí). En el piso, corriendo se cae y se
     respawnea; caminando (Shift) se choca contra el borde como una pared. */
  const CRATER_ZS = [-5, -35];   /* 2nd moved to a different stretch of the avenue entirely, not squeezed right after the 1st between boards 1 and 2 */
  const CRATER_HALF_W = 1.8;     /* bigger, asked explicitly */
  const OBELISK_X = 0, OBELISK_Z = -84;   /* must match buildCityDressing's obX/obZ — touch-to-navigate check lives in tick() */
  const OBELISK_TOUCH_R2 = 9;             /* 3u radius */
  let obeliskTouched = false;             /* one-shot latch so the mailto redirect fires once per approach, not every frame inside range */
  const SIDEBAR_ENABLED = true;           /* re-enabled — the small-circle spinner completing now opens a simplified version of it */
  const DEATH_ENABLED = true;             /* re-enabled after the diagnostic pass */
  /* World bounds — keeps the character on the street, out of buildings.
     -76 fits the longest role (risk, 7 boards, deepest at z=-70) plus margin. */
  const BOUND_X = 8.8, BOUND_Z_MIN = -87, BOUND_Z_MAX = 4.5;   /* -87 so the obelisk at z=-84 is actually reachable to touch */
  const clampX = (v) => Math.max(-BOUND_X, Math.min(BOUND_X, v));
  const clampZ = (v) => Math.max(BOUND_Z_MIN, Math.min(BOUND_Z_MAX, v));
  let targetRotY = Math.PI;  // character heading, lerped in tick (no snap turns) — PI faces into the avenue (-z), away from the camera
  /* Flagship accent (Deus Ex amber) — decorative marking only, never interactive */
  const FLAG = 0x9a7b2d, FLAG_BRIGHT = 0xc9a94f;
  let sceneW = 1; let sceneH = 1;
  let minimapCtx = null;     // 2D context of the HUD minimap canvas
  let frameCount = 0;
  let introActive = false;   // cinematic camera pan on first visit
  let introT = 0;
  let particles = null; let particleVelocities = null;
  let heroEl = null;
  /* Gameplay FX pool — footstep dust, jump takeoff/landing puffs, crater
     splash. Sprites (not the ambient THREE.Points above) so each burst
     particle can fade/scale on its own timer independently. */
  let fxPool = []; let fxDotTexture = null;
  const FX_POOL_MAX = 60;
  let craterMaterials = [];   // ShaderMaterial per pit, uTime advanced in tick()
  let carColliders = [];      // [{x, z, r}] simple circle colliders, built once in buildStreet

  async function init() {
    const canvas = document.getElementById('ps-canvas');
    const shell  = document.getElementById('ps-shell');

    /* WebGL probe on a throwaway canvas — never call getContext on the real canvas
       before the renderer does, or a second call with different attributes fails */
    try {
      const probe = document.createElement('canvas');
      if (!probe.getContext('webgl2') && !probe.getContext('webgl')) {
        showFallback(); return;
      }
    } catch (_) { showFallback(); return; }

    const THREE = await import('three');
    const { GLTFLoader } = await import('three/addons/loaders/GLTFLoader.js');

    heroEl = document.getElementById('ps-hero');
    const mmCv = document.getElementById('ps-minimap-canvas');
    if (mmCv) {
      /* Display puro: el minimapa NO mueve al personaje (sólo WASD). */
      minimapCtx = mmCv.getContext('2d');
    }

    /* Measure AFTER imports — layout is stable by now */
    const rect = shell.getBoundingClientRect();
    const W = Math.max(rect.width,  window.innerWidth  * 0.7, 400);
    const H = Math.max(rect.height, window.innerHeight * 0.55, 400);
    sceneW = W; sceneH = H;

    /* ── Renderer ── */
    renderer = new THREE.WebGLRenderer({ canvas, alpha: false, antialias: true });
    renderer.setSize(W, H, false);
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.setClearColor(0x0d0f14, 1);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.shadowMap.enabled = false;

    /* ── Scene + Fog ── */
    scene = new THREE.Scene();
    /* Density scaled down from 0.018 to keep the same haze-at-the-skyline
       look now that the skyline sits at z=-96 instead of z=-58 (avenue got
       much longer to fit every project as its own billboard). */
    scene.fog = new THREE.FogExp2(0x0d0f14, 0.011);

    /* ── Camera — street perspective ── */
    camera = new THREE.PerspectiveCamera(52, W / H, 0.1, 80);
    camera.position.set(0, 4.5, 12);
    camera.lookAt(0, 2, -5);

    /* ── Bloom post-processing (after scene+camera exist; skip if reduced-motion) ── */
    if (!reduced) {
      try {
        const [{ EffectComposer }, { RenderPass }, { UnrealBloomPass }, { OutputPass }] = await Promise.all([
          import('three/addons/postprocessing/EffectComposer.js'),
          import('three/addons/postprocessing/RenderPass.js'),
          import('three/addons/postprocessing/UnrealBloomPass.js'),
          import('three/addons/postprocessing/OutputPass.js'),
        ]);
        composer = new EffectComposer(renderer);
        composer.addPass(new RenderPass(scene, camera));
        const bloom = new UnrealBloomPass(new THREE.Vector2(W, H), 0.6, 0.4, 0.4);
        composer.addPass(bloom);
        composer.addPass(new OutputPass());
      } catch (_) { /* bloom is enhancement only — scene works without it */ }
    }

    /* ── Atmospheric lighting ── */
    scene.add(new THREE.HemisphereLight(0x2a3040, 0x0d0f14, 0.9));
    const keyLight = new THREE.DirectionalLight(0xa0a8b8, 0.7);
    keyLight.position.set(8, 20, 5);
    scene.add(keyLight);
    scene.add(new THREE.AmbientLight(0x1c2030, 0.55));

    /* ── City geometry ── */
    buildStreet(THREE);
    buildCityDressing(THREE);
    buildParticles(THREE);

    /* Preload fonts before drawing billboard CanvasTextures */
    try {
      await Promise.all([
        document.fonts.load('bold 17px "Share Tech Mono"'),
        document.fonts.load('12px "Share Tech Mono"'),
        document.fonts.load('11px "Share Tech Mono"'),
      ]);
    } catch (_) { /* non-critical — canvas will use fallback monospace */ }
    /* No billboards at init — the scene starts as clean city. Billboards are
       built dynamically in the nier:zone handler when a role is selected. */

    /* ── nier:zone listener — registered HERE (before GLB load) so PersonaSelector's
       600ms dispatch is never missed even if the model takes time to download. ── */
    window.addEventListener('nier:zone', (e) => {
      const zone = e.detail?.zone;
      if (!zone) return;
      /* Dedupe — PersonaSelector (600ms) and our sessionStorage fallback (200ms)
         can both fire on reload; the second identical event must no-op or
         showPanel runs twice and scramble/type animations interleave. */
      if (zone === activeRole) return;
      activeRole = zone;

      /* Rebuild billboards for the selected role only — everything from the
         previous role is destroyed. N projects → N billboards, nothing else. */
      buildRoleBillboards(THREE, zone);
      navigateTo(zone);
      populateProjectsDrawer(zone);
    });

    /* Fallback: if sessionStorage has a stored zone, re-dispatch after init completes */
    const storedZone = sessionStorage.getItem('nier-persona');
    if (storedZone) {
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('nier:zone', { detail: { zone: storedZone } }));
      }, 200);
    }

    /* ── Character ── */
    buildCharPlaceholder(THREE);
    animClock = new THREE.Clock();
    try {
      const gltf = await new Promise((res, rej) =>
        new GLTFLoader().load('/models/remy.glb', res, undefined, rej)
      );
      scene.remove(charGroup);
      /* El GLB trae su propia normalización (escala y centrado) en el nodo raíz,
         y el tick pisa position/rotation del grupo en cada frame. Si se usara
         gltf.scene directamente esa normalización se perdería, así que va
         envuelto: el wrapper es lo que maneja la escena, el nodo interno
         conserva su transform. */
      charGroup = new THREE.Group();
      charGroup.add(gltf.scene);
      charGroup.position.set(charX, 0, charZ);
      charGroup.rotation.y = targetRotY;   /* spawn facing into the avenue, not the camera */
      scene.add(charGroup);

      /* El personaje conserva SUS materiales. El override que había acá pisaba
         todo con 0x181b22 sobre un fondo 0x0d0f14 y era lo que lo hacía
         desaparecer: la forma quedaba a cargo de la luz, y cuando la luz fallaba
         sólo se veían los joints. */

      /* Luz de acompañamiento, neutra y tenue: lo despega del fondo sin teñirlo.
         Antes era un PointLight mint a 2.5 — con materiales reales le pintaba de
         verde la piel y la ropa. Y sin tone mapping los altos recortan duro, así
         que a más intensidad el personaje lee naranja fluorescente. */
      const fillLight = new THREE.PointLight(0xcfd8e6, 0.85, 8);
      fillLight.position.set(0.5, 1.6, 1.3);
      charGroup.add(fillLight);

      /* Unit tag is rendered as HTML overlay (see #unit-tag-hud) — no 3D sprite needed */

      animClock.start();
      mixer = new THREE.AnimationMixer(charGroup);
      const clips = gltf.animations;
      /* Clips de Mixamo empaquetados en el GLB: Running, Walking, Idle.
         Nombre exacto primero: el matcheo difuso solo es lo que hacía que el
         personaje anterior caminara con Walk_Carry_Loop. */
      const pick = re => clips.find(c => re.test(c.name)) ?? null;
      const walkClip = pick(/^walking$/i) ?? pick(/walk/i);
      const runClip  = pick(/^running$/i) ?? pick(/run|sprint|jog/i);
      const idleClip = pick(/^idle$/i) ?? pick(/idle/i);
      const loopIt = clip => {
        const a = mixer.clipAction(clip);
        a.setLoop(THREE.LoopRepeat, Infinity);
        a.clampWhenFinished = false;
        return a;
      };
      if (walkClip) walkAction = loopIt(walkClip);
      if (runClip)  runAction  = loopIt(runClip);
      /* El clip Idle ES una respiración de 9.93s y SE REPRODUCE. Durante un
         tiempo estuvo vacío (0 pistas) y el idle era un frame congelado de
         Walking: el personaje quedaba como una estatua. La causa era la
         conversión, no el asset — cada FBX de Mixamo trae la animación real
         más una "Take 001" vacía, y en Breathing Idle.fbx la vacía viene
         primera, así que el `animations[0]` de entonces se llevó la vacía.
         Se rehornea con `node scripts/build-character-glb.mjs`. */
      if (idleClip && idleClip.tracks.length > 0) idleAction = loopIt(idleClip);
      startIdlePose();
      locoState = 'idle';
    } catch (_) { /* placeholder stays on load failure */ }

    /* ── Events ── */
    canvas.addEventListener('click', onCanvasClick.bind(null, THREE));
    canvas.addEventListener('mousemove', onHover.bind(null, THREE));
    document.getElementById('ps-projects-tab').addEventListener('click', (e) => {
      const drawer = document.getElementById('ps-projects-drawer');
      const open = drawer.classList.toggle('open');
      /* Drawer overlaps the project dossier rather than closing it — asked
         explicitly ("mejor no reemplazar sino superponerse, son dos
         paneles distintos"). */
      e.currentTarget.setAttribute('aria-expanded', String(open));
      e.currentTarget.blur();   /* left focused after a click, Space (jump) would silently re-toggle this on keyup */
    });
    document.addEventListener('visibilitychange', () => { visible = !document.hidden; });
    new IntersectionObserver(e => { visible = e[0].isIntersecting; }, { threshold: 0.1 }).observe(canvas);

    /* WASD — scoped to movement keys only so we don't block browser shortcuts.
       Shift is tracked for sprint but NEVER preventDefault'd (Shift+Tab etc.) */
    const WASD_CODES = ['KeyW','KeyA','KeyS','KeyD','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'];
    document.addEventListener('keydown', e => {
      if (WASD_CODES.includes(e.code)) { keys[e.code] = true; e.preventDefault(); }
      else if (e.key === 'Shift') keys.Shift = true;
      else if (e.code === 'Space') {
        e.preventDefault();   /* Space scrolls the page by default */
        if (!jumping) {
          jumping = true; jumpT = 0;
          spawnFxBurst(THREE, charX, 0.05, charZ, 0xff8c42, 8, { spread: 0.035, vy: 0.02, life: 0.35, size: 0.22 });
        }
      }
    });
    document.addEventListener('keyup', e => {
      keys[e.code] = false;
      if (e.key === 'Shift') keys.Shift = false;
      /* Browsers fire a native click on a focused <button> when Space is
         RELEASED (not pressed) — preventDefault on keydown alone doesn't
         stop that. With the new PROJECTS tab/drawer rows/panel-close buttons
         this session added, if one still had focus (e.g. the last thing
         clicked before jumping into the game), every jump also silently
         re-clicked it — re-teleporting the character, resetting nothing,
         while the player thought they were just jumping over a crater. */
      if (e.code === 'Space') e.preventDefault();
    });

    /* Cinematic intro — first visit only (no persona chosen yet). The camera
       starts on a high wide shot of the avenue and eases down to street level
       while the hero title shows; PersonaSelector waits ~2.4s before fading in. */
    if (!sessionStorage.getItem('nier-persona') && !reduced) {
      introActive = true;
      introT = 0;
      const heroEl = document.getElementById('ps-hero');
      heroEl.classList.add('show');
      setTimeout(() => scrambleIn(document.getElementById('ps-hero-sub'), 'ACCESS TERMINAL'), 350);
    }

    tick(THREE);
    window.addEventListener('resize', onResize);

    /* HDRI lazy — after first frame, non-blocking */
    requestIdleCallback(() => loadHDRI(THREE), { timeout: 3000 });
  }

  /* A radial gradient (near-black center fading toward the rim) is what
     actually sells "hole" in a scene with no real lighting/shading — a flat
     color plane never does, regardless of how dark it is. Never pure black
     per the hard constraint, so the center is a near-black, not #000. */
  /* Radioactive-green glow (asked explicitly, edge line removed) — bright
     toxic center fading to transparent, meant to be used with additive
     blending so it actually glows against the dark asphalt, the same
     convention as every other glow in this scene (ground rings, streetlamp
     falloff before it was removed, etc). */
  /* Simple animated "water" shader — asked explicitly ("que se note que es
     un líquido"), a static gradient read as a flat glow, not a liquid.
     Concentric rings sweeping outward from center + a fade near the jagged
     edge; cheap (one sine per fragment), no geometry displacement needed
     since the plane is flush with the asphalt. uTime is advanced from
     tick()'s own clock (t) via craterMaterials.
     ponytail: the edge fade used to start almost immediately (d=0.1) and
     run all the way to the boundary (d=1.0), so most of the shape was
     already faded well before reaching the actual jagged polygon edge —
     the visible glow read as a smooth inscribed ellipse, not the jagged
     mesh underneath ("se ven como ovalados", asked explicitly). Keeping the
     interior solid and only feathering right at the true edge lets the
     mesh's own jagged silhouette read through instead of a circular vignette. */
  function makeWaterMaterial(THREE) {
    return new THREE.ShaderMaterial({
      uniforms: { uTime: { value: 0 }, uColor: { value: new THREE.Color(0x6ee85a) } },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec3 uColor;
        varying vec2 vUv;
        void main() {
          vec2 c = vUv - 0.5;
          float d = length(c) * 2.0;
          float wave = sin(d * 11.0 + uTime * 2.2) * 0.5 + 0.5;   /* + instead of - : ripples travel edge→center, asked explicitly */
          float edge = 1.0 - smoothstep(0.65, 1.2, d);
          gl_FragColor = vec4(uColor, edge * (0.22 + wave * 0.32));
        }
      `,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
  }

  /* An irregular jagged outline instead of a clean rectangle — asked
     explicitly, a crater shouldn't look like a cut piece of asphalt. Seeded
     so it's stable across re-renders of the same crater. */
  function jaggedHoleShape(THREE, width, depth, seed) {
    const shape = new THREE.Shape();
    const N = 14;
    let s = seed;
    const rand = () => { s = (s * 1103515245 + 12345) & 0x7fffffff; return s / 0x7fffffff; };
    const pts = [];
    for (let i = 0; i < N; i++) {
      const a = (i / N) * Math.PI * 2;
      const jag = 0.72 + rand() * 0.5;
      pts.push([Math.cos(a) * (width / 2) * jag, Math.sin(a) * (depth / 2) * jag]);
    }
    shape.moveTo(pts[0][0], pts[0][1]);
    for (let i = 1; i < pts.length; i++) shape.lineTo(pts[i][0], pts[i][1]);
    shape.closePath();
    return shape;
  }

  /* THREE.ShapeGeometry does NOT normalize its UVs to 0-1 — it uses the
     shape's raw local coordinates directly as UV. For a ~20-unit-wide
     crater shape that means almost every UV falls miles outside [0,1] and
     gets clamped to the texture's transparent edge pixel, so the gradient
     fill never actually shows (only the EdgesGeometry rim, which doesn't
     depend on UVs, was visible). Remap UVs to the shape's own bounding box. */
  function remapShapeUVs(geo) {
    geo.computeBoundingBox();
    const bb = geo.boundingBox;
    const w = bb.max.x - bb.min.x || 1, h = bb.max.y - bb.min.y || 1;
    const pos = geo.attributes.position, uv = geo.attributes.uv;
    for (let i = 0; i < pos.count; i++) {
      uv.setXY(i, (pos.getX(i) - bb.min.x) / w, (pos.getY(i) - bb.min.y) / h);
    }
    uv.needsUpdate = true;
  }

  /* ────────────────── Street Geometry ──────────────────── */
  /* Avenue length: 7 projects (the biggest role, risk) alternating sides at
     10u spacing reach z=-70 (see buildRoleBillboards), so the street, its
     dressing and the world bounds all had to grow past the old 5-board/-42
     length to fit "todos los proyectos en la calle" without running out of
     road. */
  function buildStreet(THREE) {
    /* Asphalt */
    const asphalt = new THREE.Mesh(
      new THREE.PlaneGeometry(22, 100),
      new THREE.MeshBasicMaterial({ color: 0x10131a })
    );
    asphalt.rotation.x = -Math.PI / 2;
    asphalt.position.set(0, 0, -34);
    scene.add(asphalt);

    /* Sidewalks */
    const swMat = new THREE.MeshBasicMaterial({ color: 0x161a22 });
    [-11, 11].forEach(sx => {
      const sw = new THREE.Mesh(new THREE.PlaneGeometry(6, 100), swMat);
      sw.rotation.x = -Math.PI / 2;
      sw.position.set(sx, 0.01, -34);
      scene.add(sw);
    });

    /* Craters — gaps across the street before the 1st and 2nd billboard, so
       the player has to jump. A flat colored plane never reads as a hole in
       this unlit scene (no shading to sell depth), so the pit is a canvas
       radial gradient (dark center fading toward the rim) on an IRREGULAR
       jagged outline instead of a clean rectangle — both asked explicitly.
       Sits just above the asphalt (asphalt is one opaque plane at y=0, so
       anything below it is invisible — that was the original bug). */
    CRATER_ZS.forEach((cz, i) => {
      const shape = jaggedHoleShape(THREE, 20, CRATER_HALF_W * 2, 71 + i * 37);
      const geo = new THREE.ShapeGeometry(shape);
      remapShapeUVs(geo);
      /* No edge line, radioactive-green glow instead (asked explicitly) —
         animated water shader so it reads as liquid, not a flat green stain. */
      const mat = makeWaterMaterial(THREE);
      craterMaterials.push(mat);
      const pit = new THREE.Mesh(geo, mat);
      pit.rotation.x = -Math.PI / 2;
      pit.position.set(0, 0.012, cz);   /* above the sidewalk (0.01) — was under it, got clipped where they overlap in x */
      scene.add(pit);
    });

    /* Lane dashes — skip any that would overlap a crater (the dash sits at
       y=0.015, above the pit's y=0.008, and was drawing right across it). */
    const dashMat = new THREE.MeshBasicMaterial({ color: 0x232a38 });
    const DASH_HALF_LEN = 2.25;
    for (let dz = -4; dz > -82; dz -= 9) {
      const overlapsCrater = CRATER_ZS.some(cz =>
        Math.abs(dz - cz) < DASH_HALF_LEN + CRATER_HALF_W
      );
      if (overlapsCrater) continue;
      const dash = new THREE.Mesh(new THREE.PlaneGeometry(0.12, DASH_HALF_LEN * 2), dashMat);
      dash.rotation.x = -Math.PI / 2;
      dash.position.set(0, 0.015, dz);
      scene.add(dash);
    }

    /* Foreground frame buildings — close to camera, fill viewport side edges.
       Heights are multiples of CHAR_HEIGHT so they read as proportionally
       tall next to the character (roughly a 12- and 10-story building). */
    addBuilding(THREE, -9, 1, CHAR_HEIGHT * 12);
    addBuilding(THREE, 9, 1, CHAR_HEIGHT * 10);

    /* Buildings — alternating left/right, 6-12 stories tall relative to the character */
    const leftH  = [8, 11, 6, 9, 7, 10, 6, 9].map(n => n * CHAR_HEIGHT);
    const rightH = [9, 7, 12, 8, 10, 7, 11, 8].map(n => n * CHAR_HEIGHT);
    const bZs    = [-6, -15, -24, -33, -42, -51, -60, -69];
    bZs.forEach((bz, i) => {
      addBuilding(THREE, -14, bz, leftH[i]);
      addBuilding(THREE,  14, bz, rightH[i]);
    });

    /* A handful of parked cars, one at a time (not stacked — asked
       explicitly), sitting on the sidewalk-side empty slot: boards alternate
       sides at bx=±6.5 per walk-order index k (see buildRoleBillboards,
       side = k%2===0 ? -1 : 1), so at any given k only one side has a board
       — these sit on the OTHER side at a few of those k positions. */
    [1, 3, 5].forEach((k, i) => {
      const boardSide = k % 2 === 0 ? -1 : 1;
      const car = buildCar(THREE);
      const cx = -boardSide * 6.5, cz = -10 - k * 10 + (i - 1) * 1.5;
      car.position.set(cx, 0, cz);
      car.rotation.y = 1.5 + i * 0.4;
      scene.add(car);
      /* Simple collision shape — asked explicitly. A circle ignoring the
         car's rotation, not a true oriented box: cheap and good enough to
         stop the player walking through it (body is 4.3x1.8, so its
         bounding-circle radius is ~2.33). */
      carColliders.push({ x: cx, z: cz, r: 2.35 });
    });
  }

  function addBuilding(THREE, bx, bz, h) {
    /* Deterministic width so scene is stable across re-renders */
    const w = 5.5 + ((Math.abs(bx) * 7 + Math.abs(bz) * 13) % 3);
    const bGeo = new THREE.BoxGeometry(w, h, 3.5);
    const b = new THREE.Mesh(bGeo, new THREE.MeshBasicMaterial({ color: 0x12151c }));
    b.position.set(bx, h / 2, bz);
    scene.add(b);

    /* Edge lines */
    const edges = new THREE.LineSegments(
      new THREE.EdgesGeometry(bGeo),
      new THREE.LineBasicMaterial({ color: 0x2a3040 })
    );
    edges.position.set(bx, h / 2, bz);
    scene.add(edges);

    /* Lit windows — street-facing side, both sides of the avenue (addBuilding
       is called symmetrically for negative and positive bx already). Bumped
       from 0.5 to 0.88 opacity: at 0.5 the teal blended down toward the void
       background and read as flat/unlit rather than "lit". */
    const faceZ = bx < 0 ? bz + 1.75 : bz - 1.75;
    const rotY  = bx < 0 ? 0 : Math.PI;
    const wMat  = new THREE.MeshBasicMaterial({ color: 0x4d8f75, transparent: true, opacity: 0.88 });
    const cols  = Math.floor(w / 1.2);
    const rows  = Math.floor(h / 1.6);
    let seed = Math.abs(bx * 13 + bz * 7);
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        seed = (seed * 1103515245 + 12345) & 0x7fffffff;
        if (seed / 0x7fffffff < 0.6) {
          const win = new THREE.Mesh(new THREE.PlaneGeometry(0.55, 0.38), wMat);
          win.position.set(bx - w / 2 + 0.8 + c * 1.2, 0.8 + r * 1.6, faceZ + (bx < 0 ? 0.01 : -0.01));
          win.rotation.y = rotY;
          scene.add(win);
        }
      }
    }
  }

  /* ────────────────── City dressing ───────────────────── */
  /* Streetlamps, neon signs, skyline + stars — ambience only, all
     MeshBasic/additive (no real lights), placed clear of billboard slots. */
  function buildCityDressing(THREE) {
    /* Neon signs on inner building faces — canvas-textured, dim teal glow */
    const SIGNS = [
      { text: '7F·DATA',   x: -10.6, y: 9.5,  z: -6,  c: '#3d7a64' },
      { text: '◆ ACCESS',  x:  10.6, y: 11.2, z: -15, c: '#4d8f75' },
      { text: 'SECTOR-7',  x: -10.6, y: 7.8,  z: -24, c: '#3d7a64' },
      { text: 'PL-77',     x:  10.6, y: 13.4, z: -33, c: '#4d8f75' },
      { text: '▸ NODE',    x: -10.6, y: 10.6, z: -42, c: '#3d7a64' },
      { text: '::SYS',     x:  10.6, y: 8.4,  z: -24, c: '#4d8f75' },
    ];
    SIGNS.forEach(s => {
      const cv = document.createElement('canvas');
      cv.width = 256; cv.height = 64;
      const c = cv.getContext('2d');
      c.fillStyle = s.c;
      c.font = 'bold 34px "Share Tech Mono", monospace';
      c.textAlign = 'center';
      c.fillText(s.text, 128, 44);
      const sign = new THREE.Mesh(
        new THREE.PlaneGeometry(2.4, 0.6),
        new THREE.MeshBasicMaterial({
          map: new THREE.CanvasTexture(cv), transparent: true, opacity: 0.45,
          blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide,
        })
      );
      sign.position.set(s.x, s.y, s.z);
      sign.rotation.y = s.x < 0 ? Math.PI / 2 : -Math.PI / 2;
      scene.add(sign);
    });

    /* Distant skyline silhouette — canvas gradient plane behind the fog */
    const skyCv = document.createElement('canvas');
    skyCv.width = 1024; skyCv.height = 200;
    const sc = skyCv.getContext('2d');
    let sx = 0; let seed = 7;
    while (sx < 1024) {
      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
      const bw = 40 + (seed % 70);
      const bh = 60 + ((seed >> 8) % 120);
      sc.fillStyle = '#0f1218';
      sc.fillRect(sx, 200 - bh, bw, bh);
      /* sparse lit windows */
      sc.fillStyle = 'rgba(77,143,117,0.5)';
      for (let wy = 200 - bh + 8; wy < 190; wy += 16) {
        if (((seed >> (wy % 13)) & 3) === 0) sc.fillRect(sx + 6 + (wy % (bw - 14)), wy, 3, 4);
      }
      sx += bw + 6;
    }
    const skyline = new THREE.Mesh(
      new THREE.PlaneGeometry(95, 18),
      new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(skyCv), transparent: true, depthWrite: false })
    );
    skyline.position.set(0, 8.5, -96);
    scene.add(skyline);

    /* Stars — static points high above, subtle */
    const starCount = 180;
    const starPos = new Float32Array(starCount * 3);
    let sSeed = 31;
    for (let i = 0; i < starCount; i++) {
      sSeed = (sSeed * 1103515245 + 12345) & 0x7fffffff;
      starPos[i*3]   = ((sSeed % 1000) / 1000 - 0.5) * 90;
      starPos[i*3+1] = 15 + ((sSeed >> 10) % 1000) / 1000 * 20;
      starPos[i*3+2] = -12 - ((sSeed >> 20) % 1000) / 1000 * 92;
    }
    const starGeo = new THREE.BufferGeometry();
    starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
    scene.add(new THREE.Points(starGeo, new THREE.PointsMaterial({
      color: 0xa8c4d8, size: 0.045, transparent: true, opacity: 0.28, sizeAttenuation: true,
    })));

    /* Obelisco (Buenos Aires) — sized to the REAL monument's proportions,
       scaled off CHAR_HEIGHT ≈ 1.8m so 1 scene unit ≈ 1 meter: 67.5m tall,
       ~6.4m base tapering to ~4.2m near the shaft top, ~3m pyramidal cap.
       CylinderGeometry(r, r, h, 4) inscribes a square whose flat-face width
       is r·√2 (with the 45° yaw below turning the diamond into flat faces
       toward the avenue), hence the /Math.SQRT2 below. Placed past where any
       role's boards reach (deepest board z is -40, walk clamp is -46) and in
       front of the skyline backdrop at z=-58. Purely decorative, no hitbox.
       Pale cool gray (never pure white), MeshBasic like the rest of this
       ambience-only city dressing (no real lights besides the character's). */
    const obX = OBELISK_X, obZ = OBELISK_Z;
    const shaftH = 64, tipH = 3.5;
    const rBottom = 6.4 / Math.SQRT2, rTop = 4.2 / Math.SQRT2;
    const obMat = new THREE.MeshBasicMaterial({ color: 0x878d97 });   /* darker/less bright than the original 0xc7ccd6, still not pure black/white */
    const shaft = new THREE.Mesh(new THREE.CylinderGeometry(rTop, rBottom, shaftH, 4), obMat);
    shaft.position.set(obX, shaftH / 2, obZ);
    shaft.rotation.y = Math.PI / 4;   /* flat faces toward the avenue instead of an edge */
    scene.add(shaft);
    const tip = new THREE.Mesh(new THREE.ConeGeometry(rTop, tipH, 4), obMat);
    tip.position.set(obX, shaftH + tipH / 2, obZ);
    tip.rotation.y = Math.PI / 4;
    scene.add(tip);

    /* Two holes flanking the obelisk — enormous (asked explicitly): the
       avenue's world bounds (BOUND_X=8.8) put the obelisk WITHIN reach now
       (avenue got extended past it since these were first added), so a
       small decorative pit here left a walkable gap between the shaft and
       the clamp — reachable but with nothing visually stopping the player
       there. Sized to flank right up against the shaft (half-width ~4.53)
       and run past BOUND_X, so the edge of the world reads as "there's a
       pit", not an invisible wall. Same water shader as the street craters
       (these are "los pozos" too — asked to read as liquid, plural). */
    [-9, 9].forEach((hx, i) => {
      const holeShape = jaggedHoleShape(THREE, 10, 16, 131 + i * 53);
      const holeGeo = new THREE.ShapeGeometry(holeShape);
      remapShapeUVs(holeGeo);
      const mat = makeWaterMaterial(THREE);
      craterMaterials.push(mat);
      const hole = new THREE.Mesh(holeGeo, mat);
      hole.rotation.x = -Math.PI / 2;
      hole.position.set(obX + hx, 0.012, obZ);   /* above the sidewalk (0.01) — these got much wider and now reach into its footprint ("tapados por la vereda") */
      scene.add(hole);
    });

  }

  /* A basic low-poly car — body + cabin + 4 wheels, all box/cylinder
     primitives, MeshBasic to match the rest of this ambience-only dressing. */
  /* Real sedan proportions (~4.3m long, ~1.8m wide, ~1.5m roof), anchored to
     the same CHAR_HEIGHT≈1.8m/unit scale as everything else — the previous
     version was 1.8 units long (a person's HEIGHT, not a car's length),
     which read as a toy. */
  function buildCar(THREE) {
    const car = new THREE.Group();
    const bodyMat = new THREE.MeshBasicMaterial({ color: 0x2a3040 });
    const body = new THREE.Mesh(new THREE.BoxGeometry(4.3, 0.7, 1.8), bodyMat);
    body.position.set(0, 0.7, 0);
    car.add(body);
    const cabin = new THREE.Mesh(new THREE.BoxGeometry(2.1, 0.55, 1.55), bodyMat);
    cabin.position.set(-0.15, 1.225, 0);
    car.add(cabin);
    const wheelMat = new THREE.MeshBasicMaterial({ color: 0x111418 });
    const wheelR = 0.33;
    [[-1.5, -0.82], [-1.5, 0.82], [1.5, -0.82], [1.5, 0.82]].forEach(([wx, wz]) => {
      const wheel = new THREE.Mesh(new THREE.CylinderGeometry(wheelR, wheelR, 0.26, 12), wheelMat);
      wheel.rotation.z = Math.PI / 2;
      wheel.position.set(wx, wheelR, wz);
      car.add(wheel);
    });
    return car;
  }

  /* ────────────────── Particles ───────────────────────── */
  function buildParticles(THREE) {
    const count = 800;
    const positions = new Float32Array(count * 3);
    particleVelocities = new Float32Array(count * 3);
    for (let i = 0; i < count; i++) {
      positions[i*3]   = (Math.random() - 0.5) * 24;
      positions[i*3+1] = Math.random() * 14;
      positions[i*3+2] = Math.random() * -55 + 5;
      particleVelocities[i*3]   = (Math.random() - 0.5) * 0.003;
      particleVelocities[i*3+1] = (Math.random() - 0.5) * 0.002;
      particleVelocities[i*3+2] = (Math.random() - 0.5) * 0.003;
    }
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const mat = new THREE.PointsMaterial({
      color: 0x6b7280, size: 0.05, transparent: true, opacity: 0.3, sizeAttenuation: true
    });
    particles = new THREE.Points(geo, mat);
    scene.add(particles);
  }

  /* ── Gameplay FX — footstep dust, jump puffs, crater splash ──
     Small pool of THREE.Sprites (each needs its own opacity/scale timer,
     which a single THREE.Points draw call can't give per-particle) sharing
     one soft radial-gradient dot texture, tinted per spawn via .color. */
  function makeFxDotTexture(THREE) {
    const cv = document.createElement('canvas');
    cv.width = cv.height = 32;
    const ctx = cv.getContext('2d');
    const g = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
    g.addColorStop(0, 'rgba(255,255,255,0.9)');
    g.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, 32, 32);
    return new THREE.CanvasTexture(cv);
  }

  function spawnFx(THREE, x, y, z, color, opts = {}) {
    if (!fxDotTexture) fxDotTexture = makeFxDotTexture(THREE);
    let p = fxPool.find(e => !e.active);
    if (!p) {
      if (fxPool.length >= FX_POOL_MAX) return;
      const sprite = new THREE.Sprite(new THREE.SpriteMaterial({
        map: fxDotTexture, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,
      }));
      scene.add(sprite);
      p = { sprite };
      fxPool.push(p);
    }
    p.sprite.material.color.setHex(color);
    p.size = opts.size ?? 0.3;
    p.baseOpacity = opts.opacity ?? 0.85;
    p.sprite.scale.setScalar(p.size);
    p.sprite.position.set(x, y, z);
    p.vx = opts.vx ?? (Math.random() - 0.5) * 0.02;
    p.vy = opts.vy ?? 0.025;
    p.vz = opts.vz ?? (Math.random() - 0.5) * 0.02;
    p.grav = opts.grav ?? -0.0018;
    p.life = p.maxLife = opts.life ?? 0.45;
    p.active = true;
    p.sprite.visible = true;
  }

  function spawnFxBurst(THREE, x, y, z, color, count, opts = {}) {
    const spread = opts.spread ?? 0.03;
    for (let i = 0; i < count; i++) {
      const a = Math.random() * Math.PI * 2;
      const s = spread * (0.5 + Math.random() * 0.5);
      spawnFx(THREE, x, y, z, color, { ...opts, vx: Math.cos(a) * s, vz: Math.sin(a) * s });
    }
  }

  function updateFx(dtScale) {
    fxPool.forEach(p => {
      if (!p.active) return;
      p.life -= 0.016 * dtScale;
      if (p.life <= 0) { p.active = false; p.sprite.visible = false; return; }
      p.vy += p.grav * dtScale;
      p.sprite.position.x += p.vx * dtScale;
      p.sprite.position.y += p.vy * dtScale;
      p.sprite.position.z += p.vz * dtScale;
      const f = p.life / p.maxLife;
      p.sprite.material.opacity = f * p.baseOpacity;
      p.sprite.scale.setScalar(p.size * (0.6 + 0.4 * f));
    });
  }

  /* ── Simple sound cues ── asked explicitly for the loading dots, panel
     open, footsteps, and touching a crater. No audio assets — synthesized
     beeps via Web Audio (a couple lines, no files to source/license).
     AudioContext is created lazily on first beep(), always well after the
     WASD keydown that got the player there, so it's never blocked by the
     browser's autoplay-needs-a-gesture policy. */
  let audioCtx = null;
  function beep(freq, dur, type, vol) {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(vol, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
    osc.connect(gain).connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + dur);
  }


  /* ────────────────── Dynamic billboards — AVENUE ───────── */
  /* DEFINITIVE ARCHITECTURE: billboards are built ON role selection and
     destroyed on role change — N projects → N billboards, nothing else.
     AVENUE LAYOUT: boards spread along the street every ~10u alternating
     sides, angled toward the walking camera. Flagship (projIdx 0) is the
     LAST board — the finale of the walk. Boards start dark (dimmed color +
     dim edges) and power on via proximity in tick(). */

  function disposeRoleBillboards() {
    if (roleBillGroup) {
      scene.remove(roleBillGroup);
      roleBillGroup.traverse(o => {
        if (o.geometry) o.geometry.dispose();
        if (o.material) {
          if (o.material.map) o.material.map.dispose();
          o.material.dispose();
        }
      });
      roleBillGroup = null;
    }
    roleBillRefs = [];
    zoneMeshes = [];
  }

  function buildRoleBillboards(THREE, role) {
    disposeRoleBillboards();
    const projects = zoneProjects[role] ?? [];
    if (!projects.length) return;

    roleBillGroup = new THREE.Group();

    /* Walk order: non-flagship projects first, flagship (projIdx 0) closes */
    const order = projects.map((_, i) => i).slice(1).concat([0]);

    order.forEach((projIdx, k) => {
      const proj   = projects[projIdx];
      const isHero = projIdx === 0;
      const side   = k % 2 === 0 ? -1 : 1;           /* alternating: left, right, left… — asked explicitly, one project per hand */
      const bx     = side * 6.5;
      const bz     = -10 - k * 10;
      const rotY   = 0;                             /* re-oriented toward the camera every frame in tick() — see boardFaceCamera */
      const w   = isHero ? 6.0 : 4.2;
      const h   = isHero ? 4.0 : 2.8;
      const cvW = isHero ? 768 : 576;
      const cvH = isHero ? 512 : 384;
      const boardY = isHero ? 5.2 : 4.5;
      /* Flagship board is marked in amber (Deus Ex) — regular boards teal */
      const borderColor = isHero ? FLAG : 0x3d7a64;
      /* ponytail: no pole, ever — the board floats free of any support post (asked explicitly) */

      /* Frame backing */
      const frameGeo = new THREE.BoxGeometry(w + 0.18, h + 0.1, 0.1);
      const frame = new THREE.Mesh(frameGeo, new THREE.MeshBasicMaterial({ color: 0x111418 }));
      frame.position.set(bx, boardY, bz);
      frame.rotation.y = rotY;
      roleBillGroup.add(frame);

      /* Frame edges — dim until the board powers on */
      const edgeLines = new THREE.LineSegments(
        new THREE.EdgesGeometry(frameGeo),
        new THREE.LineBasicMaterial({ color: 0x2a3040 })
      );
      edgeLines.position.copy(frame.position);
      edgeLines.rotation.copy(frame.rotation);
      roleBillGroup.add(edgeLines);

      /* Canvas texture — fresh canvas + texture per build (never mutated) */
      const bbCv = document.createElement('canvas');
      bbCv.width = cvW; bbCv.height = cvH;
      drawBillboardCanvas(bbCv.getContext('2d'), cvW, cvH, proj, role, isHero);
      const tex = new THREE.CanvasTexture(bbCv);

      /* Board starts DARK (color multiplier) — proximity power-on brightens it */
      const bill = new THREE.Mesh(
        new THREE.PlaneGeometry(w, h),
        new THREE.MeshBasicMaterial({ map: tex, color: 0x30343d })
      );
      bill.position.set(bx, boardY, bz);
      bill.rotation.y = rotY;
      bill.translateZ(0.06);   /* offset along facing direction so it sits on the frame */
      roleBillGroup.add(bill);

      /* TWO circles, asked explicitly, not one: a small visible marker under
         the board (this one) that stays small, and a big INVISIBLE sensor
         zone (PROXIMITY_R2, 8u radius, checked in tick() — never rendered
         as geometry) that triggers it. The small marker doesn't need to
         match the sensor's size or position — it's a fixed decoration at
         the board's own (bx,bz) that only changes STATE based on whether
         the player is inside that far-larger invisible zone. Two states,
         always visible (asked explicitly — dim from outside, not
         invisible): DIM (default, "unlit edge" 0x2a3040 tone used
         everywhere in this scene) — visible before you're in range, just
         not glowing. FILLED (bright, sweeps in one tick at a time while
         inside range) — the loading-spinner fill; the board's own
         light/color change fires the moment you first enter range. */
      const spinnerTicks = [];
      for (let s = 0; s < SPINNER_TICKS; s++) {
        const ang = (s / SPINNER_TICKS) * Math.PI * 2;
        const tick = new THREE.Mesh(
          new THREE.PlaneGeometry(0.1, 0.28),
          new THREE.MeshBasicMaterial({
            color: 0x2a3040, transparent: true, opacity: 0.4,
            blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide,
          })
        );
        tick.rotation.x = -Math.PI / 2;
        tick.rotation.z = -ang;
        tick.position.set(bx + Math.sin(ang) * SPINNER_R, 0.025, bz + Math.cos(ang) * SPINNER_R);
        roleBillGroup.add(tick);
        spinnerTicks.push(tick);
      }

      /* Transparent hitbox (never use visible:false — raycaster skips invisible) */
      const hit = new THREE.Mesh(
        new THREE.PlaneGeometry(w, h),
        new THREE.MeshBasicMaterial({ transparent: true, opacity: 0, depthWrite: false })
      );
      hit.position.copy(bill.position);
      hit.rotation.y = rotY;
      hit.translateZ(0.02);
      hit.userData = { zone: role, projIdx };
      roleBillGroup.add(hit);
      zoneMeshes.push({ mesh: hit, key: role, projIdx });

      roleBillRefs.push({ mesh: bill, frame, edges: edgeLines, hit, spinnerTicks, fillT: 0, opened: false, inBigCircle: false, borderColor, isHero, projIdx, bx, bz, lit: false });
    });

    /* Warm amber glow light at the flagship — the finale (G7) */
    const last = roleBillRefs[roleBillRefs.length - 1];
    const light = new THREE.PointLight(FLAG_BRIGHT, 3.0, 18);
    light.position.set(last.bx, 5.0, last.bz);
    light.userData = { zone: role };
    roleBillGroup.add(light);

    scene.add(roleBillGroup);
  }

  /* Draws a billboard canvas texture for one project.
     The flagship (isHero) is marked in amber — Deus Ex treatment (G7). */
  function drawBillboardCanvas(ctx, W, H, proj, key, isHero) {
    const MINT  = '#5ee7aa';
    const TEAL  = '#3d7a64';
    const AMBER = '#c9a94f';
    const BAR   = isHero ? AMBER : TEAL;
    const MAIN  = '#E8E4D0';
    const SUB   = '#a0a8b8';
    const DIM   = '#6b7280';

    ctx.fillStyle = '#111418';
    ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = BAR;
    ctx.fillRect(0, 0, 4, H);

    /* Billboards only exist for real projects now (dynamic architecture) —
       this guard is defensive only */
    if (!proj) return;

    /* Sizes tuned to FILL the canvas height — content was top-heavy before */
    const TS = isHero ? 30 : 24;   /* title font size */
    const DS = isHero ? 17 : 14;   /* desc font size  */
    const MS = isHero ? 13 : 11;   /* meta font size  */
    const PAD = 18;

    /* Header: role label */
    ctx.fillStyle = DIM;
    ctx.font = `${MS}px "Share Tech Mono", monospace`;
    ctx.textAlign = 'left';
    ctx.fillText('SYSTEM::PROJECT · ' + (zoneLabels[key] ?? key).toUpperCase(), PAD, isHero ? 30 : 26);

    /* Status badge (top-right) */
    const STATUS_COLORS = { FLAGSHIP: AMBER, ACTIVE: MINT, DEPLOYED: '#8fa882', BUILT: DIM, TOOLING: DIM };
    const badgeColor = STATUS_COLORS[proj.status] ?? DIM;
    ctx.font = `${MS}px "Share Tech Mono", monospace`;
    const bw = ctx.measureText(proj.status).width + 18;
    ctx.strokeStyle = badgeColor;
    ctx.lineWidth = 1.5;
    ctx.strokeRect(W - PAD - bw, isHero ? 13 : 11, bw, isHero ? 22 : 19);
    ctx.fillStyle = badgeColor;
    ctx.fillText(proj.status, W - PAD - bw + 9, isHero ? 29 : 25);

    /* Thin separator */
    ctx.strokeStyle = BAR;
    ctx.lineWidth = 0.75;
    ctx.globalAlpha = 0.3;
    ctx.beginPath();
    const sepY = isHero ? 46 : 38;
    ctx.moveTo(PAD, sepY); ctx.lineTo(W - PAD, sepY);
    ctx.stroke();
    ctx.globalAlpha = 1;

    /* Project title (wrapped) */
    ctx.fillStyle = MAIN;
    ctx.font = `bold ${TS}px "Share Tech Mono", monospace`;
    bbWrapText(ctx, proj.name, PAD, isHero ? 88 : 72, W - PAD * 2, TS * 1.3);

    /* Description */
    const descMaxLines = isHero ? 4 : 3;
    const descStartY   = isHero ? 186 : 148;
    ctx.fillStyle = SUB;
    ctx.font = `${DS}px "Share Tech Mono", monospace`;
    const descWords = proj.desc.split(' ');
    let dLine = ''; let dY = descStartY; let dCount = 0;
    for (const w of descWords) {
      const test = dLine + w + ' ';
      if (ctx.measureText(test).width > W - PAD * 2 && dLine) {
        ctx.fillText(dLine.trim(), PAD, dY);
        dY += DS * 1.55;
        dLine = w + ' ';
        dCount++;
        if (dCount >= descMaxLines) { ctx.fillText(dLine.trim() + '…', PAD, dY); dLine = ''; break; }
      } else { dLine = test; }
    }
    if (dLine) ctx.fillText(dLine.trim(), PAD, dY);

    /* Outcome metric — anchored toward the bottom, above the CTA.
       Truncated at word boundaries with an ellipsis (never mid-word). */
    if (proj.outcome) {
      const outY = H - (isHero ? 118 : 96);
      ctx.fillStyle = BAR;
      ctx.font = `${DS}px "Share Tech Mono", monospace`;
      ctx.fillText(bbTruncate(ctx, '◆ ' + proj.outcome, W - PAD * 2), PAD, outY);
    }

    /* CTA button (filled rect) */
    const ctaBtnW = isHero ? 180 : 148;
    const ctaBtnH = isHero ? 40 : 34;
    const ctaY    = H - (isHero ? 66 : 54);
    ctx.fillStyle = BAR;
    ctx.fillRect(PAD, ctaY, ctaBtnW, ctaBtnH);
    ctx.fillStyle = '#0d0f14';
    ctx.font = `bold ${isHero ? 16 : 13}px "Share Tech Mono", monospace`;
    ctx.textAlign = 'center';
    ctx.fillText('[ OPEN ↗ ]', PAD + ctaBtnW / 2, ctaY + ctaBtnH * 0.66);
    ctx.textAlign = 'left';
  }

  /* CRT power-on flicker — modulates material.color (never opacity: keeping
     the material opaque avoids transparent render-order issues) */
  function flickerOn(material) {
    if (reduced) { material.color.setHex(0xffffff); return; }
    const seq = [[0, 0x222222], [70, 0xffffff], [140, 0x333333], [220, 0xffffff], [300, 0x555555], [400, 0xffffff]];
    seq.forEach(([ms, hex]) => setTimeout(() => material.color.setHex(hex), ms));
  }

  /* Truncate at word boundaries with '…' if the text exceeds maxW */
  function bbTruncate(ctx, text, maxW) {
    if (ctx.measureText(text).width <= maxW) return text;
    const words = text.split(' ');
    let out = '';
    for (const w of words) {
      const test = out ? out + ' ' + w : w;
      if (ctx.measureText(test + ' …').width > maxW) break;
      out = test;
    }
    return (out || text.slice(0, 10)) + ' …';
  }

  function bbWrapText(ctx, text, x, y, maxW, lineH) {
    const words = text.split(' ');
    let line = '';
    for (const word of words) {
      const test = line + word + ' ';
      if (ctx.measureText(test).width > maxW && line) {
        ctx.fillText(line.trim(), x, y);
        y += lineH;
        line = word + ' ';
      } else {
        line = test;
      }
    }
    ctx.fillText(line.trim(), x, y);
  }

  /* ────────────────── HDRI Environment ────────────────── */
  async function loadHDRI(THREE) {
    try {
      const { RGBELoader } = await import('three/addons/loaders/RGBELoader.js');
      new RGBELoader().load('/hdri/cobblestone_street_night_1k.hdr', (texture) => {
        const pmrem = new THREE.PMREMGenerator(renderer);
        pmrem.compileEquirectangularShader();
        scene.environment = pmrem.fromEquirectangular(texture).texture;
        texture.dispose();
        pmrem.dispose();
      });
    } catch (_) { /* HDRI is visual enhancement only — scene works without it */ }
  }

  /* ────────────────── Character Placeholder ────────────── */
  function buildCharPlaceholder(THREE) {
    charGroup = new THREE.Group();
    const body = new THREE.Mesh(
      new THREE.CapsuleGeometry(0.22, 0.85, 6, 10),
      new THREE.MeshBasicMaterial({ color: 0x3a5a48 })
    );
    body.position.y = 0.73;
    const head = new THREE.Mesh(
      new THREE.SphereGeometry(0.18, 10, 10),
      new THREE.MeshBasicMaterial({ color: 0xe8e4d0 })
    );
    head.position.y = 1.64;
    const visor = new THREE.Mesh(
      new THREE.BoxGeometry(0.36, 0.07, 0.2),
      new THREE.MeshBasicMaterial({ color: 0x0a0c0a })
    );
    visor.position.set(0, 1.64, 0.12);
    const eye = new THREE.Mesh(
      new THREE.BoxGeometry(0.28, 0.025, 0.01),
      new THREE.MeshBasicMaterial({ color: 0x5ee7aa })
    );
    eye.position.set(0, 1.638, 0.22);
    charGroup.add(body, head, visor, eye);
    charGroup.position.set(charX, 0, charZ);
    charGroup.rotation.y = targetRotY;   /* spawn facing into the avenue, not the camera */
    scene.add(charGroup);
  }

  /* ────────────────── Click / Hover ───────────────────── */
  const raycaster = { r: null };
  function getZoneHit(THREE, e) {
    const canvas = document.getElementById('ps-canvas');
    const rect = canvas.getBoundingClientRect();
    if (!raycaster.r) raycaster.r = new THREE.Raycaster();
    const mouse = new THREE.Vector2(
      ((e.clientX - rect.left) / rect.width)  * 2 - 1,
      -((e.clientY - rect.top)  / rect.height) * 2 + 1
    );
    raycaster.r.setFromCamera(mouse, camera);
    const hits = raycaster.r.intersectObjects(zoneMeshes.map(z => z.mesh));
    if (!hits.length) return null;
    const found = zoneMeshes.find(z => z.mesh === hits[0].object);
    return found ? { key: found.key, projIdx: found.projIdx } : null;
  }

  function onCanvasClick(THREE, e) {
    /* Billboard hit */
    const hit = getZoneHit(THREE, e);
    if (hit) {
      showPanel(hit.key, hit.projIdx);
      return;
    }
    /* No hay click-to-move: el personaje se mueve SÓLO con WASD.
       El click sobre la escena selecciona un registro, nunca desplaza. */
  }

  function onHover(THREE, e) {
    const hit = getZoneHit(THREE, e);
    document.getElementById('ps-canvas').style.cursor = hit ? 'pointer' : 'default';
    /* Hover glow — hovered billboard's frame edges flash bright (amber for the
       flagship, mint otherwise); others restore to their state color */
    roleBillRefs.forEach(ref => {
      const hovered = hit && ref.projIdx === hit.projIdx;
      ref.edges.material.color.setHex(
        hovered ? (ref.isHero ? FLAG_BRIGHT : 0x5ee7aa)
                : (ref.lit ? ref.borderColor : 0x2a3040)
      );
    });
  }

  /* ────────────────── Navigation ──────────────────────── */
  /* Dead-center (x=0), not offset toward the first board's side — boards
     alternate sides, and starting biased toward one side put the OTHER
     side's boards too far away (laterally) for the 8u activation circle to
     ever reach, so half the boards never lit up. Shared by navigateTo (role
     select) and respawnAtEntrance (falling into a crater while running). */
  function resetToEntrance() {
    const first = roleBillRefs[0];
    charX = 0;
    charZ = first ? first.bz + 10 : -8;   /* 2m further back than before, asked explicitly */
    targetX = charX; targetZ = charZ;
    if (charGroup) charGroup.position.set(charX, 0, charZ);
  }

  function respawnAtEntrance() {
    resetToEntrance();
    jumping = false; jumpT = 0;
    shakeT = SHAKE_DUR;   /* camera shake on death, asked explicitly */
  }

  /* Cambio de acción SIN pasar por la bind pose.
     AnimationMixer lleva un useCount por hueso y, cuando la última acción que
     lo usaba se detiene y ese contador llega a 0, RESTAURA el valor original
     —la bind pose— en el acto. Parar la saliente antes de arrancar la
     entrante hacía justo eso, y como `play()` sólo marca la acción activa (la
     pose recién se escribe en el próximo `mixer.update`), quedaba un frame
     entero dibujado en bind pose. En el GLB viejo eso no se veía porque su
     reposo era una pose de caminata horneada; el GLB rehorneado tiene la bind
     pose de verdad, que es una T-POSE, y el defecto se volvió visible al
     pasar de respirar a correr.
     Arrancando la entrante PRIMERO el contador nunca toca 0: en el frame del
     cambio se sigue viendo la pose anterior, que es una pose real. */
  function switchAction(next, timeScale, time) {
    if (next) {
      next.reset();
      next.setEffectiveWeight(1);
      next.setEffectiveTimeScale(timeScale);
      next.play();                                  /* activar ANTES de parar */
      if (time !== undefined) next.time = time;
    }
    for (const a of [idleAction, walkAction, runAction]) {
      if (a && a !== next) a.stop();
    }
    moveAction = next;
  }

  /* Entrar en idle: se reproduce el clip de respiración. Si el GLB llegara
     sin él (o vacío, como estuvo un tiempo) se cae al plan viejo — un frame
     congelado de Walking, quieto pero no deformado. */
  function startIdlePose() {
    if (idleAction) switchAction(idleAction, 1);
    else switchAction(walkAction, 0, WALK_NEUTRAL_TIME);
  }

  /* Teleport straight to a project's board — a deliberate, narrow exception
     to "no pointer-driven movement" scoped only to selecting a project
     (billboard click, panel nav, or the projects drawer), not general
     click-to-move on empty ground. Stands at the exact center of that
     board's activation circle (its own bx/bz), facing further into the
     avenue toward it, so it reads as active immediately. Pulled out of
     showPanel so a selection can teleport WITHOUT opening the sidebar. */
  /* Right drawer's project list — click a row → teleport to that board (no
     sidebar per SIDEBAR_ENABLED). Global styles for these JS-injected rows
     live in the <style is:global> block, anchored to #ps-projects-drawer
     (lesson 22: component-scoped styles never match runtime-created DOM). */
  function populateProjectsDrawer(zone) {
    const list = document.getElementById('pd-list');
    if (!list) return;
    list.innerHTML = '';
    const projects = zoneProjects[zone] ?? [];
    /* Same order the boards actually sit in along the street (roleBillRefs
       is built in WALK order — flagship/projIdx 0 goes last — not the raw
       data-array order), asked explicitly. Must run after
       buildRoleBillboards populates roleBillRefs (it does, see the
       nier:zone handler above). */
    roleBillRefs.forEach((ref) => {
      const p = projects[ref.projIdx];
      if (!p) return;
      const row = document.createElement('button');
      row.type = 'button';
      row.className = 'pd-row';
      row.innerHTML = `<span class="pd-info"><span class="pd-name">${p.name}</span><span class="pd-desc">${p.desc}</span></span>`;
      row.addEventListener('click', (e) => {
        teleportToBoard(ref.projIdx);
        document.getElementById('ps-projects-drawer').classList.remove('open');
        document.getElementById('ps-projects-tab').setAttribute('aria-expanded', 'false');
        e.currentTarget.blur();   /* a focused row would silently re-click (re-teleport) on the next Space/jump */
      });
      list.appendChild(row);
    });
  }

  function panelSideFor(projIdx) {
    const ref = roleBillRefs.find(r => r.projIdx === projIdx);
    return (ref && ref.bx > 0) ? 'left' : 'right';
  }

  /* ponytail: `.ps-panel`'s transform is translateX(±100%) — relative to
     its OWN box, not the viewport — while `left`/`right` (the anchor edge)
     just snap instantly on class change (not transitioned). Swapping sides
     while `transform`'s transition is still active carries the OLD side's
     numeric offset over onto the NEW anchor edge, which visually drags the
     panel across the screen instead of sliding in from its own edge (bug
     reported explicitly: "se ve el movimiento que pasa de la izquierda a la
     derecha"). Fix: when the side actually changes, kill the transition for
     one frame, snap straight to the new side's closed position, flush it
     with a reflow, then restore the transition so `open` animates in fresh
     from the correct edge. */
  function setPanelSide(wantLeft) {
    const panel = document.getElementById('ps-panel');
    if (panel.classList.contains('left') === wantLeft) return;
    panel.style.transition = 'none';
    panel.classList.remove('open');
    panel.classList.toggle('left', wantLeft);
    void panel.offsetWidth;
    panel.style.transition = '';
  }

  function teleportToBoard(projIdx) {
    const ref = roleBillRefs.find(r => r.projIdx === projIdx);
    if (!ref) return;
    charX = ref.bx;
    charZ = ref.bz;
    targetX = charX; targetZ = charZ;
    targetRotY = Math.PI;
    if (charGroup) charGroup.position.set(charX, 0, charZ);
    /* Camera shake on every teleport to a ring's center — asked explicitly
       ("cada vez que se te transporta al centro de un anillo"). Every
       teleport path (billboard click, drawer row, the ring-fill opening the
       sidebar) funnels through this one function, so one shakeT here covers
       all of them. Reuses the same decaying timer as the death shake. */
    shakeT = SHAKE_DUR;
  }

  function navigateTo(zone) {
    activeZone = zone;
    /* Teleport straight to the avenue entrance instead of auto-walking there —
       the character must never move on its own, only via WASD (or selecting
       a project, which is its own explicit teleport-on-select exception). */
    resetToEntrance();
    hidePanel();
  }


  /* ────────────────── Minimap 2.0 (G4) ────────────────── */
  /* World→map: x ∈ [-10,10] → px ∈ [15,125] · z ∈ [6,-90] → py ∈ [12,178].
     Heading arrow, click = fast-travel, pulse on next objective, corner-cut frame.
     ponytail: z-range was still [6,-56] from before the avenue grew to fit
     every project + the obelisk (BOUND_Z_MIN=-87) — anything past z=-56
     computed a negative py and drew off the top edge of the canvas ("el
     minimapa quedo cortado"). Extended to -90, past BOUND_Z_MIN. */
  /* mz maps world z so that walking FORWARD (into the avenue, z decreasing)
     moves the marker UP the minimap (py decreasing) — the intuitive
     top-down-minimap convention. It was previously inverted: forward
     progress moved the marker down, which read as "backwards"/upside-down. */
  const MM = {
    W: 140, H: 190,
    mx: (x) => 15 + ((x + 10) / 20) * 110,
    mz: (z) => 12 + ((z + 90) / 96) * 166,
    invX: (px) => ((px - 15) / 110) * 20 - 10,
    invZ: (py) => ((py - 12) / 166) * 96 - 90,
  };

  function drawMinimap() {
    const ctx = minimapCtx;
    const { W, H, mx, mz } = MM;
    ctx.clearRect(0, 0, W, H);
    /* corner-cut frame (top-right), drawn in-canvas */
    const CUT = 12;
    ctx.beginPath();
    ctx.moveTo(0.5, 0.5);
    ctx.lineTo(W - CUT, 0.5);
    ctx.lineTo(W - 0.5, CUT);
    ctx.lineTo(W - 0.5, H - 0.5);
    ctx.lineTo(0.5, H - 0.5);
    ctx.closePath();
    ctx.fillStyle = 'rgba(13,15,20,0.66)';   /* 30% more transparent, asked explicitly (was 0.94) */
    ctx.fill();
    ctx.strokeStyle = '#2a3040';
    ctx.stroke();
    /* street — ponytail: this stopped at z=-54 from before the avenue grew
       to fit every project + the obelisk (BOUND_Z_MIN=-87); boards/obelisk
       past that point drew floating past where the visible street ended
       ("el minimapa quedo cortado", still broken after the mz() range fix
       alone). Extended to -88, just past the world's own Z bound. */
    ctx.strokeStyle = '#1c2030';
    ctx.lineWidth = 10;
    ctx.beginPath();
    ctx.moveTo(mx(0), mz(6));
    ctx.lineTo(mx(0), mz(-88));
    ctx.stroke();
    ctx.lineWidth = 1;
    /* header */
    ctx.fillStyle = '#6b7280';
    ctx.font = '7px "Share Tech Mono", monospace';
    ctx.textAlign = 'left';
    ctx.fillText('MAP::SECTOR-7', 6, 10);
    /* next objective pulse — expanding square around the first unlit board */
    const nxt = roleBillRefs.find(r => !r.lit);
    if (nxt) {
      const pr = 5 + ((t * 14) % 8);
      ctx.strokeStyle = '#5ee7aa';
      ctx.globalAlpha = Math.max(0, 0.7 - ((t * 14) % 8) / 11);
      ctx.strokeRect(mx(nxt.bx) - pr, mz(nxt.bz) - pr, pr * 2, pr * 2);
      ctx.globalAlpha = 1;
    }
    /* billboard markers — lit solid (amber for flagship), unlit hollow */
    roleBillRefs.forEach(ref => {
      const px = mx(ref.bx), py = mz(ref.bz);
      if (ref.lit) {
        ctx.fillStyle = ref.isHero ? '#c9a94f' : '#5ee7aa';
        ctx.fillRect(px - 2.5, py - 2.5, 5, 5);
      } else {
        ctx.strokeStyle = ref.isHero ? '#9a7b2d' : '#3d7a64';
        ctx.strokeRect(px - 2.5, py - 2.5, 5, 5);
      }
    });
    /* Obelisk marker — asked explicitly ("que se vea el obelisco también"),
       a small triangle (echoes the monument's own silhouette) so it reads
       as distinct from the square board markers. */
    const obPx = mx(OBELISK_X), obPy = mz(OBELISK_Z);
    ctx.fillStyle = '#878d97';
    ctx.beginPath();
    ctx.moveTo(obPx, obPy - 4);
    ctx.lineTo(obPx + 2.8, obPy + 3);
    ctx.lineTo(obPx - 2.8, obPy + 3);
    ctx.closePath();
    ctx.fill();

    /* character — heading arrow, not a dot */
    const cx = mx(charX), cy = mz(charZ);
    const ang = charGroup ? Math.PI - charGroup.rotation.y : 0;
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(ang);
    ctx.fillStyle = '#5ee7aa';
    ctx.beginPath();
    ctx.moveTo(0, -4.4);
    ctx.lineTo(3.2, 3.4);
    ctx.lineTo(0, 1.6);
    ctx.lineTo(-3.2, 3.4);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  /* ────────────────── Panel ───────────────────────────── */
  /* Scramble-settle text reveal (NieR style). Cancel-safe: re-entering on the
     same element clears the previous interval, so concurrent calls never
     interleave characters (the old typeOut bug). */
  const SCRAMBLE_CHARS = '◆◇▸▪░▒▓XZQV0123456789';
  function scrambleIn(el, text) {
    if (el._scrambleTimer) { clearInterval(el._scrambleTimer); el._scrambleTimer = null; }
    if (reduced || !text) { el.textContent = text; return; }
    const DURATION = 480, STEP = 40;
    const totalSteps = Math.ceil(DURATION / STEP);
    let step = 0;
    el._scrambleTimer = setInterval(() => {
      step++;
      const settled = Math.floor((step / totalSteps) * text.length);
      if (settled >= text.length) {
        el.textContent = text;
        clearInterval(el._scrambleTimer);
        el._scrambleTimer = null;
        return;
      }
      let out = text.slice(0, settled);
      for (let i = settled; i < text.length; i++) {
        out += text[i] === ' ' ? ' ' : SCRAMBLE_CHARS[(Math.random() * SCRAMBLE_CHARS.length) | 0];
      }
      el.textContent = out;
    }, STEP);
  }

  /* DOSSIER panel — one project as a structured record: counter, big title,
     MISSION section, highlighted metric box, large CTAs, and the remaining
     projects as numbered navigable rows (click → walk to that board). */
  function showPanel(zone, projIdx = 0) {
    /* ponytail: sidebar disabled for now, asked explicitly ("que nada abra
       el sidebar por ahora") — still teleport (selecting a project should
       still move the character), just skip populating/opening the panel UI.
       Flip SIDEBAR_ENABLED back to true to restore it, nothing else to undo. */
    if (!SIDEBAR_ENABLED) { teleportToBoard(projIdx); return; }
    const projects = zoneProjects[zone];
    document.getElementById('panel-all').href = allUrl[zone];

    const cards = document.getElementById('panel-cards');
    cards.innerHTML = '';

    if (!projects || !projects.length) {
      scrambleIn(document.getElementById('panel-title'), zoneLabels[zone]);
      cards.innerHTML = '<p class="panel-empty sys-text">[ RECORDS INCOMING ]</p>';
      setPanelSide(panelSideFor(projIdx) === 'left');
      document.getElementById('ps-panel').classList.add('open');
      beep(340, 0.15, 'sine', 0.07);
      return;
    }

    const heroIdx = (projIdx !== null && projIdx !== undefined && projIdx < projects.length) ? projIdx : 0;
    const hero = projects[heroIdx];

    setPanelSide(panelSideFor(heroIdx) === 'left');
    teleportToBoard(heroIdx);

    /* ponytail: simplified panel, asked explicitly — just what the project
       IS (name, one-line mission, headline metric, links). Dropped: the
       discovery-progress block row, stack chips, PREV/NEXT nav and the
       "other records" list — the projects drawer already covers jumping to
       a different project, this panel doesn't need to duplicate that. */
    scrambleIn(document.getElementById('panel-title'), hero.name);

    const body = document.createElement('div');
    body.className = 'dossier-body';
    body.innerHTML = `
      ${heroIdx === projects.length - 1 ? `<div class="d-wip">${dossier.wip}</div>` : ''}
      <div class="d-section">
        <div class="d-label">${dossier.mission}</div>
        <p class="d-desc">${hero.desc}</p>
      </div>
      ${hero.outcome ? `<div class="d-metric${hero.featured ? ' d-metric-flag' : ''}">◆ ${hero.outcome}</div>` : ''}
      <div class="d-ctas">
        <a class="d-cta d-cta-primary" href="${hero.github}" target="_blank" rel="noopener">[ ${dossier.code} ]</a>
        ${hero.demo ? `<a class="d-cta d-cta-ghost" href="${hero.demo}" target="_blank" rel="noopener">[ ${dossier.live} ]</a>` : ''}
      </div>
    `;
    cards.appendChild(body);

    body.style.opacity = '0';
    body.style.transition = 'opacity 0.25s ease';
    setTimeout(() => { body.style.opacity = '1'; }, 60);

    document.getElementById('ps-panel').classList.add('open');
    beep(340, 0.15, 'sine', 0.07);
  }

  function hidePanel() {
    document.getElementById('ps-panel').classList.remove('open');
    beep(220, 0.12, 'sine', 0.06);   /* close cue, asked explicitly — lower than the 340Hz open tone */
    /* Reset whichever board's ring is currently marked opened, so closing
       the panel from outside the small-circle tick loop (e.g. the PROJECTS
       button below) doesn't leave that ring stuck "already opened" — it
       needs to be able to re-fire if the player walks back into it. */
    const openRef = roleBillRefs.find(r => r.opened);
    if (openRef) openRef.opened = false;
  }

  /* ────────────────── Fallback ────────────────────────── */
  function showFallback() {
    document.getElementById('ps-fallback').classList.remove('hidden');
    document.getElementById('ps-canvas').style.display = 'none';
    document.getElementById('ps-hud').style.display    = 'none';
  }

  /* ────────────────── Render Loop ─────────────────────── */
  function tick(THREE) {
    requestAnimationFrame(() => tick(THREE));
    /* The jump arc is advanced further down in this same function, so bailing
       out mid-air used to latch `jumping` forever: locoState stuck on 'jump'
       and idle never came back after tabbing away or scrolling the canvas out
       of view. Cancelling here covers both sources of `visible`
       (visibilitychange and the IntersectionObserver) at the one point they
       both route through. */
    if (!visible || !renderer) { jumping = false; jumpT = 0; return; }
    t += 0.016;

    /* Character movement — WASD takes priority over click-to-walk.
       Default is running; holding Shift slows it down to a walk (asked
       explicitly — inverted from the original walk-default/Shift-to-run). */
    const wsadX = (keys['KeyD'] || keys['ArrowRight'] ? 1 : 0) - (keys['KeyA'] || keys['ArrowLeft'] ? 1 : 0);
    const wsadZ = (keys['KeyS'] || keys['ArrowDown']  ? 1 : 0) - (keys['KeyW'] || keys['ArrowUp']   ? 1 : 0);
    const wsadOn = wsadX !== 0 || wsadZ !== 0;
    const sprinting = wsadOn && !keys.Shift;

    /* ponytail: root-cause fix for "walks slower than before" — charX/charZ
       used to advance by a FIXED amount per tick(), so real-world speed was
       silently tied to frame rate (a busier scene = fewer frames/sec = slower
       walk). dtScale normalizes every per-tick displacement to a 60fps
       baseline so speed stays constant regardless of frame rate. */
    const delta = animClock ? Math.min(animClock.getDelta(), 0.05) : 0;
    const dtScale = delta > 0 ? delta * 60 : 1;

    let nowMoving = false;

    if (wsadOn) {
      const len = Math.sqrt(wsadX * wsadX + wsadZ * wsadZ);
      const speed = WALK_SPEED * (sprinting ? SPRINT_MULT : 1) * (jumping ? JUMP_SPEED_MULT : 1) * dtScale;
      charX += (wsadX / len) * speed;
      charZ += (wsadZ / len) * speed;
      targetRotY = Math.atan2(wsadX, wsadZ);
      targetX = charX; targetZ = charZ;  /* cancel any pending click-target */
      nowMoving = true;
    } else {
      const dx = targetX - charX;
      const dz = targetZ - charZ;
      const dist2 = dx * dx + dz * dz;
      if (dist2 > 0.003) {
        const lerpF = reduced ? 1 : Math.min(1, 0.035 * dtScale);
        charX += dx * lerpF;
        charZ += dz * lerpF;
        if (dist2 > 0.01) targetRotY = Math.atan2(dx, dz);
        nowMoving = true;
      } else {
        nowMoving = false;
      }
    }
    charX = clampX(charX); charZ = clampZ(charZ);

    /* Car collision — simple circle push-out, asked explicitly ("colission
       shapes simples a los autos"). Ignores car rotation on purpose (a true
       oriented box is overkill for "don't walk through it"). */
    carColliders.forEach(c => {
      const dx = charX - c.x, dz = charZ - c.z;
      const dist = Math.sqrt(dx * dx + dz * dz);
      const minDist = c.r + 0.4;
      if (dist > 0.0001 && dist < minDist) {
        const push = minDist - dist;
        charX += (dx / dist) * push;
        charZ += (dz / dist) * push;
      }
    });

    /* ponytail: footstep dust removed — tried it, "no son tan utiles" (asked
       explicitly). A footstep sound was tried too and also asked to be
       removed. Jump takeoff/landing bursts stayed, those read well. */

    /* Crater gate — jumping sails straight over it (unchanged). Grounded is
       now split by gait, asked explicitly: walking (Shift held, slow) just
       bumps into the edge like a wall; running (the default) falls straight
       in and respawns at the avenue entrance. */
    if (!jumping) {
      CRATER_ZS.forEach(cz => {
        const near = cz + CRATER_HALF_W, far = cz - CRATER_HALF_W;
        if (charZ < near && charZ > far) {
          /* ponytail: DEATH_ENABLED off — diagnostic request, to test whether
             jumping the gap is blocked by something else entirely (the walking
             edge-block below is untouched). Flip back to true to restore. */
          if (sprinting && DEATH_ENABLED) {
            /* Green splash — asked explicitly ("particulas onda splash
               verdes cuando cae en el liquido verde") — before the reset
               moves charX/charZ away from the crater. */
            spawnFxBurst(THREE, charX, 0.15, charZ, 0x8cdc50, 14, {
              spread: 0.06, vy: 0.05, grav: -0.0026, size: 0.32, opacity: 0.85, life: 0.55,
            });
            beep(90, 0.3, 'sawtooth', 0.09);   /* splash — asked explicitly ("cuando toque el agua contaminada") */
            respawnAtEntrance();
          }
          else if (!sprinting) charZ = (charZ > cz) ? near : far;
        }
      });
    }

    /* Touching the obelisk navigates to contact (one-shot latch — without
       obeliskTouched this fired on every single frame spent inside the
       radius, not once). Navigates to the real contact page now that one
       exists (Phase 4) — a simple, deliberately non-functional form. */
    const obDx = charX - OBELISK_X, obDz = charZ - OBELISK_Z;
    const inObeliskRange = obDx * obDx + obDz * obDz < OBELISK_TOUCH_R2;
    if (inObeliskRange && !obeliskTouched) {
      obeliskTouched = true;
      window.location.href = contactUrl;
    } else if (!inObeliskRange) {
      obeliskTouched = false;
    }

    isMoving = nowMoving;

    /* Smooth heading — shortest-arc lerp instead of snap turns */
    if (charGroup) {
      const dr = Math.atan2(Math.sin(targetRotY - charGroup.rotation.y), Math.cos(targetRotY - charGroup.rotation.y));
      charGroup.rotation.y += dr * (reduced ? 1 : Math.min(1, 0.16 * dtScale));
    }

    /* Animation mixer — one active locomotion state (walk/run/idle-pose).
       ponytail: the GLB's "Idle" clip is a broken export — 0.000s duration,
       zero usable keyframes (confirmed by parsing the glb directly), so
       playing it does nothing and the skeleton just freezes wherever the
       last real clip left it. Real fix is re-exporting that clip; until then,
       "idle" is Walking paused at a fixed neutral time instead of the empty
       clip. locoState (not the action object) tracks which of the 3 states is
       current, since two states can point at the same walkAction object. */
    let bobY = 0;
    if (mixer) {
      mixer.update(delta);
      /* Jumping holds a STATIC running-stride pose (legs spread, no clip
         actually playing) for the whole arc — asked explicitly: not the
         animated walk cycle, a frozen mid-stride frame. Landing hands back
         to whatever state WASD/Shift currently calls for. */
      const state = jumping ? 'jump' : !nowMoving ? 'idle' : (sprinting && runAction) ? 'run' : 'walk';
      if (state !== locoState) {
        locoState = state;
        if (state === 'idle') {
          startIdlePose();
        } else if (state === 'jump') {
          /* Measured from the GLB: the time in Running (0.633s) where
             mixamorigLeftUpLeg/RightUpLeg are furthest apart — the widest
             running stride. Paused (timeScale 0), so it never advances. */
          const pose = runAction ?? walkAction;
          switchAction(pose, 0, pose === runAction ? JUMP_POSE_TIME : WALK_NEUTRAL_TIME);
        } else {
          const real = state === 'run' ? runAction : walkAction;
          switchAction(real, state === 'run' ? RUN_TIMESCALE : WALK_TIMESCALE);
        }
      }
    } else if (charGroup) {
      bobY = nowMoving
        ? Math.abs(Math.sin(t * 9)) * 0.04
        : Math.sin(t * 1.4) * 0.012;
    }
    prevMoving = nowMoving;

    /* Procedural jump — no Jump clip in this GLB (only Running/Walking/Idle),
       so the arc is a plain parabola on the wrapper group's Y, independent of
       the mixer/horizontal movement. Reduced motion still jumps (user input),
       just with a shorter arc. */
    let jumpY = 0;
    if (jumping) {
      /* El reloj del salto avanza en TIEMPO REAL, no por frame. Antes sumaba
         un paso fijo por tick mientras el desplazamiento horizontal ya venía
         normalizado por dtScale, así que el salto duraba 87 FRAMES en vez de
         1.4 segundos: a más Hz, menos distancia cubierta en el aire. En un
         monitor de 144Hz el alcance caía a 4.8u y con reduced-motion (que
         duplicaba el paso) a 2.4u — menos que los 3.6u del charco, o sea
         imposible de cruzar. La duración del salto es gameplay, no
         decoración: la lección 8 del CLAUDE.md dice que el guard de
         reduced-motion nunca va sobre la entrada del usuario, sólo sobre lo
         visual (acá, la altura del arco unas líneas más abajo). */
      jumpT += 0.016 * dtScale;
      const p = jumpT / JUMP_DUR;
      if (p >= 1) {
        jumping = false;
        /* Landing puff — asked explicitly ("particulas cuando... aterriza"). */
        spawnFxBurst(THREE, charX, 0.02, charZ, 0xff8c42, 10, {
          spread: 0.045, vy: 0.028, grav: -0.002, size: 0.26, opacity: 0.75, life: 0.4,
        });
      }
      /* El arco NO se achata bajo reduced-motion: es el feedback directo de
         una tecla que apretó el jugador, no una animación ambiente. Achatarlo
         al 0.4 hacía que en Windows —donde el guard viene prendido de fábrica—
         el salto se viera como un tropezón. */
      else jumpY = Math.sin(p * Math.PI) * JUMP_H;
    }

    if (charGroup) charGroup.position.set(charX, bobY + jumpY, charZ);

    /* G_40_3 — particle drift */
    if (particles) {
      const pos = particles.geometry.attributes.position;
      for (let i = 0; i < pos.count; i++) {
        let px = pos.getX(i) + particleVelocities[i*3];
        let py = pos.getY(i) + particleVelocities[i*3+1];
        let pz = pos.getZ(i) + particleVelocities[i*3+2];
        if (px >  12) px = -12; if (px < -12) px = 12;
        if (py >  14) py =   0; if (py <   0) py = 14;
        if (pz >   5) pz = -50; if (pz < -50) pz =  5;
        pos.setXYZ(i, px, py, pz);
      }
      pos.needsUpdate = true;
    }

    updateFx(dtScale);
    craterMaterials.forEach(m => { m.uniforms.uTime.value = t; });

    /* Big circle (8u) — VISUAL-ONLY: brightens the small circle's dim
       baseline (still not glowing) so it reads as "in range, come stand
       here". Does NOT touch the board's screen — that only turns on in the
       small circle below, synced with the spinner. */
    if (roleBillRefs.length && frameCount % 4 === 0) {
      roleBillRefs.forEach(ref => {
        const dx = ref.bx - charX, dz = ref.bz - charZ;
        ref.inBigCircle = dx * dx + dz * dz < PROXIMITY_R2;
      });
    }

    /* Small circle (SPINNER_R, ~1.3u) — the screen turning on and the
       spinner filling happen together, synced, both driven by physically
       standing inside this tight zone (asked explicitly — not the big 8u
       sensor above). Every frame (not throttled) so the sweep is smooth.
       Stepping out reverses both. Once fillT reaches 1 the (simplified)
       project panel opens — `opened` is a one-shot latch so it doesn't
       refire every frame you stay standing there. */
    if (roleBillRefs.length) {
      roleBillRefs.forEach(ref => {
        const dx = ref.bx - charX, dz = ref.bz - charZ;
        const inSmallCircle = dx * dx + dz * dz < SPINNER_R * SPINNER_R;

        if (inSmallCircle && !ref.lit) {
          ref.lit = true;
          flickerOn(ref.mesh.material);
          ref.edges.material.color.setHex(ref.borderColor);
        } else if (!inSmallCircle && ref.lit) {
          ref.lit = false;
          ref.mesh.material.color.setHex(0x30343d);   /* back to the pre-power-on dim tint */
          ref.edges.material.color.setHex(0x2a3040);
        }

        const dFill = (delta || 0.016) / SPINNER_FILL_TIME;
        ref.fillT = inSmallCircle ? Math.min(1, ref.fillT + dFill) : Math.max(0, ref.fillT - dFill);
        const litCount = Math.round(ref.fillT * SPINNER_TICKS);
        /* A short rising blip each time a new dot turns green — asked
           explicitly ("cada vez que una de las bolitas se pone verde"). Only
           on the way up (litCount growing), never while draining back down. */
        if (litCount > (ref.litCount || 0)) beep(220 + litCount * 6, 0.1, 'sine', 0.045);   /* softer/muted, asked explicitly — was a bright rising 'square' blip */
        ref.litCount = litCount;
        const filledColor = ref.isHero ? FLAG_BRIGHT : 0x5ee7aa;
        ref.spinnerTicks.forEach((tick, si) => {
          const filled = si < litCount;
          tick.material.color.setHex(filled ? filledColor : 0x2a3040);
          tick.material.opacity = filled ? 0.85 : (ref.inBigCircle ? 0.7 : 0.4);
        });
        if (ref.fillT >= 1 && !ref.opened) {
          ref.opened = true;
          showPanel(activeRole, ref.projIdx);
        } else if (!inSmallCircle && ref.opened) {
          /* Closes immediately on stepping out — asked explicitly — not
             waiting for fillT to finish decaying back down. */
          ref.opened = false;
          hidePanel();
        }
      });
    }

    /* Boards face the camera every frame (yaw only, stay upright) instead of
       a fixed angle. Once the character has walked past a board, hide it
       instead of leaving it re-orienting toward the camera indefinitely. */
    roleBillRefs.forEach(ref => {
      const passed = charZ < ref.bz - 1.5;
      ref.mesh.visible = !passed;
      ref.frame.visible = !passed;
      ref.edges.visible = !passed;
      if (passed) return;
      const angle = Math.atan2(camera.position.x - ref.bx, camera.position.z - ref.bz);
      ref.mesh.rotation.y = angle;
      ref.frame.rotation.y = angle;
      ref.edges.rotation.y = angle;
      ref.hit.rotation.y = angle;
    });

    /* Minimap redraw — every 3rd frame is plenty for a schematic */
    frameCount++;
    if (minimapCtx && frameCount % 3 === 0) drawMinimap();

    /* Camera follow — street perspective (low, behind character) */
    const lag = reduced ? 1 : 0.055;
    camTgtX += (charX - camTgtX) * lag;
    camTgtZ += (charZ - camTgtZ) * lag;
    if (introActive) {
      /* Cinematic intro: high wide shot of the avenue easing down to street level */
      introT = Math.min(1, introT + 0.0045);
      const e = 1 - Math.pow(1 - introT, 3);   /* easeOutCubic */
      const nx = camTgtX * 0.3, ny = 4.0, nz = camTgtZ + 9;
      camera.position.set(nx * e, 17 + (ny - 17) * e, 34 + (nz - 34) * e);
      camera.lookAt(camTgtX * 0.2 * e, 1.8 + 1.2 * (1 - e), camTgtZ - 6);
      if (introT > 0.72) document.getElementById('ps-hero').classList.remove('show');
      if (introT >= 1) introActive = false;
    } else {
      camera.position.set(camTgtX * 0.3, 4.0, camTgtZ + 9);
      /* Camera shake on death — decaying random jitter, skipped under
         reduced-motion (this is a reactive jolt from user-caused state, not
         ambient motion, but a violent shake is exactly the kind of thing
         reduced-motion users want suppressed). */
      if (shakeT > 0 && !reduced) {
        const mag = SHAKE_MAG * (shakeT / SHAKE_DUR);
        camera.position.x += (Math.random() - 0.5) * mag;
        camera.position.y += (Math.random() - 0.5) * mag;
        shakeT = Math.max(0, shakeT - (delta || 0.016));
      }
      camera.lookAt(camTgtX * 0.2, 1.8, camTgtZ - 6);
    }

    /* Zone lights pulse */
    scene.traverse(obj => {
      if (obj.isLight && obj.userData.zone) {
        const isActive = obj.userData.zone === activeZone;
        obj.intensity = isActive
          ? 5.0 + Math.sin(t * 2.5) * 0.8
          : 2.0 + Math.sin(t * 1.8 + obj.userData.zone.length) * 0.4;
      }
    });

    /* use bloom composer when available, fallback to plain render */
    if (composer) composer.render();
    else renderer.render(scene, camera);
  }

  function onResize() {
    const shell = document.getElementById('ps-shell');
    const rect = shell.getBoundingClientRect();
    const W = Math.max(rect.width, 400);
    const H = Math.max(rect.height, 400);
    sceneW = W; sceneH = H;
    camera.aspect = W / H;
    camera.updateProjectionMatrix();
    renderer.setSize(W, H, false);
    if (composer) composer.setSize(W, H);
  }

  setTimeout(init, 80);
})();
</script>

<style>
  .ps-shell {
    position: relative;
    width: 100%;
    /* flex:1 inside min-height parent collapses to 0 — use explicit calc instead */
    height: calc(100svh - 148px);
    min-height: 400px;
    overflow: hidden;
    background: var(--bg-void);
  }

  #ps-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* ── Cinematic intro hero ── */
  .ps-hero {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    z-index: 8;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s ease;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(13, 15, 20, 0.55));
  }

  .ps-hero.show { opacity: 1; }

  .ps-hero-name {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    letter-spacing: 0.16em;
    color: var(--sand);
    text-shadow: 0 0 30px rgba(94, 231, 170, 0.25);
  }

  .ps-hero-sub {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.5em;
    color: var(--accent-bright);
    min-height: 1.2em;
  }

  /* ── HUD ── */
  .ps-hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }


  /* ── Minimap HUD — display puro. El frame se dibuja in-canvas (corner
     cut). No es clickeable: el personaje se mueve sólo con WASD. ── */
  .ps-minimap {
    position: absolute;
    top: 2.4rem;
    left: 1rem;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

