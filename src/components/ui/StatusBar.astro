---
interface Props {
  lang?: 'en' | 'es';
  surface?: 'game' | 'doc';
}

const { lang = 'en', surface = 'doc' } = Astro.props;

const now = new Date();
const sysDate = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}.${String(now.getDate()).padStart(2, '0')}`;

---

<footer class="status-bar">
  {/* Los controles de juego sólo donde hay juego. */}
  {surface === 'game' ? (
    <div class="controls">
      <span class="control"><span class="key">◆</span>SELECT</span>
      <span class="control"><span class="key">↵</span>CONFIRM</span>
      <span class="control"><span class="key">ESC</span>BACK</span>
    </div>
  ) : <span />}

  <div class="bar-center">
    {/* El CV vive en la banda de identidad: acá estaba duplicado. */}
    <div class="lang-toggle">
      <a href="/en/" class:list={['lang-btn', { active: lang === 'en' }]} aria-label="English">EN</a>
      <span class="sys-text">|</span>
      <a href="/es/" class:list={['lang-btn', { active: lang === 'es' }]} aria-label="Español">ES</a>
    </div>
  </div>

  {/* LAT/LON/NODE es telemetría inventada: es atrezzo del juego, no
      información, y no tiene lugar en un documento. */}
  {surface === 'game'
    ? <span class="coord sys-text">LAT:-34.6037 LON:-58.3816 · {sysDate} · NODE:ACTIVE</span>
    : <span class="coord sys-text">{sysDate}</span>}
</footer>


<style>
  .status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.45rem 1rem;
    border-top: var(--border);
    background: color-mix(in srgb, var(--bg-void) 90%, black);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .controls {
    display: flex;
    gap: 1.2rem;
  }

  .control {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.15em;
    color: var(--sand-dim);
  }

  .key {
    border: var(--border);
    padding: 0.05rem 0.3rem;
    font-size: 0.58rem;
    color: var(--sand-dim);
  }

  .bar-center {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lang-btn {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.18em;
    color: var(--sand-dim);
    transition: color 0.15s;
  }

  .lang-btn:hover,
  .lang-btn.active {
    color: var(--accent);
  }

  /* Primary action button — follows the .cta-btn.cta-primary convention
     (mint border always · hover lift · active mint fill+press) */
  .lang-btn.cta-accent {
    color: var(--accent-bright);
    border: 1px solid var(--accent-bright);
    padding: 0.1rem 0.4rem;
    transform: translateY(0);
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }

  .lang-btn.cta-accent:hover {
    color: var(--accent-bright);
    transform: translateY(-1px);
  }

  .lang-btn.cta-accent:active {
    background: var(--accent-bright);
    color: var(--bg-void);
    transform: translateY(1px);
  }

  .sep-v {
    opacity: 0.3;
  }

  .coord {
    font-size: 0.57rem;
  }

  @media (max-width: 640px) {
    .coord { display: none; }
    .controls { gap: 0.8rem; }
  }

  @media (max-width: 480px) {
    .controls { display: none; }
  }
</style>
