---
interface Props {
  active?: string;
  lang?: 'en' | 'es';
}

const { active = 'terminal', lang = 'en' } = Astro.props;

/* Sólo rutas que existen. PROFILE/SKILLS/ABOUT/CONTACT estaban en 404 y
   PROFILE y ABOUT apuntaban a la MISMA url muerta; vuelven cuando las
   páginas existan (Fase 4), no como items deshabilitados.
   Los nombres de rol quedan en inglés en ambos locales: son títulos de
   puesto, y la regla de i18n del proyecto deja los técnicos en inglés. */
const tabs = [
  { id: 'terminal', label: 'TERMINAL',     href: `/${lang}/` },
  { id: 'risk',     label: 'DATA ANALYST', href: `/${lang}/risk/` },
  { id: 'ai',       label: 'AI ENGINEER',  href: `/${lang}/ai/` },
];
---

<nav class="tab-bar" aria-label="Main navigation">
  {tabs.map(tab => (
    <a
      href={tab.href}
      class:list={['tab', { active: tab.id === active }]}
      aria-current={tab.id === active ? 'page' : undefined}
      data-scramble
    >
      <span class="tab-icon">⬡</span>
      <span data-scramble-text>{tab.label}</span>
    </a>
  ))}
</nav>

<style>
  .tab-bar {
    display: flex;
    background: var(--bg-void);
    border-bottom: var(--border);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tab-bar::-webkit-scrollbar { display: none; }

  .tab {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    color: var(--sand-dim);
    border-right: var(--border);
    white-space: nowrap;
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .tab:last-child { border-right: none; }

  .tab:hover {
    color: var(--sand);
    background: var(--bg-panel);
  }

  .tab:hover .tab-icon {
    color: var(--accent-bright);
  }

  .tab.active {
    background: var(--bg-panel);
    color: var(--sand);
    border-bottom: 2px solid var(--accent);
  }

  .tab-icon {
    font-size: 0.75rem;
    color: var(--sand-dim);
    transition: color 0.18s ease;
  }

  .tab.active .tab-icon {
    color: var(--accent);
  }
</style>
